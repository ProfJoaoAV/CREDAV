                    <div class="w-full bg-black/50 h-3 rounded-full mt-1 overflow-hidden"><div id="duel-p1-hp" class="h-full bg-kpop-pink" style="width:100%"></div></div>
                    <div id="duel-p1-score" class="font-righteous text-lg text-kpop-pink mt-1">0</div>
                </div>
                <div class="bg-kpop-cyan/20 border-2 border-kpop-cyan rounded-xl p-3 text-center">
                    <div class="text-[10px] font-bold text-slate-300">JOGADOR 2 — HP</div>
                    <div class="w-full bg-black/50 h-3 rounded-full mt-1 overflow-hidden"><div id="duel-p2-hp" class="h-full bg-kpop-cyan" style="width:100%"></div></div>
                    <div id="duel-p2-score" class="font-righteous text-lg text-kpop-cyan mt-1">0</div>
                </div>
            </div>
            <div class="bg-black/50 rounded-2xl p-4 text-center"><div id="duel-question" class="font-righteous text-lg text-white">—</div></div>
            <div class="grid grid-cols-2 gap-3">
                <div class="space-y-2">
                    <div class="text-xs text-kpop-pink font-bold text-center">JOGADOR 1</div>
                    <div id="duel-p1-options" class="grid grid-cols-2 gap-2"></div>
                </div>
                <div class="space-y-2">
                    <div class="text-xs text-kpop-cyan font-bold text-center">JOGADOR 2</div>
