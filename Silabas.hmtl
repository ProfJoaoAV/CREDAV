                </div>
                <div class="bg-kpop-cyan/10 border-2 border-kpop-cyan rounded-2xl p-4 text-center">
                    <div class="text-3xl mb-2">🌟</div>
                    <div class="font-righteous text-lg text-kpop-cyan">Jogador 2</div>
                    <div class="text-xs text-slate-400 mt-1">Teclas: <kbd class="bg-black/60 px-1.5 py-0.5 rounded">←</kbd> <kbd class="bg-black/60 px-1.5 py-0.5 rounded">↑</kbd> <kbd class="bg-black/60 px-1.5 py-0.5 rounded">↓</kbd> <kbd class="bg-black/60 px-1.5 py-0.5 rounded">→</kbd></div>
                </div>
            </div>
            <button onclick="beginDuel()" class="w-full mt-4 bg-gradient-to-r from-purple-500 to-pink-500 text-white font-righteous py-3 rounded-2xl"><i class="fa-solid fa-play mr-2"></i> Começar Duelo</button>
