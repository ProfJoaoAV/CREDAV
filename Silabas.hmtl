<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#FF007F">
<title>K-Sílaba: Ultimate Edition — 5.º Ano</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;600;700;800;900&family=Righteous&family=Outfit:wght@400;600;800;900&display=swap" rel="stylesheet">
<script>
tailwind.config = {
    theme: { extend: {
        colors: { kpop: {
            pink: '#FF007F', neonPink: '#FF2A85', purple: '#7928CA',
            deepPurple: '#120E24', cyan: '#00F2FE', yellow: '#FFE600',
            mint: '#00FFAB', cardBg: '#1C1635'
        }},
        fontFamily: {
            righteous: ['Righteous', 'cursive'], fredoka: ['Fredoka', 'sans-serif'],
            nunito: ['Nunito', 'sans-serif'], outfit: ['Outfit', 'sans-serif'],
        }
    }}
}
</script>
<style>
* { -webkit-tap-highlight-color: transparent; }
html { scroll-behavior: smooth; }
body {
    font-family: 'Nunito', sans-serif;
    background: #0D0A1A;
    color: #F1F5F9;
    overflow-x: hidden;
    transition: font-size 0.3s;
}
body.text-large { font-size: 18px; }
body.text-xl { font-size: 20px; }
body.high-contrast { background: #000 !important; filter: contrast(1.3); }
body.reduce-motion * { animation-duration: 0.01s !important; transition-duration: 0.01s !important; }

.kglass {
    background: rgba(28, 22, 53, 0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.12);
}
.kglass-glow { box-shadow: 0 8px 32px 0 rgba(255, 0, 127, 0.25); }

::-webkit-scrollbar { width: 8px; }
::-webkit-scrollbar-track { background: #0D0A1A; }
::-webkit-scrollbar-thumb { background: linear-gradient(180deg, #FF007F, #7928CA); border-radius: 4px; }

@keyframes lightstickPulse {
    0%, 100% { transform: scale(1) rotate(0deg); filter: drop-shadow(0 0 8px #FF007F); }
    50% { transform: scale(1.1) rotate(5deg); filter: drop-shadow(0 0 20px #00F2FE); }
}
.animate-lightstick { animation: lightstickPulse 2.5s infinite ease-in-out; }

@keyframes floatY { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }
.animate-float { animation: floatY 3s infinite ease-in-out; }

@keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }
.shimmer-text {
    background: linear-gradient(90deg, #FF007F, #FFE600, #00F2FE, #FF007F);
    background-size: 200% auto;
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shimmer 3s linear infinite;
}

@keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
.animate-fade-up { animation: fadeInUp 0.5s ease-out; }

@keyframes popIn {
    0% { transform: scale(0.7); opacity: 0; }
    70% { transform: scale(1.05); }
    100% { transform: scale(1); opacity: 1; }
}
.animate-pop { animation: popIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }

@keyframes shakeError {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-8px); }
    75% { transform: translateX(8px); }
}
.animate-shake { animation: shakeError 0.4s ease-in-out; }

@keyframes correctPulse {
    0% { box-shadow: 0 0 0 0 rgba(0, 255, 171, 0.7); }
    100% { box-shadow: 0 0 0 25px rgba(0, 255, 171, 0); }
}
.animate-correct { animation: correctPulse 0.6s ease-out; }

@keyframes lockShake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-5px) rotate(-3deg); }
    75% { transform: translateX(5px) rotate(3deg); }
}
.animate-lock { animation: lockShake 2s infinite ease-in-out; display: inline-block; }

@keyframes toastIn {
    0% { transform: translateX(120%); opacity: 0; }
    100% { transform: translateX(0); opacity: 1; }
}
.toast-in { animation: toastIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }

@keyframes heartbeat { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.2); } }
.animate-heartbeat { animation: heartbeat 1s infinite ease-in-out; }

@keyframes worldIntro {
    0% { opacity: 0; transform: scale(0.5) rotate(-10deg); letter-spacing: 30px; }
    40% { opacity: 1; transform: scale(1.05) rotate(0deg); letter-spacing: 5px; }
    60% { opacity: 1; transform: scale(1) rotate(0deg); letter-spacing: 3px; }
    100% { opacity: 0; transform: scale(1.2) rotate(0deg); letter-spacing: 20px; }
}
.world-intro-anim { animation: worldIntro 2.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }

.tab-btn { position: relative; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
.tab-btn.active {
    background: linear-gradient(135deg, #FF007F, #7928CA);
    color: #FFFFFF;
    box-shadow: 0 0 20px rgba(255, 0, 127, 0.6);
}

#gameCanvas {
    touch-action: none;
    border-radius: 1.5rem;
    box-shadow: 0 0 35px rgba(255, 0, 127, 0.4), 0 0 15px rgba(0, 242, 254, 0.3);
}

.glass-btn { position: relative; overflow: hidden; transition: all 0.3s ease; }
.syllable-pill { transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1); }
.powerup-badge { animation: lightstickPulse 1.5s infinite; }

.concert-card { transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); cursor: pointer; }
.concert-card:hover:not(.locked) { transform: translateY(-8px) scale(1.02); }
.concert-card.locked { opacity: 0.55; filter: grayscale(0.7); cursor: not-allowed; }

.achievement-toast {
    position: fixed; right: 16px; bottom: 16px; z-index: 9999;
    max-width: 340px; border-radius: 16px; padding: 12px 16px;
    display: flex; gap: 12px; align-items: center;
    backdrop-filter: blur(16px);
    box-shadow: 0 8px 32px rgba(255, 0, 127, 0.4);
    background: rgba(28, 22, 53, 0.95);
    border: 2px solid #FFE600;
}

.avatar-option { cursor: pointer; transition: all 0.3s; border: 2px solid rgba(255,255,255,0.1); }
.avatar-option:hover:not(.locked) { transform: scale(1.08); border-color: #FF007F; }
.avatar-option.selected { border-color: #FFE600; box-shadow: 0 0 20px rgba(255,230,0,0.6); }
.avatar-option.locked { opacity: 0.4; filter: grayscale(1); cursor: not-allowed; }

.starfield {
    position: fixed; inset: 0; pointer-events: none; z-index: 0;
    background-image:
        radial-gradient(1px 1px at 20% 30%, rgba(255,255,255,0.6), transparent),
        radial-gradient(1px 1px at 60% 70%, rgba(0,242,254,0.6), transparent),
        radial-gradient(1px 1px at 80% 20%, rgba(255,0,127,0.6), transparent),
        radial-gradient(1px 1px at 40% 90%, rgba(255,230,0,0.5), transparent);
    background-size: 200% 200%;
    animation: bgShift 60s linear infinite;
}
@keyframes bgShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}
.animated-bg {
    background: linear-gradient(-45deg, #0D0A1A, #1a0d2e, #0d1a2e, #1a0d1a);
    background-size: 400% 400%;
    animation: bgShift 20s ease infinite;
}
main, header { position: relative; z-index: 1; }

.modal-overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,0.9);
    backdrop-filter: blur(12px); z-index: 100;
    display: flex; align-items: center; justify-content: center; padding: 16px;
}

.karaoke-bar { height: 8px; border-radius: 4px; background: #1a1030; overflow: hidden; position: relative; }
.karaoke-bar-fill { height: 100%; background: linear-gradient(90deg, #00FFAB, #FFE600); transition: width 0.1s linear; border-radius: 4px; }
</style>
</head>
<body class="min-h-screen flex flex-col animated-bg selection:bg-kpop-pink selection:text-white">
<div class="starfield"></div>

<header class="sticky top-0 z-50 kglass border-b border-white/10 backdrop-blur-xl">
    <div class="max-w-7xl mx-auto px-4 py-3 flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-kpop-pink via-kpop-purple to-kpop-cyan p-0.5 animate-lightstick shadow-lg">
                <div class="w-full h-full bg-kpop-deepPurple rounded-[14px] flex items-center justify-center text-kpop-pink text-xl font-black">🎤</div>
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <span class="bg-kpop-pink text-white text-[10px] font-black uppercase tracking-widest px-2 py-0.5 rounded-full animate-pulse">Ultimate</span>
                    <span class="text-xs text-kpop-cyan font-bold tracking-wider">5.º ANO</span>
                </div>
                <h1 class="font-righteous text-lg md:text-2xl text-transparent bg-clip-text bg-gradient-to-r from-kpop-pink via-white to-kpop-cyan tracking-wide">K-SÍLABA: ULTIMATE</h1>
            </div>
        </div>
        <nav class="flex bg-black/40 p-1.5 rounded-2xl border border-white/10 gap-1 flex-wrap justify-center">
            <button onclick="switchTab('learn')" id="tab-learn" class="tab-btn active px-3 py-2.5 rounded-xl font-outfit font-extrabold text-xs flex items-center gap-1.5"><i class="fa-solid fa-compact-disc text-kpop-cyan"></i><span class="hidden sm:inline">Studio</span></button>
            <button onclick="switchTab('quiz')" id="tab-quiz" class="tab-btn text-slate-300 hover:text-white px-3 py-2.5 rounded-xl font-outfit font-extrabold text-xs flex items-center gap-1.5"><i class="fa-solid fa-microphones text-kpop-yellow"></i><span class="hidden sm:inline">Audition</span></button>
            <button onclick="switchTab('karaoke')" id="tab-karaoke" class="tab-btn text-slate-300 hover:text-white px-3 py-2.5 rounded-xl font-outfit font-extrabold text-xs flex items-center gap-1.5"><i class="fa-solid fa-microphone-lines text-kpop-mint"></i><span class="hidden sm:inline">Karaoke</span></button>
            <button onclick="switchTab('game')" id="tab-game" class="tab-btn text-slate-300 hover:text-white px-3 py-2.5 rounded-xl font-outfit font-extrabold text-xs flex items-center gap-1.5"><i class="fa-solid fa-wand-sparkles text-kpop-pink"></i><span class="hidden sm:inline">World Tour</span></button>
            <button onclick="switchTab('avatar')" id="tab-avatar" class="tab-btn text-slate-300 hover:text-white px-3 py-2.5 rounded-xl font-outfit font-extrabold text-xs flex items-center gap-1.5"><i class="fa-solid fa-user-astronaut text-purple-300"></i><span class="hidden sm:inline">Avatar</span></button>
            <button onclick="switchTab('achievements')" id="tab-achievements" class="tab-btn text-slate-300 hover:text-white px-3 py-2.5 rounded-xl font-outfit font-extrabold text-xs flex items-center gap-1.5"><i class="fa-solid fa-trophy text-kpop-yellow"></i><span class="hidden sm:inline">🏆</span></button>
            <button onclick="switchTab('daily')" id="tab-daily" class="tab-btn text-slate-300 hover:text-white px-3 py-2.5 rounded-xl font-outfit font-extrabold text-xs flex items-center gap-1.5"><i class="fa-solid fa-calendar-day text-kpop-cyan"></i><span class="hidden sm:inline">Dia</span></button>
            <button onclick="openSettings()" class="text-slate-300 hover:text-white px-3 py-2.5 rounded-xl font-outfit font-extrabold text-xs flex items-center gap-1.5"><i class="fa-solid fa-gear"></i></button>
        </nav>
    </div>
</header>

<main class="flex-1 max-w-7xl w-full mx-auto p-4 md:p-6 space-y-6">

<!-- STUDIO -->
<section id="section-learn" class="space-y-8 animate-fade-up">
    <div class="relative overflow-hidden rounded-3xl p-6 md:p-10 kglass kglass-glow border border-kpop-pink/30 flex flex-col lg:flex-row items-center justify-between gap-8">
        <div class="absolute -top-24 -left-24 w-72 h-72 bg-kpop-pink/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 w-72 h-72 bg-kpop-cyan/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="space-y-3 max-w-2xl relative z-10">
            <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 px-3.5 py-1 rounded-full backdrop-blur">
                <span class="text-kpop-yellow text-xs font-black">🌟 WORLD TOUR GRAMMAR</span>
            </div>
            <h2 class="font-righteous text-3xl md:text-5xl text-white leading-tight">Domina as Sílabas no <span class="shimmer-text">Ritmo do K-Pop!</span></h2>
            <p class="text-slate-300 text-base md:text-lg">Cada palavra tem o seu ritmo! Descobre a divisão silábica e bate palmas ao ritmo dos idols!</p>
        </div>
        <div class="relative z-10 flex flex-col items-center justify-center p-6 bg-white/5 rounded-3xl border border-white/10 text-center min-w-[240px] shadow-2xl animate-float">
            <div class="text-6xl mb-2 animate-lightstick">🪄</div>
            <div class="font-righteous text-xl text-kpop-cyan">SÍLABA LIGHTSTICK</div>
            <p class="text-xs text-slate-400 mt-1">A sílaba tónica é a luz mais forte!</p>
        </div>
    </div>

    <div class="kglass rounded-3xl p-6 md:p-8 border border-kpop-purple/40 space-y-6">
        <div class="flex items-center gap-3 border-b border-white/10 pb-4">
            <div class="w-12 h-12 bg-gradient-to-br from-kpop-pink to-kpop-purple rounded-2xl flex items-center justify-center text-2xl shadow-lg">🎧</div>
            <div>
                <h3 class="font-righteous text-2xl text-white">Laboratório de Ritmo Silábico</h3>
                <p class="text-xs text-slate-400">Escreve uma palavra para ver a divisão silábica e a tónica!</p>
            </div>
        </div>
        <div class="flex flex-col md:flex-row gap-3">
            <input type="text" id="kpopWordInput" placeholder="Ex: superstar, música, lâmpada..."
                class="flex-1 bg-black/50 border-2 border-kpop-purple/60 focus:border-kpop-pink rounded-2xl px-5 py-3.5 text-lg font-bold text-white placeholder-slate-500 outline-none transition-all">
            <button onclick="analyzeKpopWord()" class="glass-btn bg-gradient-to-r from-kpop-pink via-kpop-purple to-kpop-cyan text-white font-righteous text-lg px-8 py-3.5 rounded-2xl shadow-xl flex items-center justify-center gap-3">
                <i class="fa-solid fa-play"></i><span>Tocar Batida</span>
            </button>
        </div>
        <div class="flex flex-wrap gap-2">
            <span class="text-xs text-slate-500 font-bold self-center">Sugestões:</span>
            <button onclick="quickFill('superstar')" class="text-xs bg-black/40 hover:bg-kpop-pink/20 border border-white/10 text-slate-300 px-2.5 py-1 rounded-lg transition">superstar</button>
            <button onclick="quickFill('música')" class="text-xs bg-black/40 hover:bg-kpop-pink/20 border border-white/10 text-slate-300 px-2.5 py-1 rounded-lg transition">música</button>
            <button onclick="quickFill('lâmpada')" class="text-xs bg-black/40 hover:bg-kpop-pink/20 border border-white/10 text-slate-300 px-2.5 py-1 rounded-lg transition">lâmpada</button>
            <button onclick="quickFill('espetáculo')" class="text-xs bg-black/40 hover:bg-kpop-pink/20 border border-white/10 text-slate-300 px-2.5 py-1 rounded-lg transition">espetáculo</button>
        </div>
        <div id="kpopResultBox" class="hidden bg-black/40 rounded-2xl p-6 border border-white/10 space-y-6">
            <div class="flex flex-wrap items-center justify-between gap-4">
                <div>
                    <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Divisão Silábica:</span>
                    <div id="kpopSyllablesContainer" class="flex flex-wrap gap-3 mt-2"></div>
                </div>
                <div class="flex gap-2 flex-wrap">
                    <span id="kpopBadgeNum" class="bg-kpop-purple/40 border border-kpop-purple text-kpop-pink px-4 py-2 rounded-xl font-bold text-sm"></span>
                    <span id="kpopBadgeTonic" class="bg-kpop-cyan/20 border border-kpop-cyan text-kpop-cyan px-4 py-2 rounded-xl font-bold text-sm"></span>
                </div>
            </div>
            <div class="space-y-2">
                <div class="flex justify-between items-center text-xs font-bold text-slate-400">
                    <span>Equalizer Spectrum</span>
                    <span id="eq-bpm-text">BPM: 128</span>
                </div>
                <div id="eqBarContainer" class="flex items-end gap-2 h-20 bg-black/60 p-3 rounded-xl border border-white/5"></div>
            </div>
        </div>
    </div>

    <div class="space-y-4">
        <h3 class="font-righteous text-2xl text-white flex items-center gap-2">💿 Concept Album: Quantidade de Sílabas</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
            <div class="kglass hover:border-kpop-pink/80 rounded-3xl p-5 border border-white/10 hover:scale-[1.02] transition">
                <span class="bg-kpop-pink/20 border border-kpop-pink text-kpop-pink text-[10px] font-black px-2.5 py-1 rounded-full">1 SÍLABA</span>
                <h4 class="font-righteous text-2xl text-white mt-3">Monossílabo</h4>
                <p class="text-xs text-slate-300 mt-2">Um só impulso de voz.</p>
                <div class="mt-3 flex flex-wrap gap-1.5">
                    <span class="bg-black/60 text-kpop-yellow font-mono text-xs px-2 py-1 rounded-lg">sol</span>
                    <span class="bg-black/60 text-kpop-yellow font-mono text-xs px-2 py-1 rounded-lg">flor</span>
                    <span class="bg-black/60 text-kpop-yellow font-mono text-xs px-2 py-1 rounded-lg">pão</span>
                </div>
            </div>
            <div class="kglass hover:border-kpop-purple/80 rounded-3xl p-5 border border-white/10 hover:scale-[1.02] transition">
                <span class="bg-kpop-purple/30 border border-kpop-purple text-purple-300 text-[10px] font-black px-2.5 py-1 rounded-full">2 SÍLABAS</span>
                <h4 class="font-righteous text-2xl text-white mt-3">Dissílabo</h4>
                <p class="text-xs text-slate-300 mt-2">O duo perfeito!</p>
                <div class="mt-3 flex flex-wrap gap-1.5">
                    <span class="bg-black/60 text-purple-300 font-mono text-xs px-2 py-1 rounded-lg">ca-sa</span>
                    <span class="bg-black/60 text-purple-300 font-mono text-xs px-2 py-1 rounded-lg">dan-ça</span>
                </div>
            </div>
            <div class="kglass hover:border-kpop-cyan/80 rounded-3xl p-5 border border-white/10 hover:scale-[1.02] transition">
                <span class="bg-kpop-cyan/20 border border-kpop-cyan text-kpop-cyan text-[10px] font-black px-2.5 py-1 rounded-full">3 SÍLABAS</span>
                <h4 class="font-righteous text-2xl text-white mt-3">Trissílabo</h4>
                <p class="text-xs text-slate-300 mt-2">Harmonia em trio!</p>
                <div class="mt-3 flex flex-wrap gap-1.5">
                    <span class="bg-black/60 text-kpop-cyan font-mono text-xs px-2 py-1 rounded-lg">flo-res-ta</span>
                    <span class="bg-black/60 text-kpop-cyan font-mono text-xs px-2 py-1 rounded-lg">mú-si-ca</span>
                </div>
            </div>
            <div class="kglass hover:border-kpop-yellow/80 rounded-3xl p-5 border border-white/10 hover:scale-[1.02] transition">
                <span class="bg-kpop-yellow/20 border border-kpop-yellow text-kpop-yellow text-[10px] font-black px-2.5 py-1 rounded-full">4+ SÍLABAS</span>
                <h4 class="font-righteous text-2xl text-white mt-3">Polissílabo</h4>
                <p class="text-xs text-slate-300 mt-2">Grupo idol completo!</p>
                <div class="mt-3 flex flex-wrap gap-1.5">
                    <span class="bg-black/60 text-kpop-yellow font-mono text-xs px-2 py-1 rounded-lg">com-pu-ta-dor</span>
                </div>
            </div>
        </div>
    </div>

    <div class="kglass rounded-3xl p-6 md:p-8 border border-white/10 space-y-6">
        <h3 class="font-righteous text-2xl text-white">🌟 A Sílaba Tónica no Holofote</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-gradient-to-b from-amber-500/10 to-amber-950/20 border border-amber-500/40 rounded-3xl p-6 space-y-3">
                <div class="flex justify-between"><span class="font-righteous text-amber-400 text-xl">Esdrúxula</span><span class="text-xs bg-amber-500/20 text-amber-300 px-2.5 py-1 rounded-full font-bold">ANTEPENÚLTIMA</span></div>
                <p class="text-xs text-slate-300">Tónica na 3.ª do fim.</p>
                <div class="bg-black/50 p-3 rounded-2xl text-xs text-amber-200 font-mono"><span class="text-amber-400 underline">lâm</span>-pa-da</div>
                <div class="bg-amber-400/10 border border-amber-400/30 p-2 rounded-xl text-[11px] text-amber-300 font-extrabold">✨ SEMPRE com acento!</div>
            </div>
            <div class="bg-gradient-to-b from-kpop-pink/10 to-purple-950/20 border border-kpop-pink/40 rounded-3xl p-6 space-y-3">
                <div class="flex justify-between"><span class="font-righteous text-kpop-pink text-xl">Grave</span><span class="text-xs bg-kpop-pink/20 text-kpop-pink px-2.5 py-1 rounded-full font-bold">PENÚLTIMA</span></div>
                <p class="text-xs text-slate-300">Tónica na 2.ª do fim (a mais comum).</p>
                <div class="bg-black/50 p-3 rounded-2xl text-xs text-pink-200 font-mono"><span class="text-kpop-pink underline">gar</span>-fo</div>
            </div>
            <div class="bg-gradient-to-b from-kpop-cyan/10 to-blue-950/20 border border-kpop-cyan/40 rounded-3xl p-6 space-y-3">
                <div class="flex justify-between"><span class="font-righteous text-kpop-cyan text-xl">Aguda</span><span class="text-xs bg-kpop-cyan/20 text-kpop-cyan px-2.5 py-1 rounded-full font-bold">ÚLTIMA</span></div>
                <p class="text-xs text-slate-300">Tónica na 1.ª do fim.</p>
                <div class="bg-black/50 p-3 rounded-2xl text-xs text-cyan-200 font-mono">an-<span class="text-kpop-cyan underline">dar</span></div>
            </div>
        </div>
    </div>
</section>

<!-- QUIZ -->
<section id="section-quiz" class="hidden space-y-6">
    <div class="max-w-3xl mx-auto space-y-6">
        <div class="kglass rounded-3xl p-6 border border-kpop-pink/30 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-kpop-pink to-kpop-yellow flex items-center justify-center text-2xl font-black text-black">🏆</div>
                <div>
                    <span class="text-xs text-kpop-cyan font-bold tracking-widest uppercase">K-Pop World Debut</span>
                    <h3 id="idol-rank-title" class="font-righteous text-xl text-white">Idol Rank: Trainee 🌟</h3>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <div class="text-center"><span class="text-[10px] text-slate-400 block font-bold">COMBO</span><span id="quiz-combo-text" class="font-righteous text-2xl text-kpop-yellow">0x</span></div>
                <div class="text-center border-l border-white/10 pl-4"><span class="text-[10px] text-slate-400 block font-bold">SCORE</span><span id="quiz-score-num" class="font-righteous text-2xl text-kpop-pink">0</span></div>
            </div>
        </div>
        <div class="kglass rounded-3xl p-6 md:p-8 border border-white/10 space-y-6">
            <div class="flex items-center justify-between text-xs font-bold text-slate-400">
                <span id="quiz-question-badge" class="bg-white/10 text-white px-3 py-1 rounded-full">Pergunta 1 / 30</span>
                <button onclick="restartAuditionQuiz()" class="text-kpop-pink hover:text-white transition flex items-center gap-1 font-bold"><i class="fa-solid fa-rotate-right"></i> Reiniciar</button>
            </div>
            <div class="w-full bg-black/60 h-3 rounded-full overflow-hidden border border-white/5">
                <div id="quiz-progress-bar" class="h-full bg-gradient-to-r from-kpop-pink via-kpop-purple to-kpop-cyan transition-all duration-300 w-[3.33%]"></div>
            </div>
            <div id="quiz-active-box" class="space-y-6">
                <h3 id="quiz-question-heading" class="font-righteous text-xl md:text-2xl text-white leading-snug">A carregar...</h3>
                <div id="quiz-options-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
                <div id="quiz-feedback-box" class="hidden p-4 rounded-2xl text-sm font-medium border"></div>
                <div class="flex justify-end pt-2">
                    <button id="quiz-next-btn" onclick="nextQuizStep()" class="hidden bg-gradient-to-r from-kpop-pink to-kpop-purple text-white font-righteous px-8 py-3 rounded-2xl flex items-center gap-2">
                        <span>Próxima</span><i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>
            </div>
            <div id="quiz-summary-screen" class="hidden text-center py-8 space-y-4">
                <div class="text-7xl animate-bounce">👑</div>
                <h3 class="font-righteous text-3xl text-white">DEBUT CONCLUÍDO!</h3>
                <p class="text-slate-300 text-lg">Acertaste <strong id="final-correct-score" class="text-kpop-yellow text-2xl">0</strong> de 30!</p>
                <button onclick="restartAuditionQuiz()" class="bg-gradient-to-r from-kpop-pink via-kpop-purple to-kpop-cyan text-white font-righteous text-lg px-8 py-3.5 rounded-2xl shadow-xl hover:scale-105 transition">Nova Audição 🔄</button>
            </div>
        </div>
    </div>
</section>

<!-- KARAOKE -->
<section id="section-karaoke" class="hidden space-y-6">
    <div class="max-w-3xl mx-auto space-y-6">
        <div class="kglass rounded-3xl p-6 border-2 border-kpop-mint/50 space-y-4">
            <div class="flex items-center gap-3">
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-kpop-mint to-kpop-cyan flex items-center justify-center text-3xl">🎤</div>
                <div>
                    <h3 class="font-righteous text-2xl text-white">Modo Karaoke Silábico</h3>
                    <p class="text-xs text-slate-400">Diz a palavra em voz alta e enfatiza a sílaba tónica!</p>
                </div>
            </div>
            <div id="karaoke-permission" class="bg-yellow-500/10 border border-yellow-500/40 rounded-2xl p-4 space-y-3">
                <p class="text-sm text-yellow-200"><i class="fa-solid fa-info-circle mr-2"></i>Para usar o karaoke, precisas de permitir acesso ao microfone.</p>
                <button onclick="requestMicAccess()" class="glass-btn bg-gradient-to-r from-kpop-mint to-kpop-cyan text-black font-righteous px-6 py-3 rounded-xl"><i class="fa-solid fa-microphone mr-2"></i>Ativar Microfone</button>
            </div>
            <div id="karaoke-active" class="hidden space-y-5">
                <div class="text-center">
                    <div class="text-xs text-slate-400 font-bold uppercase tracking-widest">Palavra Atual</div>
                    <div id="karaoke-word" class="font-righteous text-4xl text-white mt-2">—</div>
                    <div id="karaoke-syllables" class="flex justify-center gap-2 mt-3"></div>
                </div>
                <div class="space-y-3">
                    <div class="flex items-center justify-between text-xs font-bold text-slate-400">
                        <span>🎙️ Nível de Voz</span>
                        <span id="karaoke-status" class="text-kpop-mint">À espera...</span>
                    </div>
                    <div class="karaoke-bar"><div id="karaoke-level" class="karaoke-bar-fill" style="width:0%"></div></div>
                </div>
                <div id="karaoke-feedback" class="hidden p-4 rounded-2xl text-center font-bold"></div>
                <div class="flex gap-3">
                    <button onclick="nextKaraokeWord()" class="flex-1 bg-gradient-to-r from-kpop-pink to-kpop-purple text-white font-righteous px-6 py-3 rounded-2xl"><i class="fa-solid fa-forward mr-2"></i>Próxima Palavra</button>
                    <button onclick="stopKaraoke()" class="bg-black/50 border border-white/20 text-slate-300 px-6 py-3 rounded-2xl"><i class="fa-solid fa-stop"></i></button>
                </div>
                <div class="flex justify-between text-xs font-bold">
                    <span class="text-slate-400">Acertos: <span id="karaoke-score" class="text-kpop-mint text-base">0</span></span>
                    <span class="text-slate-400">Tentativas: <span id="karaoke-tries" class="text-kpop-cyan text-base">0</span></span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- WORLD TOUR -->
<section id="section-game" class="hidden space-y-4">
    <div class="kglass rounded-3xl p-4 md:p-6 border border-white/10 space-y-4">
        <div id="concert-selector" class="space-y-3">
            <div class="flex items-center justify-between flex-wrap gap-2">
                <div>
                    <h3 class="font-righteous text-2xl text-white">🎫 Escolhe o teu Concerto</h3>
                    <p class="text-xs text-slate-400">Derrota bosses para desbloquear novos palcos!</p>
                </div>
                <div class="flex items-center gap-3 text-xs">
                    <div class="bg-black/40 px-3 py-1.5 rounded-xl border border-white/10">
                        <span class="text-slate-400">⭐ Estrelas:</span>
                        <span id="global-stars" class="font-righteous text-kpop-yellow text-base ml-1">0</span>
                    </div>
                    <div class="bg-black/40 px-3 py-1.5 rounded-xl border border-white/10">
                        <span class="text-slate-400">🏆 Recorde:</span>
                        <span id="global-highscore" class="font-righteous text-kpop-cyan text-base ml-1">0</span>
                    </div>
                </div>
            </div>
            <div id="concerts-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3"></div>
            <div class="flex justify-center pt-2 gap-2 flex-wrap">
                <button id="hardcore-toggle-btn" onclick="toggleHardcore()" class="glass-btn bg-black/60 hover:bg-red-900/30 border-2 border-red-500/50 text-red-300 font-righteous text-sm px-5 py-2.5 rounded-2xl flex items-center gap-2">
                    <i class="fa-solid fa-skull"></i><span id="hardcore-label">Hardcore: OFF</span>
                </button>
                <button onclick="startDuel()" class="glass-btn bg-black/60 hover:bg-purple-900/30 border-2 border-purple-500/50 text-purple-300 font-righteous text-sm px-5 py-2.5 rounded-2xl flex items-center gap-2">
                    <i class="fa-solid fa-users"></i><span>Duelo 2 Jogadores</span>
                </button>
            </div>
        </div>

        <div id="game-dashboard" class="hidden space-y-4">
            <div id="concert-header" class="rounded-2xl p-3 border-2 flex items-center justify-between flex-wrap gap-3" style="border-color:#FF007F; background:linear-gradient(90deg,rgba(255,0,127,0.15),rgba(0,242,254,0.1));">
                <div class="flex items-center gap-3">
                    <span id="concert-emoji" class="text-3xl">🎤</span>
                    <div>
                        <div id="concert-world-name" class="font-righteous text-lg text-white">Seoul Debut</div>
                        <div id="concert-world-subtitle" class="text-[10px] text-slate-300 font-bold uppercase tracking-wider">STAGE 1 / 5</div>
                    </div>
                </div>
                <button onclick="backToConcerts()" class="text-xs bg-black/40 hover:bg-black/60 px-3 py-1.5 rounded-lg border border-white/10 text-slate-300 font-bold"><i class="fa-solid fa-arrow-left mr-1"></i> Trocar</button>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-3 bg-black/40 p-4 rounded-2xl border border-white/10">
                <div class="flex items-center gap-4 flex-wrap">
                    <div class="text-slate-200 font-righteous flex items-center gap-2">
                        <span class="text-2xl animate-pulse">🌟</span>
                        <span>Score:</span>
                        <span id="game-score-display" class="font-righteous text-3xl text-kpop-yellow">0</span>
                    </div>
                    <div id="lives-display" class="text-center bg-red-500/20 border border-red-400 px-3 py-1 rounded-xl">
                        <span class="text-[10px] text-slate-300 font-bold block">VIDAS</span>
                        <span id="lives-hearts" class="text-base animate-heartbeat inline-block">💖💖💖</span>
                    </div>
                    <div id="combo-display" class="hidden text-center bg-kpop-pink/20 border border-kpop-pink px-3 py-1 rounded-xl">
                        <span class="text-[10px] text-slate-300 font-bold block">COMBO</span>
                        <span id="game-combo-num" class="font-righteous text-lg text-kpop-yellow">x0</span>
                    </div>
                </div>
                <div class="flex items-center gap-3 flex-1 max-w-xs">
                    <span class="text-slate-300 font-bold text-xs whitespace-nowrap"><i class="fa-solid fa-bolt text-kpop-yellow animate-pulse"></i> Energia:</span>
                    <div class="w-full bg-black/80 h-6 rounded-full overflow-hidden p-1 border border-white/20 relative">
                        <div id="game-energy-fill" class="bg-gradient-to-r from-kpop-pink via-kpop-purple to-kpop-cyan h-full rounded-full transition-all w-full"></div>
                        <span id="game-energy-num" class="absolute inset-0 flex items-center justify-center text-[11px] font-black text-white">100%</span>
                    </div>
                </div>
                <button onclick="openKpopQuestionModal()" class="glass-btn bg-gradient-to-r from-kpop-pink to-kpop-purple text-white font-righteous text-xs px-5 py-2.5 rounded-xl flex items-center gap-2">
                    <i class="fa-solid fa-lightbulb text-kpop-yellow"></i><span>Recarregar (R)</span>
                </button>
            </div>

            <div class="flex flex-wrap gap-2 text-[10px]">
                <div id="pwr-shield" class="hidden powerup-badge bg-cyan-500/20 border border-cyan-400 text-cyan-300 px-2 py-1 rounded-lg font-bold">🛡️ <span class="pwr-timer">0s</span></div>
                <div id="pwr-magnet" class="hidden powerup-badge bg-pink-500/20 border border-pink-400 text-pink-300 px-2 py-1 rounded-lg font-bold">🧲 <span class="pwr-timer">0s</span></div>
                <div id="pwr-double" class="hidden powerup-badge bg-emerald-500/20 border border-emerald-400 text-emerald-300 px-2 py-1 rounded-lg font-bold">🦘 <span class="pwr-timer">0s</span></div>
                <div id="pwr-slow" class="hidden powerup-badge bg-violet-500/20 border border-violet-400 text-violet-300 px-2 py-1 rounded-lg font-bold">⏱️ <span class="pwr-timer">0s</span></div>
                <div id="pwr-x2" class="hidden powerup-badge bg-yellow-500/20 border border-yellow-400 text-yellow-300 px-2 py-1 rounded-lg font-bold">⭐ <span class="pwr-timer">0s</span></div>
            </div>

            <div id="boss-bar-container" class="hidden relative">
                <div id="boss-bar-glow" class="absolute inset-0 rounded-2xl blur-xl opacity-60" style="background:radial-gradient(circle, #FF007F88, transparent 70%);"></div>
                <div class="relative bg-black/80 rounded-2xl p-3 border-2 border-red-500/70 space-y-2">
                    <div class="flex items-center justify-between">
                        <span id="boss-name" class="font-righteous text-sm text-red-400 flex items-center gap-2">
                            <span class="animate-pulse">👹</span> ANTI-FAN MASTER
                        </span>
                        <span id="boss-hp-text" class="text-xs font-bold text-slate-300">3 / 3</span>
                    </div>
                    <div class="w-full bg-black/90 h-5 rounded-full overflow-hidden border-2 border-red-500/40 relative">
                        <div id="boss-hp-fill" class="h-full bg-gradient-to-r from-red-700 via-red-500 to-red-400 transition-all duration-500 relative">
                            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/40 to-transparent animate-pulse"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="relative overflow-hidden rounded-3xl border-2 border-kpop-pink/50 shadow-[0_0_30px_rgba(255,0,127,0.3)]">
                <canvas id="gameCanvas" width="800" height="420" class="w-full h-auto block bg-slate-950"></canvas>

                <div class="absolute bottom-4 left-4 right-4 flex justify-between items-center pointer-events-none">
                    <div class="flex gap-2 pointer-events-auto">
                        <button id="touch-left-btn" class="bg-black/80 active:bg-kpop-pink text-white font-black w-14 h-14 rounded-2xl border border-white/20 text-2xl flex items-center justify-center backdrop-blur select-none active:scale-95 transition">⬅️</button>
                        <button id="touch-right-btn" class="bg-black/80 active:bg-kpop-pink text-white font-black w-14 h-14 rounded-2xl border border-white/20 text-2xl flex items-center justify-center backdrop-blur select-none active:scale-95 transition">➡️</button>
                    </div>
                    <button id="touch-jump-btn" class="pointer-events-auto bg-gradient-to-r from-kpop-pink to-kpop-purple active:scale-95 text-white font-righteous px-6 py-3.5 rounded-2xl border border-white/20 text-base shadow-xl backdrop-blur select-none">🦘 SALTAR</button>
                </div>

                <div id="game-question-modal" class="hidden absolute inset-0 bg-black/85 backdrop-blur-md flex items-center justify-center p-4 z-30">
                    <div class="kglass rounded-3xl p-6 max-w-lg w-full border-2 border-kpop-pink space-y-4 modal-enter">
                        <div class="flex items-center justify-between border-b border-white/10 pb-3">
                            <span class="bg-kpop-pink/20 border border-kpop-pink text-kpop-pink font-bold text-xs px-3 py-1 rounded-full"><i class="fa-solid fa-bolt text-kpop-yellow"></i> Desafio!</span>
                            <span class="text-xs text-kpop-cyan font-bold">+60% Energia</span>
                        </div>
                        <h4 id="game-modal-q-text" class="font-righteous text-lg text-white">Pergunta...</h4>
                        <div id="game-modal-options" class="grid grid-cols-1 gap-2.5"></div>
                    </div>
                </div>

                <div id="victory-modal" class="hidden absolute inset-0 bg-black/90 backdrop-blur-lg flex items-center justify-center p-4 z-40">
                    <div class="kglass rounded-3xl p-8 max-w-md w-full border-2 border-kpop-yellow space-y-5 modal-enter text-center">
                        <div class="text-6xl animate-bounce">🏆</div>
                        <h3 class="font-righteous text-3xl shimmer-text">CONCERTO PERFEITO!</h3>
                        <p id="victory-message" class="text-slate-300 text-sm"></p>
                        <div class="grid grid-cols-2 gap-3">
                            <div class="bg-black/50 rounded-2xl p-4 border border-white/10">
                                <div class="text-[10px] text-slate-400 font-bold uppercase">Score</div>
                                <div id="victory-score" class="font-righteous text-2xl text-kpop-yellow">0</div>
                            </div>
                            <div class="bg-black/50 rounded-2xl p-4 border border-white/10">
                                <div class="text-[10px] text-slate-400 font-bold uppercase">Stars</div>
                                <div id="victory-stars" class="font-righteous text-2xl text-kpop-cyan">⭐ 3</div>
                            </div>
                        </div>
                        <button id="victory-btn" onclick="nextConcert()" class="w-full bg-gradient-to-r from-kpop-yellow via-kpop-pink to-kpop-purple text-white font-righteous text-lg px-8 py-3.5 rounded-2xl shadow-xl hover:scale-105 transition">🎤 Próximo</button>
                        <button onclick="backToConcerts()" class="w-full text-xs text-slate-400 hover:text-white transition">Voltar ao Mapa</button>
                    </div>
                </div>

                <div id="game-over-modal" class="hidden absolute inset-0 bg-black/90 backdrop-blur-lg flex items-center justify-center p-4 z-40">
                    <div class="kglass rounded-3xl p-8 max-w-md w-full border-2 border-kpop-pink space-y-5 modal-enter text-center">
                        <div class="text-6xl animate-bounce">💫</div>
                        <h3 class="font-righteous text-3xl text-white">PALCO ENCERRADO!</h3>
                        <div class="grid grid-cols-2 gap-3">
                            <div class="bg-black/50 rounded-2xl p-4 border border-white/10">
                                <div class="text-[10px] text-slate-400 font-bold uppercase">Score</div>
                                <div id="gameover-score" class="font-righteous text-2xl text-kpop-yellow">0</div>
                            </div>
                            <div class="bg-black/50 rounded-2xl p-4 border border-white/10">
                                <div class="text-[10px] text-slate-400 font-bold uppercase">Combo</div>
                                <div id="gameover-combo" class="font-righteous text-2xl text-kpop-pink">x0</div>
                            </div>
                            <div class="bg-black/50 rounded-2xl p-4 border border-white/10">
                                <div class="text-[10px] text-slate-400 font-bold uppercase">Recorde</div>
                                <div id="gameover-highscore" class="font-righteous text-2xl text-kpop-mint">0</div>
                            </div>
                            <div class="bg-black/50 rounded-2xl p-4 border border-white/10">
                                <div class="text-[10px] text-slate-400 font-bold uppercase">Checkpoint</div>
                                <div id="gameover-checkpoint" class="font-righteous text-2xl text-kpop-cyan">0m</div>
                            </div>
                        </div>
                        <div class="flex gap-2">
                            <button onclick="retryConcert()" class="flex-1 bg-gradient-to-r from-kpop-pink via-kpop-purple to-kpop-cyan text-white font-righteous px-6 py-3 rounded-2xl hover:scale-105 transition">🔄 Retry</button>
                            <button onclick="backToConcerts()" class="flex-1 bg-black/50 hover:bg-black/70 text-slate-300 font-righteous px-6 py-3 rounded-2xl border border-white/20">🗺️ Mapa</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- AVATAR -->
<section id="section-avatar" class="hidden space-y-6">
    <div class="max-w-4xl mx-auto space-y-6">
        <div class="kglass rounded-3xl p-6 border-2 border-purple-400/40 flex items-center justify-between flex-wrap gap-4">
            <div class="flex items-center gap-3">
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-purple-500 to-pink-500 flex items-center justify-center text-3xl">🎨</div>
                <div>
                    <h3 class="font-righteous text-2xl text-white">Personaliza a tua Idol</h3>
                    <p class="text-xs text-slate-400">Gasta estrelas para desbloquear novos visuais!</p>
                </div>
            </div>
            <div class="text-center bg-black/40 rounded-2xl px-5 py-2 border border-white/10">
                <div class="text-[10px] text-slate-400 font-bold">ESTRELAS DISPONÍVEIS</div>
                <div id="avatar-stars" class="font-righteous text-3xl text-kpop-yellow">0 ⭐</div>
            </div>
        </div>
        <div class="kglass rounded-3xl p-6 border border-white/10">
            <h4 class="font-righteous text-lg text-kpop-cyan mb-4">💇 Cabelo</h4>
            <div id="hair-options" class="grid grid-cols-3 sm:grid-cols-5 gap-3"></div>
        </div>
        <div class="kglass rounded-3xl p-6 border border-white/10">
            <h4 class="font-righteous text-lg text-kpop-pink mb-4">👗 Outfit</h4>
            <div id="outfit-options" class="grid grid-cols-3 sm:grid-cols-5 gap-3"></div>
        </div>
        <div class="kglass rounded-3xl p-6 border border-white/10">
            <h4 class="font-righteous text-lg text-kpop-yellow mb-4">✨ Lightstick</h4>
            <div id="lightstick-options" class="grid grid-cols-3 sm:grid-cols-5 gap-3"></div>
        </div>
    </div>
</section>

<!-- ACHIEVEMENTS -->
<section id="section-achievements" class="hidden space-y-6">
    <div class="max-w-4xl mx-auto space-y-6">
        <div class="kglass rounded-3xl p-6 border-2 border-kpop-yellow/40 text-center">
            <div class="text-6xl mb-2">🏆</div>
            <h3 class="font-righteous text-3xl shimmer-text">As Tuas Conquistas</h3>
            <p class="text-slate-400 text-sm mt-1">Desbloqueia badges ao jogar!</p>
            <div class="mt-3 inline-block bg-black/40 px-5 py-2 rounded-2xl border border-kpop-yellow/30">
                <span id="achievements-progress-text" class="font-righteous text-kpop-yellow text-2xl">0 / 10</span>
            </div>
        </div>
        <div id="achievements-grid-full" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
    </div>
</section>

<!-- DAILY -->
<section id="section-daily" class="hidden space-y-6">
    <div class="max-w-3xl mx-auto space-y-6">
        <div class="kglass rounded-3xl p-6 border-2 border-kpop-yellow/50 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-40 h-40 bg-kpop-yellow/20 rounded-full blur-3xl"></div>
            <div class="relative flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div class="flex items-center gap-4">
                    <div class="w-16 h-16 bg-gradient-to-br from-kpop-yellow to-kpop-pink rounded-2xl flex items-center justify-center text-4xl shadow-lg">📅</div>
                    <div>
                        <h3 class="font-righteous text-3xl text-white">Desafio Diário</h3>
                        <p class="text-xs text-slate-400">5 perguntas — um novo desafio todos os dias!</p>
                    </div>
                </div>
                <div class="text-center bg-black/50 rounded-2xl px-5 py-3 border border-kpop-yellow/30">
                    <div class="text-[10px] text-slate-400 font-bold">STREAK</div>
                    <div id="daily-streak-num" class="font-righteous text-2xl text-kpop-yellow">0🔥</div>
                </div>
            </div>
        </div>
        <div id="daily-content"></div>
        <div id="daily-quiz-area" class="hidden kglass rounded-3xl p-6 md:p-8 border border-kpop-yellow/30 space-y-5">
            <div class="flex items-center justify-between">
                <span id="daily-badge" class="bg-kpop-yellow/20 border border-kpop-yellow text-kpop-yellow px-3 py-1 rounded-full font-bold text-xs">Pergunta 1 / 5</span>
                <span id="daily-score-text" class="font-righteous text-kpop-yellow text-lg">0 acertos</span>
            </div>
            <div class="w-full bg-black/60 h-3 rounded-full overflow-hidden">
                <div id="daily-progress-bar" class="h-full bg-gradient-to-r from-kpop-yellow to-kpop-pink transition-all" style="width:20%"></div>
            </div>
            <h3 id="daily-question-heading" class="font-righteous text-xl text-white">—</h3>
            <div id="daily-options-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
            <div id="daily-feedback" class="hidden p-4 rounded-2xl text-sm font-medium border"></div>
        </div>
    </div>
</section>

<!-- TEACHER -->
<section id="section-teacher" class="hidden space-y-6">
    <div class="max-w-4xl mx-auto space-y-6">
        <div class="kglass rounded-3xl p-6 border-2 border-blue-400/40">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-blue-500 to-cyan-400 flex items-center justify-center text-3xl">👩‍🏫</div>
                <div>
                    <h3 class="font-righteous text-2xl text-white">Modo Professor</h3>
                    <p class="text-xs text-slate-400">Ferramentas para professores</p>
                </div>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
                <div class="bg-black/40 rounded-2xl p-4 border border-white/10 text-center">
                    <div class="text-[10px] text-slate-400 font-bold">ACERTOS QUIZ</div>
                    <div id="teacher-quiz-correct" class="font-righteous text-2xl text-kpop-cyan">0</div>
                </div>
                <div class="bg-black/40 rounded-2xl p-4 border border-white/10 text-center">
                    <div class="text-[10px] text-slate-400 font-bold">BOSSES</div>
                    <div id="teacher-bosses" class="font-righteous text-2xl text-kpop-pink">0</div>
                </div>
                <div class="bg-black/40 rounded-2xl p-4 border border-white/10 text-center">
                    <div class="text-[10px] text-slate-400 font-bold">COMBO</div>
                    <div id="teacher-combo" class="font-righteous text-2xl text-kpop-yellow">0</div>
                </div>
                <div class="bg-black/40 rounded-2xl p-4 border border-white/10 text-center">
                    <div class="text-[10px] text-slate-400 font-bold">ESTRELAS</div>
                    <div id="teacher-stars" class="font-righteous text-2xl text-kpop-mint">0</div>
                </div>
            </div>
            <div class="space-y-3">
                <h4 class="font-righteous text-lg text-kpop-cyan">📝 Criar Palavra Personalizada</h4>
                <div class="flex flex-col sm:flex-row gap-2">
                    <input id="teacher-word" placeholder="Palavra" class="flex-1 bg-black/50 border-2 border-white/20 focus:border-kpop-cyan rounded-xl px-4 py-2.5 text-white font-bold outline-none">
                    <input id="teacher-syllables" placeholder="Divisão: su-per-star" class="flex-1 bg-black/50 border-2 border-white/20 focus:border-kpop-cyan rounded-xl px-4 py-2.5 text-white font-bold outline-none">
                    <button onclick="addCustomWord()" class="bg-gradient-to-r from-kpop-cyan to-kpop-mint text-black font-righteous px-6 py-2.5 rounded-xl">+ Adicionar</button>
                </div>
                <div id="custom-words-list" class="space-y-2 mt-3"></div>
            </div>
            <div class="mt-6 pt-6 border-t border-white/10 flex gap-3 flex-wrap">
                <button onclick="exportStatsCSV()" class="bg-black/50 hover:bg-black/70 border border-white/20 text-slate-300 font-bold px-5 py-2.5 rounded-xl text-sm"><i class="fa-solid fa-download mr-2"></i>Exportar CSV</button>
                <button onclick="resetAllProgress()" class="bg-red-500/20 hover:bg-red-500/40 border border-red-500/50 text-red-300 font-bold px-5 py-2.5 rounded-xl text-sm"><i class="fa-solid fa-trash mr-2"></i>Reset Total</button>
            </div>
        </div>
    </div>
</section>

</main>

<!-- FLOATING BUTTONS -->
<div class="fixed bottom-4 right-4 z-40 flex flex-col gap-2">
    <button onclick="openTeacherMode()" class="hidden md:flex w-12 h-12 rounded-full bg-blue-500/20 border-2 border-blue-400 text-blue-300 items-center justify-center hover:bg-blue-500/40 transition" title="Modo Professor"><i class="fa-solid fa-chalkboard-user text-lg"></i></button>
    <button onclick="toggleSound()" id="float-sound-btn" class="w-12 h-12 rounded-full bg-kpop-pink/20 border-2 border-kpop-pink text-kpop-pink flex items-center justify-center hover:bg-kpop-pink/40 transition" title="Som"><i class="fa-solid fa-volume-high text-lg" id="float-sound-icon"></i></button>
</div>

<!-- SETTINGS MODAL -->
<div id="settings-modal" class="hidden modal-overlay">
    <div class="kglass rounded-3xl p-6 max-w-md w-full border-2 border-kpop-cyan/40 space-y-5">
        <div class="flex items-center justify-between border-b border-white/10 pb-3">
            <h3 class="font-righteous text-2xl text-white">⚙️ Definições</h3>
            <button onclick="closeSettings()" class="text-2xl text-slate-400 hover:text-white">✕</button>
        </div>
        <div class="space-y-4">
            <div>
                <div class="text-sm font-bold text-slate-300 mb-2">🎵 Som</div>
                <button onclick="toggleSound()" class="w-full glass-btn bg-gradient-to-r from-kpop-pink to-kpop-purple text-white font-bold px-4 py-3 rounded-xl"><i class="fa-solid fa-volume-high mr-2"></i><span id="settings-sound-text">Ligado</span></button>
            </div>
            <div>
                <div class="text-sm font-bold text-slate-300 mb-2">📏 Tamanho do Texto</div>
                <div class="grid grid-cols-3 gap-2">
                    <button onclick="setTextSize('normal')" class="bg-black/40 border-2 border-white/20 text-white py-2 rounded-xl font-bold text-sm">Normal</button>
                    <button onclick="setTextSize('large')" class="bg-black/40 border-2 border-white/20 text-white py-2 rounded-xl font-bold text-sm">Grande</button>
                    <button onclick="setTextSize('xl')" class="bg-black/40 border-2 border-white/20 text-white py-2 rounded-xl font-bold text-sm">Máximo</button>
                </div>
