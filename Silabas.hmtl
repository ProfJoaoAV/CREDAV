/* STUDIO */
const knownWordsDict = {
    'superstar':['su','per','star'],'musica':['mú','si','ca'],'música':['mú','si','ca'],
    'lampada':['lâm','pa','da'],'lâmpada':['lâm','pa','da'],'dança':['dan','ça'],'danca':['dan','ça'],
    'k-pop':['k','pop'],'kpop':['k','pop'],'computador':['com','pu','ta','dor'],
    'espetaculo':['es','pe','tá','cu','lo'],'espetáculo':['es','pe','tá','cu','lo'],
    'pessego':['pês','se','go'],'pêssego':['pês','se','go'],'garfo':['gar','fo'],
    'sensivel':['sen','sí','vel'],'sensível':['sen','sí','vel'],'casa':['ca','sa'],
    'andar':['an','dar'],'foguetao':['fo','gue','tão'],'foguetão':['fo','gue','tão'],
    'caracol':['ca','ra','col'],'floresta':['flo','res','ta'],'parque':['par','que'],
    'sol':['sol'],'flor':['flor'],'pao':['pão'],'pão':['pão'],'mar':['mar']
};
function splitSyllablesFallback(word) {
    let clean = word.toLowerCase().trim();
    if (!clean) return [];
    if (knownWordsDict[clean]) return knownWordsDict[clean];
    const vowels = /[aeiouáéíóúâêôãõàü]/i;
    let result = [], current = '';
    for (let i = 0; i < clean.length; i++) {
        let char = clean[i]; let next = clean[i+1] || '';
        current += char;
        if (vowels.test(char)) {
            if (!next) { result.push(current); current = ''; }
            else if (!vowels.test(next)) {
                let third = clean[i+2] || '';
                if (['h','r','l'].includes(next)) { result.push(current); current = ''; }
                else if (vowels.test(third)) { result.push(current); current = ''; }
            } else if (/[áéíóúâêô]/i.test(next)) { result.push(current); current = ''; }
        }
    }
    if (current) result.push(current);
    return result.length > 0 ? result : [word];
}
function detectTonicIndex(syllables) {
    if (syllables.length === 1) return 0;
    for (let i = 0; i < syllables.length; i++) if (/[áéíóúâêôãõ]/i.test(syllables[i])) return i;
    const last = syllables[syllables.length-1].toLowerCase();
    if (/[rlzui]$/.test(last) || last.includes('ão') || last.includes('ã')) return syllables.length-1;
    return Math.max(0, syllables.length-2);
}
function quickFill(w) { document.getElementById('kpopWordInput').value = w; analyzeKpopWord(); }
function analyzeKpopWord() {
    const input = document.getElementById('kpopWordInput').value.trim();
    if (!input) { document.getElementById('kpopWordInput').classList.add('animate-shake'); setTimeout(()=>document.getElementById('kpopWordInput').classList.remove('animate-shake'), 400); return; }
    const syllables = splitSyllablesFallback(input);
    const tonicIdx = detectTonicIndex(syllables);
    const resultBox = document.getElementById('kpopResultBox');
    const sylContainer = document.getElementById('kpopSyllablesContainer');
    const numBadge = document.getElementById('kpopBadgeNum');
    const tonicBadge = document.getElementById('kpopBadgeTonic');
    const eqContainer = document.getElementById('eqBarContainer');
    resultBox.classList.remove('hidden');
    resultBox.classList.add('animate-pop');
    setTimeout(()=>resultBox.classList.remove('animate-pop'), 400);
    sylContainer.innerHTML = ''; eqContainer.innerHTML = '';
    const numText = syllables.length===1?'Monossílabo (1)':syllables.length===2?'Dissílabo (2)':syllables.length===3?'Trissílabo (3)':`Polissílabo (${syllables.length})`;
    const posFromEnd = syllables.length - 1 - tonicIdx;
    const tonicText = posFromEnd===0?'Aguda (Última)':posFromEnd===1?'Grave (Penúltima)':'Esdrúxula (Antepenúltima)';
    numBadge.innerText = `💿 ${numText}`;
    tonicBadge.innerText = `🎤 ${tonicText}`;
    syllables.forEach((syl, i) => {
        const isTonic = (i === tonicIdx);
        const pill = document.createElement('div');
        pill.id = `syl-pill-${i}`;
        pill.className = `syllable-pill px-5 py-3 rounded-2xl font-righteous text-xl flex items-center gap-2 ${
            isTonic ? 'bg-gradient-to-r from-kpop-pink to-kpop-purple text-white shadow-[0_0_25px_#FF007F] border-2 border-white scale-110'
                    : 'bg-black/60 border border-white/20 text-slate-300'}`;
        pill.innerHTML = `<span>${syl}</span> ${isTonic?'🌟':''}`;
        pill.style.opacity = '0'; pill.style.transform = 'translateY(10px)';
        sylContainer.appendChild(pill);
        setTimeout(() => {
            pill.style.transition = 'all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)';
            pill.style.opacity = '1';
            pill.style.transform = isTonic ? 'translateY(0) scale(1.1)' : 'translateY(0) scale(1)';
        }, i * 80);
        const bar = document.createElement('div');
        bar.id = `eq-bar-${i}`;
        bar.className = 'flex-1 bg-gradient-to-t from-kpop-purple to-kpop-pink rounded-t-lg transition-all duration-300';
        bar.style.height = isTonic ? '100%' : '35%';
        eqContainer.appendChild(bar);
    });
    syllables.forEach((_, i) => {
        setTimeout(() => {
            const isTonic = (i === tonicIdx);
            playTone(isTonic?650:420, isTonic?'triangle':'sine', 0.2, isTonic?0.22:0.15);
            const p = document.getElementById(`syl-pill-${i}`);
            if (p) { p.classList.add('ring-4','ring-kpop-yellow'); setTimeout(()=>p.classList.remove('ring-4','ring-kpop-yellow'), 250); }
        }, i * 320);
    });
}

/* QUIZ */
const quizDatabase = [
    { q:"Divisão silábica de 'música'?", options:["mú-si-ca","mús-i-ca","músi-ca","m-ú-si-ca"], ans:0, exp:"3 sílabas perfeitas!" },
    { q:"'sol' quanto ao número:", options:["Dissílabo","Monossílabo","Trissílabo","Polissílabo"], ans:1, exp:"Um impulso." },
    { q:"'computador' é:", options:["Trissílabo","Dissílabo","Polissílabo","Monossílabo"], ans:2, exp:"4+ sílabas!" },
    { q:"Sílaba tónica de 'lâmpada':", options:["da","pa","lâm","da-pa"], ans:2, exp:"Antepenúltima." },
    { q:"'lâmpada' é:", options:["Aguda","Grave","Esdrúxula","Monossílaba"], ans:2, exp:"Tónica antepenúltima." },
    { q:"Regra das Esdrúxulas:", options:["Sempre acento","Terminam -o","2 sílabas","Sem acento"], ans:0, exp:"SEMPRE acento!" },
    { q:"Qual é Dissílabo?", options:["Mar","Casa","Lâmpada","Espetáculo"], ans:1, exp:"'Ca-sa'." },
    { q:"'caracol' é Aguda porque a tónica é:", options:["'ca'","'ra'","'col'","Não tem"], ans:2, exp:"Última." },
    { q:"Divisão de 'dança':", options:["d-an-ça","dan-ça","da-nça","danc-a"], ans:1, exp:"2 sílabas." },
    { q:"'floresta' quanto ao número:", options:["Monossílabo","Dissílabo","Trissílabo","Polissílabo"], ans:2, exp:"3 sílabas." },
    { q:"'garfo' - posição da tónica:", options:["Última","Penúltima","Antepenúltima","Primeira"], ans:1, exp:"Penúltima." },
    { q:"Qual é Aguda?", options:["Pêssego","Janela","Foguetão","Árvore"], ans:2, exp:"'tão' é a tónica!" },
    { q:"Divisão de 'pêssego':", options:["pê-sse-go","pês-se-go","pêss-e-go","pê-s-se-go"], ans:1, exp:"'ss' separam-se!" },
    { q:"'árvore' é:", options:["Aguda","Grave","Esdrúxula","Monossílaba"], ans:2, exp:"Antepenúltima." },
    { q:"Qual é Monossílabo?", options:["Pão","Papel","Caneta","Livro"], ans:0, exp:"1 sílaba." },
    { q:"'janela' é:", options:["Esdrúxula","Grave","Aguda","Polissílaba"], ans:1, exp:"'ne' penúltima." },
    { q:"Quantas sílabas tem 'espetáculo'?", options:["3","4","5","2"], ans:2, exp:"Es-pe-tá-cu-lo." },
    { q:"Qual é Grave?", options:["Café","Escola","Símbolo","Jardim"], ans:1, exp:"Es-CO-la." },
    { q:"'andar' é:", options:["Esdrúxula","Grave","Aguda","Trissílaba"], ans:2, exp:"Última." },
    { q:"'público' - tónica é:", options:["Última","Penúltima","Antepenúltima","2.ª"], ans:2, exp:"'PÚ-bli-co'." },
    { q:"Divisão de 'carro':", options:["ca-rro","car-ro","c-ar-ro","carr-o"], ans:1, exp:"'rr' separam!" },
    { q:"'borboleta' é:", options:["Dissílabo","Trissílabo","Polissílabo","Monossílabo"], ans:2, exp:"4 sílabas." },
    { q:"Qual é Trissílabo?", options:["Flor","Gato","Caderno","Computador"], ans:2, exp:"Ca-der-no." },
    { q:"Sílaba tónica de 'sensível':", options:["sen","sí","vel","vel-sí"], ans:1, exp:"Sen-SÍ-vel." },
    { q:"Qual NÃO é Grave?", options:["Mesa","Cadeira","Sofá","Caderno"], ans:2, exp:"'Sofá' é Aguda!" },
    { q:"'flor' quanto ao número:", options:["Monossílabo","Dissílabo","Trissílabo","Polissílabo"], ans:0, exp:"Não se divide." },
    { q:"Só Agudas:", options:["Café, Ananás, Funil","Lâmpada, Pêssego, Árvore","Casa, Mesa, Livro","Sol, Mar, Pão"], ans:0, exp:"Tónica na última." },
    { q:"Divisão de 'palhaço':", options:["pa-lha-ço","pal-ha-ço","palh-a-ço","pa-lh-a-ço"], ans:0, exp:"'lh' não separa!" },
    { q:"'ch' separa-se na divisão?", options:["Sim","Não","Às vezes","No fim"], ans:1, exp:"'ch','lh','nh' juntos!" },
    { q:"'Gramática' é:", options:["Esdrúxula e Polissílaba","Grave e Trissílaba","Aguda e Dissílaba","Monossílaba"], ans:0, exp:"4 sílabas, tónica antepenúltima." }
];
let currentQuizIndex = 0, quizScore = 0, comboStreak = 0, selectedOptionIdx = null;
function restartAuditionQuiz() {
    currentQuizIndex = 0; quizScore = 0; comboStreak = 0;
    document.getElementById('quiz-active-box').classList.remove('hidden');
    document.getElementById('quiz-summary-screen').classList.add('hidden');
    updateQuizHeaderUI();
    loadQuizQuestion();
}
function updateQuizHeaderUI() {
    document.getElementById('quiz-score-num').innerText = quizScore;
    document.getElementById('quiz-combo-text').innerText = `${comboStreak}x`;
    const rt = document.getElementById('idol-rank-title');
    if (quizScore >= 250) rt.innerText = "Global Superstar 👑";
    else if (quizScore >= 150) rt.innerText = "Lead Vocalist 🎤";
    else if (quizScore >= 70) rt.innerText = "Idol Rookie 🌟";
    else rt.innerText = "Trainee 🌟";
}
function loadQuizQuestion() {
    selectedOptionIdx = null;
    const qData = quizDatabase[currentQuizIndex];
    const h = document.getElementById('quiz-question-heading');
    h.classList.remove('animate-pop'); void h.offsetWidth; h.classList.add('animate-pop');
    document.getElementById('quiz-question-badge').innerText = `Pergunta ${currentQuizIndex+1} / ${quizDatabase.length}`;
    document.getElementById('quiz-progress-bar').style.width = `${((currentQuizIndex+1)/quizDatabase.length)*100}%`;
    h.innerText = qData.q;
    const grid = document.getElementById('quiz-options-grid');
    grid.innerHTML = '';
    const fb = document.getElementById('quiz-feedback-box');
    fb.className = 'hidden p-4 rounded-2xl text-sm font-medium border';
    document.getElementById('quiz-next-btn').classList.add('hidden');
    qData.options.forEach((optText, i) => {
        const btn = document.createElement('button');
        btn.id = `quiz-opt-btn-${i}`;
        btn.onclick = () => selectQuizOption(i);
        btn.className = "w-full text-left p-4 rounded-2xl border border-white/10 bg-white/5 hover:bg-white/10 hover:border-kpop-pink transition-all font-bold text-white flex items-center justify-between group";
        btn.innerHTML = `<span>${optText}</span><span class="w-6 h-6 rounded-full border border-white/20 group-hover:border-kpop-pink flex items-center justify-center text-xs">${String.fromCharCode(65+i)}</span>`;
        grid.appendChild(btn);
        btn.style.opacity = '0'; btn.style.transform = 'translateX(-10px)';
        setTimeout(() => { btn.style.transition = 'all 0.3s'; btn.style.opacity = '1'; btn.style.transform = 'translateX(0)'; }, i*60);
    });
}
function selectQuizOption(idx) {
    if (selectedOptionIdx !== null) return;
    selectedOptionIdx = idx;
    const qData = quizDatabase[currentQuizIndex];
    const isCorrect = (idx === qData.ans);
    const selectedBtn = document.getElementById(`quiz-opt-btn-${idx}`);
    const correctBtn = document.getElementById(`quiz-opt-btn-${qData.ans}`);
    if (isCorrect) {
        quizScore += 10 + (comboStreak * 2); comboStreak++;
        achievementsState.stats.quizCorrect = (achievementsState.stats.quizCorrect||0) + 1;
        saveAchievements(); checkAchievements();
        selectedBtn.className = "w-full text-left p-4 rounded-2xl border-2 border-kpop-mint bg-kpop-mint/20 font-bold text-white flex items-center justify-between animate-correct";
        playSuccessSound();
    } else {
        comboStreak = 0;
        selectedBtn.className = "w-full text-left p-4 rounded-2xl border-2 border-kpop-pink bg-kpop-pink/20 font-bold text-white flex items-center justify-between animate-shake";
        correctBtn.className = "w-full text-left p-4 rounded-2xl border-2 border-kpop-mint bg-kpop-mint/20 font-bold text-white flex items-center justify-between";
        playErrorSound();
    }
    const fb = document.getElementById('quiz-feedback-box');
    fb.classList.remove('hidden');
    if (isCorrect) { fb.classList.add('bg-kpop-mint/10','border-kpop-mint/40','text-emerald-300'); fb.innerHTML = `✨ <strong>Correto!</strong> ${qData.exp}`; }
    else { fb.classList.add('bg-kpop-pink/10','border-kpop-pink/40','text-rose-300'); fb.innerHTML = `❌ <strong>Incorreto!</strong> ${qData.exp}`; }
    updateQuizHeaderUI();
    document.getElementById('quiz-next-btn').classList.remove('hidden');
}
function nextQuizStep() {
    if (currentQuizIndex < quizDatabase.length - 1) { currentQuizIndex++; loadQuizQuestion(); }
    else {
        document.getElementById('quiz-active-box').classList.add('hidden');
        document.getElementById('quiz-summary-screen').classList.remove('hidden');
        document.getElementById('final-correct-score').innerText = Math.round(quizScore/10);
        if (quizScore >= 250) { achievementsState.stats.quizPerfect = true; saveAchievements(); checkAchievements(); }
    }
}

/* ACHIEVEMENTS */
const ACHIEVEMENTS = [
    { id:'first_correct', name:'Primeiro Acerto', desc:'Acerta 1 pergunta', icon:'🎯', check: s => (s.quizCorrect||0) >= 1 },
    { id:'combo_10', name:'Em Chamas', desc:'Combo x10', icon:'🔥', check: s => (s.maxCombo||0) >= 10 },
    { id:'combo_20', name:'Combo Master', desc:'Combo x20', icon:'⚡', check: s => (s.maxCombo||0) >= 20 },
    { id:'boss_1', name:'Caçador', desc:'Derrota 1 boss', icon:'👹', check: s => (s.bossesDefeated||0) >= 1 },
    { id:'boss_all', name:'Lenda', desc:'Derrota 5 bosses', icon:'👑', check: s => (s.bossesDefeated||0) >= 5 },
    { id:'quiz_perfect', name:'Perfeição', desc:'Quiz perfeito', icon:'💯', check: s => s.quizPerfect === true },
    { id:'no_damage', name:'Intocável', desc:'Boss sem perder vida', icon:'🛡️', check: s => s.noDamageBoss === true },
    { id:'all_worlds', name:'Poliglota', desc:'Joga 5 mundos', icon:'🌍', check: s => (s.worldsPlayed||[]).length >= 5 },
    { id:'stars_10', name:'Colecionador', desc:'10 estrelas', icon:'⭐', check: s => (s.totalStars||0) >= 10 },
    { id:'streak_5', name:'Em Sequência', desc:'5 dias seguidos', icon:'📅', check: s => (s.dailyStreak||0) >= 5 }
];
function checkAchievements() {
    ACHIEVEMENTS.forEach(ach => {
        if (achievementsState.unlocked.includes(ach.id)) return;
        if (ach.check(achievementsState.stats)) {
            achievementsState.unlocked.push(ach.id);
            showAchievementToast(ach);
            saveAchievements();
        }
    });
    renderAchievementsFull();
}
function showAchievementToast(ach) {
    const toast = document.createElement('div');
    toast.className = 'achievement-toast toast-in';
    toast.innerHTML = `<div class="text-4xl">${ach.icon}</div><div class="flex-1"><div class="text-[10px] text-kpop-yellow font-black uppercase tracking-widest">🏅 CONQUISTA!</div><div class="font-righteous text-lg text-white">${ach.name}</div><div class="text-xs text-slate-400">${ach.desc}</div></div>`;
    document.body.appendChild(toast);
    playSuccessSound();
    setTimeout(() => { toast.style.animation = 'toastIn 0.4s reverse forwards'; setTimeout(()=>toast.remove(), 400); }, 4000);
}
function renderAchievementsFull() {
    const grid = document.getElementById('achievements-grid-full');
    if (!grid) return;
    grid.innerHTML = '';
    ACHIEVEMENTS.forEach(ach => {
        const unlocked = achievementsState.unlocked.includes(ach.id);
        const card = document.createElement('div');
        card.className = `bg-black/40 border-2 ${unlocked?'border-kpop-yellow':'border-white/10'} rounded-2xl p-4 flex items-center gap-3 ${unlocked?'':'opacity-50'}`;
        card.innerHTML = `<div class="text-3xl">${unlocked?ach.icon:'🔒'}</div><div class="flex-1"><div class="font-righteous text-base ${unlocked?'text-kpop-yellow':'text-slate-400'}">${ach.name}</div><div class="text-xs text-slate-400">${ach.desc}</div></div>`;
        grid.appendChild(card);
    });
    const p = document.getElementById('achievements-progress-text');
    if (p) p.innerText = `${achievementsState.unlocked.length} / ${ACHIEVEMENTS.length}`;
}

/* DAILY */
let dailyChallenge = { words: [], currentIdx: 0, correct: 0, active: false };
function getTodayKey() { const d = new Date(); return `${d.getFullYear()}-${d.getMonth()+1}-${d.getDate()}`; }
function getDailyWords() {
    const d = new Date();
    const seed = d.getFullYear()*10000 + (d.getMonth()+1)*100 + d.getDate();
    const pool = quizDatabase.slice();
    const selected = [];
    let s = seed;
    for (let i = 0; i < 5; i++) {
        s = (s * 9301 + 49297) % 233280;
        const idx = Math.floor((s/233280) * pool.length);
        selected.push(pool[idx]);
        pool.splice(idx, 1);
    }
    return selected;
}
function updateDailyUI() {
    const todayKey = getTodayKey();
    const lastPlayed = localStorage.getItem('ksilaba_daily_last');
    const streak = achievementsState.stats.dailyStreak || 0;
    document.getElementById('daily-streak-num').innerText = `${streak}🔥`;
    const container = document.getElementById('daily-content');
    if (lastPlayed === todayKey) {
        container.innerHTML = `<div class="bg-emerald-500/10 border-2 border-emerald-500/40 rounded-3xl p-8 text-center"><div class="text-6xl mb-3">✅</div><div class="font-righteous text-2xl text-emerald-300">Já completaste hoje!</div><div class="text-sm text-slate-400 mt-2">Volta amanhã para manter a streak 🔥</div></div>`;
        document.getElementById('daily-quiz-area').classList.add('hidden');
    } else {
        container.innerHTML = `<div class="kglass rounded-3xl p-6 border border-kpop-yellow/30 space-y-4"><div class="grid grid-cols-5 gap-2">${[1,2,3,4,5].map(i=>`<div class="bg-black/40 border border-white/10 rounded-xl p-3 text-center"><div class="text-kpop-yellow font-righteous text-xl">${i}</div><div class="text-[10px] text-slate-400 font-bold">PERG.</div></div>`).join('')}</div><button onclick="startDaily()" class="w-full glass-btn bg-gradient-to-r from-kpop-yellow via-kpop-pink to-kpop-purple text-white font-righteous text-lg px-6 py-3.5 rounded-2xl"><i class="fa-solid fa-bolt mr-2"></i>Começar Desafio de Hoje</button></div>`;
        document.getElementById('daily-quiz-area').classList.add('hidden');
    }
}
function startDaily() {
    dailyChallenge.words = getDailyWords();
    dailyChallenge.currentIdx = 0;
    dailyChallenge.correct = 0;
    dailyChallenge.active = true;
    document.getElementById('daily-quiz-area').classList.remove('hidden');
    loadDailyQuestion();
}
function loadDailyQuestion() {
    if (dailyChallenge.currentIdx >= 5) { finishDaily(); return; }
    const qData = dailyChallenge.words[dailyChallenge.currentIdx];
    document.getElementById('daily-badge').innerText = `📅 PERGUNTA ${dailyChallenge.currentIdx+1} / 5`;
    document.getElementById('daily-score-text').innerText = `${dailyChallenge.correct} acertos`;
    document.getElementById('daily-progress-bar').style.width = `${((dailyChallenge.currentIdx+1)/5)*100}%`;
    document.getElementById('daily-question-heading').innerText = qData.q;
    const grid = document.getElementById('daily-options-grid');
    grid.innerHTML = '';
    document.getElementById('daily-feedback').className = 'hidden p-4 rounded-2xl text-sm font-medium border';
    qData.options.forEach((optText, i) => {
        const btn = document.createElement('button');
        btn.className = "w-full text-left p-4 rounded-2xl border border-white/10 bg-white/5 hover:bg-white/10 hover:border-kpop-yellow transition-all font-bold text-white";
        btn.innerText = optText;
        btn.onclick = () => selectDailyOption(i, qData);
        grid.appendChild(btn);
    });
}
function selectDailyOption(idx, qData) {
    const isCorrect = idx === qData.ans;
    const fb = document.getElementById('daily-feedback');
    fb.classList.remove('hidden');
    if (isCorrect) {
        dailyChallenge.correct++;
        fb.classList.add('bg-kpop-mint/10','border-kpop-mint/40','text-emerald-300');
        fb.innerHTML = `✨ <strong>Correto!</strong> ${qData.exp}`;
        playSuccessSound();
    } else {
        fb.classList.add('bg-kpop-pink/10','border-kpop-pink/40','text-rose-300');
        fb.innerHTML = `❌ <strong>Incorreto.</strong> ${qData.exp}`;
        playErrorSound();
    }
    document.getElementById('daily-score-text').innerText = `${dailyChallenge.correct} acertos`;
    setTimeout(() => { dailyChallenge.currentIdx++; loadDailyQuestion(); }, 1500);
}
function finishDaily() {
    document.getElementById('daily-quiz-area').classList.add('hidden');
    const todayKey = getTodayKey();
    const lastPlayed = localStorage.getItem('ksilaba_daily_last');
    const yesterday = new Date(); yesterday.setDate(yesterday.getDate()-1);
    const yesterdayKey = `${yesterday.getFullYear()}-${yesterday.getMonth()+1}-${yesterday.getDate()}`;
    if (lastPlayed === yesterdayKey) achievementsState.stats.dailyStreak = (achievementsState.stats.dailyStreak||0) + 1;
    else achievementsState.stats.dailyStreak = 1;
    localStorage.setItem('ksilaba_daily_last', todayKey);
    saveAchievements(); checkAchievements();
    const container = document.getElementById('daily-content');
    container.innerHTML = `<div class="kglass rounded-3xl p-8 border-2 border-kpop-yellow/50 text-center space-y-4"><div class="text-6xl animate-bounce">🎉</div><h3 class="font-righteous text-3xl shimmer-text">DESAFIO COMPLETO!</h3><p class="text-2xl text-white">Acertaste <strong class="text-kpop-yellow">${dailyChallenge.correct}/5</strong></p><p class="text-sm text-slate-300">Streak: <strong class="text-kpop-yellow">${achievementsState.stats.dailyStreak}🔥</strong></p><button onclick="switchTab('daily')" class="bg-gradient-to-r from-kpop-yellow to-kpop-pink text-black font-righteous px-6 py-3 rounded-2xl">OK</button></div>`;
    playSuccessSound();
}

/* AVATAR */
const HAIR_STYLES = [
    { id:'pink', name:'Pink Neon', cost:0, color1:'#FF007F', color2:'#7928CA' },
    { id:'cyan', name:'Cyan Idol', cost:5, color1:'#00F2FE', color2:'#7928CA' },
    { id:'gold', name:'Golden Pop', cost:10, color1:'#FFE600', color2:'#FF6B00' },
    { id:'mint', name:'Mint Dream', cost:10, color1:'#00FFAB', color2:'#00F2FE' },
    { id:'purple', name:'Purple Royal', cost:15, color1:'#7928CA', color2:'#FF007F' }
];
const OUTFIT_STYLES = [
    { id:'purple', name:'Purple Classic', cost:0, color1:'#FF007F', color2:'#7928CA', belt:'#FFE600' },
    { id:'blue', name:'Ocean Wave', cost:5, color1:'#00F2FE', color2:'#7928CA', belt:'#FFE600' },
    { id:'sunset', name:'Sunset Fire', cost:10, color1:'#FF6B00', color2:'#FF2A85', belt:'#FFE600' },
    { id:'mint', name:'Mint Fresh', cost:15, color1:'#00FFAB', color2:'#00F2FE', belt:'#FF007F' },
    { id:'royal', name:'Royal Gold', cost:20, color1:'#FFD700', color2:'#FF007F', belt:'#00F2FE' }
];
const LIGHTSTICK_STYLES = [
    { id:'neon', name:'Neon Pink', cost:0, color:'#FF007F' },
    { id:'cyan', name:'Cyan Beam', cost:5, color:'#00F2FE' },
    { id:'gold', name:'Golden Ray', cost:10, color:'#FFE600' },
    { id:'mint', name:'Mint Flash', cost:10, color:'#00FFAB' },
    { id:'rainbow', name:'Rainbow', cost:25, color:'rainbow' }
];
function renderAvatarShop() {
    document.getElementById('avatar-stars').innerText = `${progress.totalStars || 0} ⭐`;
    renderOptionList('hair-options', HAIR_STYLES, 'hair', 'ownedHair', avatarState.hair);
    renderOptionList('outfit-options', OUTFIT_STYLES, 'outfit', 'ownedOutfit', avatarState.outfit);
    renderOptionList('lightstick-options', LIGHTSTICK_STYLES, 'lightstick', 'ownedLightstick', avatarState.lightstick);
}
function renderOptionList(containerId, list, type, ownedKey, current) {
    const c = document.getElementById(containerId);
    if (!c) return;
    c.innerHTML = '';
    list.forEach(item => {
        const owned = avatarState[ownedKey].includes(item.id);
        const isCurrent = current === item.id;
        const div = document.createElement('div');
        div.className = `avatar-option ${owned?'':'locked'} ${isCurrent?'selected':''} bg-black/40 rounded-2xl p-3 text-center`;
        let visual = '';
        if (type === 'hair') visual = `<div class="w-12 h-12 rounded-full mx-auto" style="background:linear-gradient(135deg,${item.color1},${item.color2})"></div>`;
        else if (type === 'outfit') visual = `<div class="w-12 h-12 rounded-lg mx-auto flex flex-col overflow-hidden"><div style="background:${item.color1};flex:1"></div><div style="background:${item.color2};flex:1"></div></div>`;
        else if (type === 'lightstick') visual = item.color==='rainbow' ? `<div class="w-12 h-12 rounded-full mx-auto" style="background:conic-gradient(red,orange,yellow,green,blue,indigo,violet,red)"></div>` : `<div class="w-12 h-12 rounded-full mx-auto" style="background:${item.color};box-shadow:0 0 20px ${item.color}"></div>`;
        div.innerHTML = `${visual}<div class="text-xs font-bold text-white mt-2">${item.name}</div><div class="text-[10px] ${owned?'text-kpop-mint':'text-kpop-yellow'} mt-1">${owned?(isCurrent?'✓ Ativo':'Escolher'):`⭐ ${item.cost}`}</div>`;
        div.onclick = () => handleAvatarSelect(item, type, ownedKey, owned);
        c.appendChild(div);
    });
}
function handleAvatarSelect(item, type, ownedKey, owned) {
    if (!owned) {
        if (progress.totalStars >= item.cost) {
            progress.totalStars -= item.cost;
            avatarState[ownedKey].push(item.id);
            saveProgress(); saveAvatar();
            playSuccessSound();
            showMiniToast('✨ Desbloqueado!', item.name);
        } else {
            playErrorSound();
            showMiniToast('❌ Estrelas insuficientes', `Precisas de ${item.cost} ⭐`);
            return;
        }
    }
    avatarState[type] = item.id;
    saveAvatar();
    renderAvatarShop();
    if (type !== 'lightstick' && owned) playTone(660, 'sine', 0.15);
}
function showMiniToast(title, subtitle) {
    const t = document.createElement('div');
    t.className = 'achievement-toast toast-in';
    t.style.borderColor = '#00F2FE';
    t.innerHTML = `<div class="text-3xl">✨</div><div><div class="font-righteous text-white text-sm">${title}</div><div class="text-xs text-slate-400">${subtitle}</div></div>`;
    document.body.appendChild(t);
    setTimeout(() => { t.style.animation = 'toastIn 0.4s reverse forwards'; setTimeout(()=>t.remove(),400); }, 2500);
}

/* TEACHER */
function openTeacherMode() { switchTab('teacher'); }
function renderTeacherStats() {
    document.getElementById('teacher-quiz-correct').innerText = achievementsState.stats.quizCorrect || 0;
    document.getElementById('teacher-bosses').innerText = achievementsState.stats.bossesDefeated || 0;
    document.getElementById('teacher-combo').innerText = achievementsState.stats.maxCombo || 0;
    document.getElementById('teacher-stars').innerText = progress.totalStars || 0;
    const list = document.getElementById('custom-words-list');
    list.innerHTML = '';
    customWords.forEach((w, i) => {
        const div = document.createElement('div');
        div.className = 'bg-black/40 rounded-xl p-3 flex items-center justify-between';
        div.innerHTML = `<div><strong class="text-kpop-cyan">${w.word}</strong> <span class="text-xs text-slate-400">→ ${w.syllables}</span></div><button onclick="removeCustomWord(${i})" class="text-red-400 hover:text-red-200"><i class="fa-solid fa-trash"></i></button>`;
        list.appendChild(div);
    });
}
function addCustomWord() {
    const word = document.getElementById('teacher-word').value.trim();
    const syl = document.getElementById('teacher-syllables').value.trim();
    if (!word || !syl) return;
    customWords.push({ word, syllables: syl });
    saveCustomWords();
    document.getElementById('teacher-word').value = '';
    document.getElementById('teacher-syllables').value = '';
    renderTeacherStats();
    playSuccessSound();
}
function removeCustomWord(i) { customWords.splice(i, 1); saveCustomWords(); renderTeacherStats(); }
function exportStatsCSV() {
    const csv = `Estatística,Valor\nQuiz acertos,${achievementsState.stats.quizCorrect||0}\nBosses derrotados,${achievementsState.stats.bossesDefeated||0}\nMelhor combo,${achievementsState.stats.maxCombo||0}\nEstrelas totais,${progress.totalStars||0}\n`;
    const blob = new Blob([csv], { type: 'text/csv' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = 'k-silaba-stats.csv'; a.click();
    URL.revokeObjectURL(url);
}
function resetAllProgress() {
    if (!confirm('Tens a certeza? TODA a progressão será apagada!')) return;
    localStorage.clear(); location.reload();
}

/* SETTINGS */
function openSettings() { document.getElementById('settings-modal').classList.remove('hidden'); }
function closeSettings() { document.getElementById('settings-modal').classList.add('hidden'); }
function setTextSize(size) {
    document.body.classList.remove('text-large','text-xl');
    if (size === 'large') document.body.classList.add('text-large');
    if (size === 'xl') document.body.classList.add('text-xl');
    localStorage.setItem('ksilaba_textsize', size);
}
function toggleHighContrast() {
    document.body.classList.toggle('high-contrast');
    localStorage.setItem('ksilaba_contrast', document.body.classList.contains('high-contrast') ? '1' : '0');
}
function toggleReduceMotion() {
    document.body.classList.toggle('reduce-motion');
    localStorage.setItem('ksilaba_motion', document.body.classList.contains('reduce-motion') ? '1' : '0');
}
if (localStorage.getItem('ksilaba_textsize') === 'large') document.body.classList.add('text-large');
if (localStorage.getItem('ksilaba_textsize') === 'xl') document.body.classList.add('text-xl');
if (localStorage.getItem('ksilaba_contrast') === '1') document.body.classList.add('high-contrast');
if (localStorage.getItem('ksilaba_motion') === '1') document.body.classList.add('reduce-motion');
if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.body.classList.add('reduce-motion');

/* DUEL */
let duelState = { active: false, p1hp: 100, p2hp: 100, p1score: 0, p2score: 0, currentQ: null, p1Answered: false, p2Answered: false };
function startDuel() {
    document.getElementById('duel-modal').classList.remove('hidden');
    document.getElementById('duel-intro').classList.remove('hidden');
    document.getElementById('duel-game').classList.add('hidden');
    document.getElementById('duel-end').classList.add('hidden');
}
function closeDuel() { duelState.active = false; document.getElementById('duel-modal').classList.add('hidden'); }
function beginDuel() {
    duelState = { active: true, p1hp: 100, p2hp: 100, p1score: 0, p2score: 0, currentQ: null, p1Answered: false, p2Answered: false };
    document.getElementById('duel-intro').classList.add('hidden');
    document.getElementById('duel-game').classList.remove('hidden');
    updateDuelUI();
    nextDuelQuestion();
}
function nextDuelQuestion() {
    if (!duelState.active) return;
    if (duelState.p1hp <= 0 || duelState.p2hp <= 0) { endDuel(); return; }
    const q = quizDatabase[Math.floor(Math.random() * quizDatabase.length)];
    duelState.currentQ = q;
    duelState.p1Answered = false;
    duelState.p2Answered = false;
    document.getElementById('duel-question').innerText = q.q;
    const p1Box = document.getElementById('duel-p1-options');
    const p2Box = document.getElementById('duel-p2-options');
    p1Box.innerHTML = ''; p2Box.innerHTML = '';
    const keys1 = ['A','S','D','F'];
    const keys2 = ['←','↑','↓','→'];
    q.options.forEach((opt, i) => {
        const b1 = document.createElement('button');
        b1.className = 'p-2 rounded-lg bg-white/5 border border-kpop-pink/30 text-white text-xs font-bold';
        b1.innerHTML = `<span class="text-kpop-pink">${keys1[i]}</span> ${opt}`;
        b1.onclick = () => duelAnswer(1, i);
        p1Box.appendChild(b1);
        const b2 = document.createElement('button');
        b2.className = 'p-2 rounded-lg bg-white/5 border border-kpop-cyan/30 text-white text-xs font-bold';
        b2.innerHTML = `<span class="text-kpop-cyan">${keys2[i]}</span> ${opt}`;
        b2.onclick = () => duelAnswer(2, i);
        p2Box.appendChild(b2);
    });
}
function duelAnswer(player, idx) {
    if (!duelState.active || !duelState.currentQ) return;
    const q = duelState.currentQ;
    const isCorrect = idx === q.ans;
    if (player === 1 && !duelState.p1Answered) {
        duelState.p1Answered = true;
        if (isCorrect) { duelState.p1score++; duelState.p2hp -= 20; playTone(900,'triangle',0.2); }
        else { duelState.p1hp -= 15; playErrorSound(); }
    }
    if (player === 2 && !duelState.p2Answered) {
        duelState.p2Answered = true;
        if (isCorrect) { duelState.p2score++; duelState.p1hp -= 20; playTone(900,'triangle',0.2); }
        else { duelState.p2hp -= 15; playErrorSound(); }
    }
    updateDuelUI();
    if (duelState.p1Answered && duelState.p2Answered) setTimeout(nextDuelQuestion, 1000);
    if (duelState.p1hp <= 0 || duelState.p2hp <= 0) setTimeout(endDuel, 800);
}
function updateDuelUI() {
    document.getElementById('duel-p1-hp').style.width = `${Math.max(0,duelState.p1hp)}%`;
    document.getElementById('duel-p2-hp').style.width = `${Math.max(0,duelState.p2hp)}%`;
    document.getElementById('duel-p1-score').innerText = duelState.p1score;
    document.getElementById('duel-p2-score').innerText = duelState.p2score;
}
function endDuel() {
    duelState.active = false;
    document.getElementById('duel-game').classList.add('hidden');
    document.getElementById('duel-end').classList.remove('hidden');
    const winner = duelState.p1hp > duelState.p2hp ? 'JOGADOR 1 🎤' : 'JOGADOR 2 🌟';
    document.getElementById('duel-winner').innerText = `Vitória do ${winner}!`;
    playSuccessSound();
}
document.addEventListener('keydown', (e) => {
    if (!duelState.active) return;
    const k = e.key.toLowerCase();
    if (k === 'a') duelAnswer(1, 0);
    if (k === 's') duelAnswer(1, 1);
    if (k === 'd') duelAnswer(1, 2);
    if (k === 'f') duelAnswer(1, 3);
    if (e.key === 'ArrowLeft') duelAnswer(2, 0);
    if (e.key === 'ArrowUp') duelAnswer(2, 1);
    if (e.key === 'ArrowDown') duelAnswer(2, 2);
    if (e.key === 'ArrowRight') duelAnswer(2, 3);
});

/* KARAOKE */
let micStream = null, micAnalyser = null, micDataArray = null;
let karaokeActive = false, karaokeWordIdx = 0, karaokeWords = [];
let karaokeScore = 0, karaokeTries = 0, karaokePeakTimeout = null;
let currentKaraokeTonicDone = false;
const KARAOKE_WORDS = [
    { word:'casa', syllables:['CA','sa'], tonicIdx:0 },
    { word:'janela', syllables:['ja','NE','la'], tonicIdx:1 },
    { word:'lâmpada', syllables:['LÂM','pa','da'], tonicIdx:0 },
    { word:'feliz', syllables:['fe','LIZ'], tonicIdx:1 },
    { word:'caderno', syllables:['ca','DER','no'], tonicIdx:1 },
    { word:'coração', syllables:['co','ra','ÇÃO'], tonicIdx:2 },
    { word:'música', syllables:['MÚ','si','ca'], tonicIdx:0 },
    { word:'floresta', syllables:['flo','RES','ta'], tonicIdx:1 },
    { word:'caracol', syllables:['ca','ra','COL'], tonicIdx:2 },
    { word:'pêssego', syllables:['PÊS','se','go'], tonicIdx:0 }
];
async function requestMicAccess() {
    try {
        micStream = await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: true, noiseSuppression: true } });
        const ctx = getAudioContext();
        const src = ctx.createMediaStreamSource(micStream);
        micAnalyser = ctx.createAnalyser();
        micAnalyser.fftSize = 512;
        micDataArray = new Uint8Array(micAnalyser.frequencyBinCount);
        src.connect(micAnalyser);
        document.getElementById('karaoke-permission').classList.add('hidden');
        document.getElementById('karaoke-active').classList.remove('hidden');
        karaokeActive = true;
        karaokeWords = KARAOKE_WORDS.slice().sort(() => Math.random() - 0.5).slice(0, 8);
        karaokeWordIdx = 0; karaokeScore = 0; karaokeTries = 0;
        loadKaraokeWord();
        monitorMic();
    } catch(e) { alert('Não conseguimos acessar o microfone.'); }
}
function monitorMic() {
    if (!karaokeActive || !micAnalyser) return;
    micAnalyser.getByteFrequencyData(micDataArray);
    let sum = 0;
    for (let i = 0; i < micDataArray.length; i++) sum += micDataArray[i];
    const avg = sum / micDataArray.length;
    const level = Math.min(100, avg * 1.5);
    document.getElementById('karaoke-level').style.width = `${level}%`;
    const status = document.getElementById('karaoke-status');
    if (level > 60) { status.innerText = '🔊 FORTE!'; status.className = 'text-kpop-yellow font-bold'; }
    else if (level > 25) { status.innerText = '🎤 A ouvir...'; status.className = 'text-kpop-mint'; }
    else { status.innerText = 'Aguarda...'; status.className = 'text-slate-400'; }
    if (level > 65 && karaokeActive && !karaokePeakTimeout) {
        karaokePeakTimeout = setTimeout(() => { karaokePeakTimeout = null; }, 600);
        if (currentKaraokeTonicDone === false) { currentKaraokeTonicDone = true; handleKaraokeSuccess(); }
    }
    requestAnimationFrame(monitorMic);
}
function loadKaraokeWord() {
    if (karaokeWordIdx >= karaokeWords.length) {
        const fb = document.getElementById('karaoke-feedback');
        fb.classList.remove('hidden');
        fb.className = 'p-4 rounded-2xl text-center font-bold bg-kpop-yellow/20 border-2 border-kpop-yellow text-kpop-yellow';
        fb.innerHTML = `🎉 Sessão completa! ${karaokeScore}/${karaokeTries}`;
        return;
    }
    const w = karaokeWords[karaokeWordIdx];
    document.getElementById('karaoke-word').innerText = w.word;
    const sylContainer = document.getElementById('karaoke-syllables');
    sylContainer.innerHTML = '';
    w.syllables.forEach((syl, i) => {
        const isTonic = i === w.tonicIdx;
        const chip = document.createElement('div');
        chip.className = `px-4 py-2 rounded-xl font-righteous text-lg ${isTonic?'bg-kpop-yellow/20 border-2 border-kpop-yellow text-kpop-yellow':'bg-black/40 border border-white/20 text-slate-300'}`;
        chip.innerText = syl;
        sylContainer.appendChild(chip);
    });
    currentKaraokeTonicDone = false;
    document.getElementById('karaoke-feedback').classList.add('hidden');
    playTone(440, 'sine', 0.2, 0.15);
}
function handleKaraokeSuccess() {
    karaokeScore++; karaokeTries++;
    document.getElementById('karaoke-score').innerText = karaokeScore;
    document.getElementById('karaoke-tries').innerText = karaokeTries;
    const fb = document.getElementById('karaoke-feedback');
    fb.classList.remove('hidden');
    fb.className = 'p-4 rounded-2xl text-center font-bold bg-kpop-mint/20 border-2 border-kpop-mint text-kpop-mint animate-pop';
    fb.innerHTML = `✨ Excelente! Enfatizaste a sílaba tónica!`;
    playSuccessSound();
    setTimeout(() => { karaokeWordIdx++; loadKaraokeWord(); }, 1500);
}
function nextKaraokeWord() {
    karaokeTries++;
    document.getElementById('karaoke-tries').innerText = karaokeTries;
    karaokeWordIdx++;
    loadKaraokeWord();
}
function stopKaraoke() {
    karaokeActive = false;
    if (micStream) { micStream.getTracks().forEach(t => t.stop()); micStream = null; }
    document.getElementById('karaoke-active').classList.add('hidden');
    document.getElementById('karaoke-permission').classList.remove('hidden');
}
</script>
<script>
/* GAME ENGINE */
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const LOGICAL_W = 800, LOGICAL_H = 420;
const GROUND_Y = 340;
function setupHighDPI() {
    const dpr = window.devicePixelRatio || 1;
    canvas.width = LOGICAL_W * dpr;
    canvas.height = LOGICAL_H * dpr;
    canvas.style.width = '100%';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
}
setupHighDPI();

let isGameRunning = false, gameLoopId = null;
let gameScore = 0, energyLevel = 100, stageTick = 0, shakeAmount = 0;
let maxCombo = 0, comboCount = 0, comboTimer = 0, slowMotionFactor = 1;
let currentWorld = WORLDS[0], worldDifficulty = 1.0;
let bossSpawnX = 9999999, hardcoreMode = progress.hardcore || false;
let lives = 3; const MAX_LIVES = 3;
let lastCheckpoint = { x:100, y:280, cameraX:0, score:0 };
let checkpointMarkers = [];
const CHECKPOINT_INTERVAL = 900;

const POWERUP_TYPES = { SHIELD:'shield', MAGNET:'magnet', DOUBLE_JUMP:'double', SLOW:'slow', X2:'x2' };
let activePowerUps = { shield:0, magnet:0, double:0, slow:0, x2:0 };
let levelPowerUps = [];

const keys = { left:false, right:false, jump:false };
const hero = { x:100, y:280, width:40, height:52, vx:0, vy:0, speed:5.5, jumpForce:-13.5, gravity:0.58,
    isGrounded:false, facing:'right', runFrame:0, invincibleTimer:90, scaleX:1, scaleY:1,
    usedDoubleJump:false, blinkTimer:0, isBlinking:false };

let cameraX = 0;
let levelPlatforms = [], levelBlocks = [], levelEnemies = [], levelStars = [], levelBoss = null;
let bossProjectiles = [];
let bossEffects = [];
let bossActiveTime = 0;
let cameraZoom = 1;
let cameraZoomTarget = 1;
let bossScreenFlash = 0;
let particles = [], floatingTexts = [], crowdLightsticks = [];

function initCrowd() {
    crowdLightsticks = [];
    for (let i = 0; i < 45; i++) {
        crowdLightsticks.push({
            xRel: i*22 + Math.random()*10, y: 370 + Math.random()*30,
            color: [currentWorld.theme.primary, currentWorld.theme.secondary, currentWorld.theme.accent][i%3],
            phase: Math.random()*Math.PI*2, speed: 0.05 + Math.random()*0.05, height: 12 + Math.random()*10
        });
    }
}

const PTYPES = { SPARK:'spark', NOTE:'note', CONFETTI:'confetti', RIPPLE:'ripple' };
function createParticle(x,y,type,opts={}) {
    particles.push({ x, y, vx: opts.vx ?? (Math.random()-0.5)*6, vy: opts.vy ?? -Math.random()*5-1,
        life: opts.life||60, maxLife: opts.life||60, size: opts.size||4, color: opts.color||'#FF007F',
        type, gravity: opts.gravity ?? 0.15, rotation: Math.random()*Math.PI*2,
        rotSpeed: (Math.random()-0.5)*0.3, text: opts.text||null });
}
function spawnSparks(x,y,count,color) { for(let i=0;i<count;i++) createParticle(x,y,PTYPES.SPARK,{color:color||currentWorld.theme.primary}); }
function spawnConfetti(x,y,count=30) {
    const colors = [currentWorld.theme.primary, currentWorld.theme.secondary, currentWorld.theme.accent, '#FF007F', '#FFE600'];
    for(let i=0;i<count;i++) createParticle(x,y,PTYPES.CONFETTI,{color:colors[Math.floor(Math.random()*colors.length)],
        vx:(Math.random()-0.5)*12, vy:-Math.random()*8-2, size:5+Math.random()*5, life:90, gravity:0.25});
}
function spawnMusicNotes(x,y,count=8) {
    const notes = ['♪','♫','♬','♩'];
    for(let i=0;i<count;i++) createParticle(x,y,PTYPES.NOTE,{text:notes[Math.floor(Math.random()*notes.length)],
        color:currentWorld.theme.accent, vx:(Math.random()-0.5)*4, vy:-2-Math.random()*3, size:4, life:70, gravity:-0.05});
}
function spawnShockwave(x,y,color) {
    particles.push({ x, y, vx:0, vy:0, life:30, maxLife:30, size:5, color: color||currentWorld.theme.secondary,
        type: PTYPES.RIPPLE, gravity:0, rotation:0, rotSpeed:0 });
}

function updateLivesUI() {
    const el = document.getElementById('lives-hearts');
    if (!el) return;
    let hearts = '';
    for (let i = 0; i < MAX_LIVES; i++) hearts += i < lives ? '💖' : '🖤';
    el.innerText = hearts;
}
function generateCheckpoints() {
    checkpointMarkers = [];
    for (let x = CHECKPOINT_INTERVAL; x < currentWorld.stageLength; x += CHECKPOINT_INTERVAL) {
        checkpointMarkers.push({ x, triggered:false });
    }
}
function damageHero(amount) {
    if (hero.invincibleTimer > 0 || activePowerUps.shield > 0) return;
    energyLevel = Math.max(0, energyLevel - amount);
    hero.vx = hero.facing === 'right' ? -7 : 7;
    hero.vy = -4; hero.invincibleTimer = 90; shakeAmount = 14;
    spawnSparks(hero.x+20, hero.y+20, 15, currentWorld.theme.primary);
    addFloatingText(`-${amount} ⚡`, hero.x, hero.y-15, currentWorld.theme.primary);
    comboCount = 0; comboTimer = 0; updateComboUI();
    playErrorSound();
    if (energyLevel <= 0) loseLife();
}
function loseLife() {
    if (lives > 1) {
        lives--; updateLivesUI();
        energyLevel = 100; updateGameEnergyUI();
        hero.x = lastCheckpoint.x; hero.y = lastCheckpoint.y;
        hero.vx = 0; hero.vy = 0;
        cameraX = lastCheckpoint.cameraX;
        hero.invincibleTimer = 180; shakeAmount = 20;
        addFloatingText("💔 -1 VIDA", hero.x, hero.y-40, '#FF007F');
        playTone(180,'sawtooth',0.4,0.25);
    } else {
        lives = 0; updateLivesUI();
        triggerGameOver();
    }
}
function resetKpopGame() {
    lives = MAX_LIVES; updateLivesUI();
    lastCheckpoint = { x:100, y:280, cameraX:0, score:0 };
    gameScore = 0; energyLevel = 100; cameraX = 0; shakeAmount = 0;
    comboCount = 0; comboTimer = 0; maxCombo = 0; slowMotionFactor = 1;
    hero.x = 100; hero.y = 280; hero.vx = 0; hero.vy = 0;
    hero.isGrounded = false; hero.invincibleTimer = 90;
    hero.scaleX = 1; hero.scaleY = 1; hero.usedDoubleJump = false;
    levelPlatforms = []; levelBlocks = []; levelEnemies = []; levelStars = [];
    levelPowerUps = []; levelBoss = null;
    bossProjectiles = []; bossEffects = [];
    bossActiveTime = 0; cameraZoom = 1; cameraZoomTarget = 1; bossScreenFlash = 0;
    particles = []; floatingTexts = [];
    activePowerUps = { shield:0, magnet:0, double:0, slow:0, x2:0 };
    levelPlatforms.push({ x:0, y:GROUND_Y, width:650, height:80, type:'stage' });
    maxGeneratedX = 650;
    bossSpawnX = currentWorld.stageLength;
    generateStageChunks(currentWorld.stageLength + 1000);
    generateCheckpoints();
    updateGameEnergyUI(); updateComboUI(); updatePowerUpUI();
    document.getElementById('game-score-display').innerText = '0';
    document.getElementById('boss-bar-container').classList.add('hidden');
}
let maxGeneratedX = 0;
function generateStageChunks(targetX) {
    while (maxGeneratedX < targetX && maxGeneratedX < bossSpawnX) {
        let startX = maxGeneratedX;
        let chunkWidth = 480 + Math.random()*220;
        const gapChance = currentWorld.groundGapChance;
        let gap = Math.random() < gapChance ? 100 : 0;
        if (gap > 0) {
            levelPlatforms.push({ x:startX, y:GROUND_Y, width:chunkWidth*0.45, height:80, type:'stage' });
            levelPlatforms.push({ x:startX+chunkWidth*0.45+gap, y:GROUND_Y, width:chunkWidth*0.55, height:80, type:'stage' });
        } else {
            levelPlatforms.push({ x:startX, y:GROUND_Y, width:chunkWidth, height:80, type:'stage' });
        }
        let platY = GROUND_Y - 95 - Math.floor(Math.random()*2)*48;
        let platW = 130 + Math.random()*110;
        let platX = startX + 70 + Math.random()*110;
        levelPlatforms.push({ x:platX, y:platY, width:platW, height:22, type:'neon' });
        levelBlocks.push({ x:platX+platW/2-18, y:platY-85, width:36, height:36, used:false, bumpY:0, glowPhase:Math.random()*Math.PI });
        if (Math.random() < 0.7) {
            const isFlying = Math.random() < 0.3;
            levelEnemies.push({
                type: isFlying ? 'flyer' : 'ground',
                x: startX + 220, y: isFlying ? GROUND_Y-120 : GROUND_Y-36,
                baseY: isFlying ? GROUND_Y-120 : GROUND_Y-36,
                width:36, height:36, vx: (isFlying?-2:-1.6)*worldDifficulty,
                minX: startX+40, maxX: startX+chunkWidth-40,
                alive:true, squished:false, squishTimer:0,
                wingPhase:0, amplitude:40, phase: Math.random()*Math.PI*2
            });
        }
        for (let k = 0; k < 3; k++) {
            levelStars.push({ x: platX+25+k*35, y: platY-35, radius:12, collected:false, rot: Math.random()*Math.PI });
        }
        maxGeneratedX += chunkWidth + gap;
    }
}

/* ===== BOSS SPAWN (COM ESTADOS E ASSINATURAS) ===== */
function spawnBoss(x) {
    const world = currentWorld;
    levelBoss = {
        x, y: GROUND_Y - 100,
        width: 90, height: 110,
        vx: -world.bossSpeed * 0.5,
        baseX: x, baseY: GROUND_Y - 110,
        hp: world.bossHp, maxHp: world.bossHp,
        alive: true, hitTimer: 0,
        phase: 0, pattern: world.bossPattern,
        minX: x - 220, maxX: x + 220,
        teleportTimer: 0, dashTimer: 0, dashCooldown: 0,
        state: 'idle', stateTimer: 0, attackCooldown: 120, chargeFx: 0,
        shapeType: world.id, morphTime: 0,
        chainsPhase: 0, glitchPhase: 0, flamePhase: 0, ghostPhase: 0
    };
    bossProjectiles = []; bossEffects = [];
    bossActiveTime = 0; cameraZoomTarget = 0.88;
    document.getElementById('boss-bar-container').classList.remove('hidden');
    document.getElementById('boss-hp-text').innerText = `${levelBoss.hp} / ${levelBoss.maxHp}`;
    document.getElementById('boss-hp-fill').style.width = '100%';
    document.getElementById('boss-bar-glow').style.background = `radial-gradient(circle, ${world.theme.bossColor}88, transparent 70%)`;
    spawnShockwave(x+45, GROUND_Y-60, world.theme.bossColor);
    spawnConfetti(x+45, GROUND_Y-60, 40);
    shakeAmount = 25;
    playBossIntroSound(world.id);
    addFloatingText(`⚡ ${world.theme.bossName.toUpperCase()}!`, x-60, 180, world.theme.bossColor);
    pauseGameEngine();
    showBossIntro(() => { startOrResumeGame(); shakeAmount = 15; });
}
function playBossIntroSound(worldId) {
    const riffs = {
        seoul: [110, 110, 165, 220, 165],
        tokyo: [98, 147, 196, 262, 196],
        la:    [82, 123, 165, 247, 165],
        paris: [131, 196, 262, 196, 131],
        final: [147, 220, 294, 220, 147, 110]
    };
    const notes = riffs[worldId] || riffs.seoul;
    notes.forEach((f, i) => { setTimeout(() => playTone(f, 'sawtooth', 0.35, 0.22), i * 130); });
}

function startOrResumeGame() {
    if (isGameRunning) return;
    if (maxGeneratedX === 0) resetKpopGame();
    isGameRunning = true;
    requestAnimationFrame(kpopGameLoop);
}
function pauseGameEngine() {
    isGameRunning = false;
    if (gameLoopId) { cancelAnimationFrame(gameLoopId); gameLoopId = null; }
}
function getComboMultiplier() {
    if (comboCount < 5) return 1;
    if (comboCount < 10) return 1.5;
    if (comboCount < 20) return 2;
    return 3;
}
function incrementCombo() {
    comboCount++; comboTimer = 120;
    if (comboCount > maxCombo) maxCombo = comboCount;
    if (maxCombo > (achievementsState.stats.maxCombo||0)) { achievementsState.stats.maxCombo = maxCombo; saveAchievements(); }
    updateComboUI(); checkAchievements();
}
function updateComboUI() {
    const d = document.getElementById('combo-display');
    if (comboCount >= 3) { d.classList.remove('hidden'); document.getElementById('game-combo-num').innerText = `x${comboCount}`; }
    else d.classList.add('hidden');
}

function updateStagePhysics() {
    const dtM = slowMotionFactor;
    if (hero.invincibleTimer > 0) hero.invincibleTimer--;
    if (shakeAmount > 0) shakeAmount *= 0.9;
    if (comboTimer > 0) comboTimer--; else if (comboCount > 0) { comboCount = 0; updateComboUI(); }
    hero.scaleX += (1-hero.scaleX)*0.15;
    hero.scaleY += (1-hero.scaleY)*0.15;
    hero.blinkTimer++;
    if (hero.blinkTimer > 180) { hero.isBlinking = true; if (hero.blinkTimer > 195) { hero.blinkTimer = 0; hero.isBlinking = false; } }
    Object.keys(activePowerUps).forEach(k => { if (activePowerUps[k] > 0) activePowerUps[k]--; });
    slowMotionFactor = activePowerUps.slow > 0 ? 0.55 : 1;
    updatePowerUpUI();
    energyLevel -= currentWorld.energyDrain * worldDifficulty;
    if (energyLevel <= 0) { energyLevel = 0; updateGameEnergyUI(); loseLife(); return; }
    updateGameEnergyUI();

    checkpointMarkers.forEach(cp => {
        if (!cp.triggered && hero.x > cp.x) {
            cp.triggered = true;
            lastCheckpoint = { x: hero.x, y: hero.y, cameraX, score: gameScore };
            addFloatingText("✓ CHECKPOINT", hero.x-30, hero.y-50, '#00FFAB');
            playTone(880, 'sine', 0.3);
            spawnShockwave(hero.x+20, hero.y+20, '#00FFAB');
        }
    });

    if (keys.left) { hero.vx -= 0.8; hero.facing = 'left'; }
    else if (keys.right) { hero.vx += 0.8; hero.facing = 'right'; }
    else hero.vx *= 0.78;
    hero.vx = Math.max(-hero.speed, Math.min(hero.speed, hero.vx));

    if (keys.jump && hero.isGrounded) {
        hero.vy = hero.jumpForce; hero.isGrounded = false; hero.usedDoubleJump = false;
        hero.scaleX = 0.7; hero.scaleY = 1.35;
        spawnSparks(hero.x+20, hero.y+hero.height, 8, currentWorld.theme.secondary);
        spawnShockwave(hero.x+20, hero.y+hero.height);
        playTone(580, 'sine', 0.1);
    } else if (keys.jump && !hero.isGrounded && activePowerUps.double > 0 && !hero.usedDoubleJump) {
        hero.vy = hero.jumpForce * 0.85; hero.usedDoubleJump = true;
        spawnShockwave(hero.x+20, hero.y+hero.height, currentWorld.theme.accent);
        playTone(750, 'triangle', 0.15);
    }

    hero.vy += hero.gravity * dtM;
    hero.x += hero.vx * dtM;
    hero.y += hero.vy * dtM;

    if (Math.abs(hero.vx) > 1.5 && hero.isGrounded && stageTick % 6 === 0) {
        spawnSparks(hero.x + (hero.facing==='right'?5:hero.width-5), hero.y+hero.height, 1, currentWorld.theme.primary);
    }
    if (hero.x + 800 > maxGeneratedX && maxGeneratedX < bossSpawnX) generateStageChunks(hero.x + 1600);
    if (maxGeneratedX >= bossSpawnX && !levelBoss && hero.x > bossSpawnX - 500) spawnBoss(bossSpawnX + 200);

    let wasGrounded = hero.isGrounded; hero.isGrounded = false;
    levelPlatforms.forEach(plat => {
        if (hero.vy >= 0 && hero.x+hero.width-8 > plat.x && hero.x+8 < plat.x+plat.width &&
            hero.y+hero.height >= plat.y && hero.y+hero.height-hero.vy <= plat.y+16) {
            hero.y = plat.y - hero.height; hero.vy = 0; hero.isGrounded = true;
            if (!wasGrounded) { hero.scaleX = 1.3; hero.scaleY = 0.75; spawnSparks(hero.x+20, hero.y+hero.height, 6, currentWorld.theme.accent); }
        }
    });
    levelBlocks.forEach(block => {
        if (block.bumpY < 0) block.bumpY += 1.5;
        if (hero.vy >= 0 && hero.x+hero.width-8 > block.x && hero.x+8 < block.x+block.width &&
            hero.y+hero.height >= block.y && hero.y+hero.height-hero.vy <= block.y+16) {
            hero.y = block.y - hero.height; hero.vy = 0; hero.isGrounded = true;
        }
        if (hero.vy < 0 && hero.x+hero.width-8 > block.x && hero.x+8 < block.x+block.width &&
            hero.y <= block.y+block.height && hero.y-hero.vy >= block.y+block.height-16) {
            hero.y = block.y + block.height; hero.vy = 2;
            if (!block.used) {
                block.used = true; block.bumpY = -14;
                gameScore += 30; shakeAmount = 6;
                spawnConfetti(block.x+18, block.y+18, 25);
                addFloatingText("+30 ⭐", block.x-10, block.y-20, currentWorld.theme.accent);
                playTone(800, 'triangle', 0.22);
                if (Math.random() < 0.5) spawnPowerUp(block.x+2, block.y-10);
            }
        }
    });
    if (hero.y > 480) {
        hero.x = lastCheckpoint.x; hero.y = lastCheckpoint.y;
        hero.vx = 0; hero.vy = 0; cameraX = lastCheckpoint.cameraX;
        hero.invincibleTimer = 90;
        energyLevel = Math.max(0, energyLevel - 20); updateGameEnergyUI();
        if (energyLevel <= 0) loseLife();
        comboCount = 0; comboTimer = 0; updateComboUI();
    }
    levelEnemies.forEach(enemy => {
        if (!enemy.alive) return;
        enemy.wingPhase += 0.2 * dtM;
        if (enemy.squished) { enemy.squishTimer++; if (enemy.squishTimer > 30) enemy.alive = false; return; }
        enemy.x += enemy.vx * dtM;
        if (enemy.x < enemy.minX || enemy.x > enemy.maxX) enemy.vx *= -1;
        if (enemy.type === 'flyer') { enemy.phase += 0.05*dtM; enemy.y = enemy.baseY + Math.sin(enemy.phase)*enemy.amplitude; }
        if (hero.x+6 < enemy.x+enemy.width && hero.x+hero.width-6 > enemy.x &&
            hero.y+hero.height > enemy.y && hero.y < enemy.y+enemy.height) {
            if (hero.vy > 0 && hero.y+hero.height <= enemy.y+18) {
                enemy.squished = true; hero.vy = -10.5;
                const points = Math.floor(50 * getComboMultiplier());
                gameScore += points; shakeAmount = 8;
                spawnSparks(enemy.x+18, enemy.y+18, 20, currentWorld.theme.secondary);
                spawnMusicNotes(enemy.x+18, enemy.y, 5);
                addFloatingText(`+${points} 💥`, enemy.x-20, enemy.y-15, currentWorld.theme.secondary);
                playTone(950, 'square', 0.18);
                incrementCombo();
            } else { damageHero(25); }
        }
    });
    if (levelBoss && levelBoss.alive) updateBoss(dtM);
    levelStars.forEach(star => {
        if (star.collected) return;
        star.rot += 0.05;
        if (activePowerUps.magnet > 0) {
            const dx = hero.x+20-star.x, dy = hero.y+26-star.y;
            const dist = Math.sqrt(dx*dx+dy*dy);
            if (dist < 200 && dist > 1) { star.x += dx/dist*5; star.y += dy/dist*5; }
        }
        const dx = (hero.x+hero.width/2)-star.x, dy = (hero.y+hero.height/2)-star.y;
        if (Math.sqrt(dx*dx+dy*dy) < hero.width/2 + star.radius + 4) {
            star.collected = true;
            const points = Math.floor(20 * getComboMultiplier());
            gameScore += points;
            spawnSparks(star.x, star.y, 10, currentWorld.theme.accent);
            addFloatingText(`+${points} 🎵`, star.x, star.y-10, currentWorld.theme.accent);
            incrementCombo();
        }
    });
    levelPowerUps.forEach(pu => {
        if (pu.collected) return;
        pu.bobPhase += 0.1; pu.vy += 0.25*dtM; pu.y += pu.vy*dtM;
        levelPlatforms.forEach(plat => {
            if (pu.x > plat.x && pu.x < plat.x+plat.width && pu.y+16 > plat.y && pu.y+16 < plat.y+plat.height+10) {
                pu.y = plat.y-16; pu.vy = 0;
            }
        });
        if (Math.abs(pu.x - (hero.x+20)) < 30 && Math.abs(pu.y - (hero.y+26)) < 34) {
            pu.collected = true; applyPowerUp(pu.type);
        }
    });
    for (let i = particles.length-1; i >= 0; i--) {
        const p = particles[i];
        p.x += p.vx*dtM; p.y += p.vy*dtM; p.vy += p.gravity*dtM; p.vx *= 0.98;
        p.rotation += p.rotSpeed; p.life--;
        if (p.life <= 0) particles.splice(i, 1);
    }
    for (let i = floatingTexts.length-1; i >= 0; i--) {
        const ft = floatingTexts[i]; ft.y -= 1; ft.alpha -= 0.015;
        if (ft.alpha <= 0) floatingTexts.splice(i, 1);
    }
    if (Math.abs(hero.vx) > 0.3 && hero.isGrounded) hero.runFrame += 0.28;
    const camTarget = hero.x + hero.vx*15 - 220;
    cameraX += (camTarget - cameraX) * 0.08;
    cameraX = Math.max(0, cameraX);
    gameScore += 0.025;
    document.getElementById('game-score-display').innerText = Math.floor(gameScore);
}

function updateBoss(dtM) {
    const boss = levelBoss;
    if (!boss || !boss.alive) return;
    bossActiveTime++;
    if (boss.hitTimer > 0) boss.hitTimer--;
    boss.chainsPhase += 0.03 * dtM;
    boss.glitchPhase += 0.15 * dtM;
    boss.flamePhase += 0.12 * dtM;
    boss.ghostPhase += 0.05 * dtM;
    boss.morphTime += dtM;

    if (boss.state === 'idle' || boss.state === 'enraged') {
        boss.attackCooldown -= dtM;
        if (boss.attackCooldown <= 0) { boss.state = 'charging'; boss.stateTimer = 48; boss.chargeFx = 0; playTone(200, 'sine', 0.3, 0.15); }
    } else if (boss.state === 'charging') {
        boss.chargeFx += 0.05 * dtM;
        boss.stateTimer -= dtM;
        boss.x += Math.sin(boss.chargeFx * 20) * 0.5;
        if (boss.stateTimer <= 0) { boss.state = 'attacking'; boss.stateTimer = 55; executeBossAttack(boss); }
    } else if (boss.state === 'attacking') {
        boss.stateTimer -= dtM;
        if (boss.stateTimer <= 0) { boss.state = 'idle'; boss.attackCooldown = boss.hp <= boss.maxHp * 0.34 ? 60 : 110; }
    } else if (boss.state === 'hurt') {
        boss.stateTimer -= dtM;
        if (boss.stateTimer <= 0) boss.state = 'idle';
    }

    if (boss.hp <= boss.maxHp * 0.34 && boss.hp > 0 && boss.state !== 'enraged' && boss.hp < boss.maxHp) {
        boss.state = 'enraged'; boss.stateTimer = 60;
        bossScreenFlash = 1; shakeAmount = 22;
        spawnShockwave(boss.x + boss.width/2, boss.y + boss.height/2, '#FF2A85');
        spawnShockwave(boss.x + boss.width/2, boss.y + boss.height/2, '#FFE600');
        for (let i = 0; i < 40; i++) {
            createParticle(boss.x + boss.width/2, boss.y + boss.height/2, PTYPES.SPARK, {
                color: i % 2 ? '#FF2A85' : '#FFE600',
                vx: (Math.random() - 0.5) * 12, vy: (Math.random() - 0.5) * 12,
                life: 70, size: 5
            });
        }
        addFloatingText("⚡ ENRAGED!", boss.x, boss.y - 30, '#FF2A85');
        playTone(80, 'sawtooth', 0.6, 0.4);
    }

    boss.phase += 0.05 * dtM;
    const enraged = boss.state === 'enraged' || boss.hp <= boss.maxHp * 0.34;
    const speedMult = enraged ? 1.4 : 1.0;

    switch (boss.pattern) {
        case 'vertical':
            boss.y = boss.baseY + Math.sin(boss.phase) * 28;
            boss.x += boss.vx * dtM * speedMult;
            if (boss.x < boss.minX || boss.x > boss.maxX) boss.vx *= -1;
            break;
        case 'circular':
            boss.x = boss.baseX + Math.cos(boss.phase * 0.8) * 130;
            boss.y = boss.baseY + Math.sin(boss.phase * 1.2) * 45;
            break;
        case 'dash':
            boss.dashCooldown = (boss.dashCooldown || 0) - dtM;
            if (boss.state === 'attacking' && boss.dashTimer <= 0 && boss.dashCooldown <= 0) {
                boss.dashTimer = 30; boss.dashCooldown = 140;
                const dir = hero.x < boss.x ? -1 : 1;
                boss.vx = dir * 9;
                playTone(400, 'sawtooth', 0.3, 0.2);
            }
            if (boss.dashTimer > 0) {
                boss.dashTimer -= dtM;
                boss.x += boss.vx * dtM;
                createParticle(boss.x + boss.width/2, boss.y + boss.height/2, PTYPES.SPARK, {
                    color: '#FF6B00', vx: (Math.random()-0.5)*2, vy: (Math.random()-0.5)*2, life: 25
                });
            } else {
                boss.x += boss.vx * 0.25 * dtM;
                boss.vx *= 0.94;
                boss.y = boss.baseY + Math.sin(boss.phase * 2) * 18;
            }
            boss.x = Math.max(boss.minX, Math.min(boss.maxX, boss.x));
            break;
        case 'teleport':
            boss.teleportTimer = (boss.teleportTimer || 0) - dtM;
            if (boss.teleportTimer <= 0 && boss.state !== 'charging') {
                boss.teleportTimer = enraged ? 60 : 110;
                spawnShockwave(boss.x + boss.width/2, boss.y + boss.height/2, '#FFD700');
                spawnConfetti(boss.x + boss.width/2, boss.y + boss.height/2, 15);
                boss.x = boss.baseX + (Math.random() - 0.5) * 280;
                boss.y = boss.baseY + (Math.random() - 0.5) * 70;
                spawnShockwave(boss.x + boss.width/2, boss.y + boss.height/2, '#4169E1');
                playTone(700, 'sine', 0.15, 0.15);
            }
            boss.x += Math.sin(boss.phase * 0.6) * 1.5 * dtM;
            break;
        case 'chaos':
            boss.x = boss.baseX + Math.sin(boss.phase * 1.3) * 160;
            boss.y = boss.baseY + Math.cos(boss.phase * 1.1) * 65;
            if (Math.random() < 0.015) spawnShockwave(boss.x + boss.width/2, boss.y + boss.height/2, '#FF2A85');
            break;
    }
    boss.x = Math.max(boss.minX, Math.min(boss.maxX, boss.x));

    const hb = { x: hero.x + 6, y: hero.y, w: hero.width - 12, h: hero.height };
    const bb = { x: boss.x, y: boss.y, w: boss.width, h: boss.height };
    if (hb.x < bb.x + bb.w && hb.x + hb.w > bb.x && hb.y < bb.y + bb.h && hb.y + hb.h > bb.y) {
        if (hero.vy > 0 && hero.y + hero.height <= boss.y + 35 && boss.hitTimer <= 0) {
            boss.hp--;
            boss.hitTimer = 45;
            boss.state = 'hurt'; boss.stateTimer = 25;
            hero.vy = -12;
            shakeAmount = 18; bossScreenFlash = 0.6;
            spawnConfetti(boss.x + boss.width/2, boss.y + boss.height/2, 30);
            spawnShockwave(boss.x + boss.width/2, boss.y + boss.height/2, '#FFE600');
            spawnMusicNotes(boss.x + boss.width/2, boss.y + 30, 8);
            document.getElementById('boss-hp-text').innerText = `${boss.hp} / ${boss.maxHp}`;
            document.getElementById('boss-hp-fill').style.width = `${(boss.hp/boss.maxHp)*100}%`;
            playTone(950, 'square', 0.2, 0.22);
            if (boss.hp <= 0) {
                boss.alive = false;
                gameScore += 500 * currentWorld.difficulty;
                cameraZoomTarget = 1.05;
                spawnConfetti(boss.x + boss.width/2, boss.y + boss.height/2, 80);
                spawnMusicNotes(boss.x + boss.width/2, boss.y + 30, 20);
                for (let i = 0; i < 5; i++) {
                    setTimeout(() => {
                        spawnShockwave(boss.x + boss.width/2 + (Math.random()-0.5)*100, boss.y + boss.height/2 + (Math.random()-0.5)*100, currentWorld.theme.accent);
                    }, i * 120);
                }
                addFloatingText(`BOSS DOWN! 👑`, boss.x - 60, boss.y - 20, currentWorld.theme.accent);
                playSuccessSound();
                document.getElementById('boss-bar-container').classList.add('hidden');
                setTimeout(() => { cameraZoomTarget = 1; triggerVictory(); }, 900);
            } else {
                addFloatingText(`HP: ${boss.hp}/${boss.maxHp}`, boss.x, boss.y - 20, currentWorld.theme.primary);
            }
        } else {
            damageHero(35);
        }
    }

    for (let i = bossProjectiles.length - 1; i >= 0; i--) {
        const p = bossProjectiles[i];
        p.x += p.vx * dtM; p.y += p.vy * dtM; p.vy += 0.08 * dtM;
        p.life -= dtM;
        const dx = (hero.x + 20) - p.x, dy = (hero.y + 26) - p.y;
        if (Math.sqrt(dx*dx + dy*dy) < p.radius + 18) {
            damageHero(15);
            spawnSparks(p.x, p.y, 15, p.color);
            bossProjectiles.splice(i, 1);
            continue;
        }
        let hit = false;
        levelPlatforms.forEach(plat => {
            if (p.x > plat.x && p.x < plat.x + plat.width && p.y > plat.y && p.y < plat.y + 10) hit = true;
        });
        if (hit) { spawnSparks(p.x, p.y, 10, p.color); bossProjectiles.splice(i, 1); continue; }
        if (p.life <= 0 || p.y > 500 || p.x < cameraX - 200 || p.x > cameraX + 1200) bossProjectiles.splice(i, 1);
    }
    for (let i = bossEffects.length - 1; i >= 0; i--) {
        const e = bossEffects[i];
        e.life -= dtM; e.timer += dtM;
        if (e.life <= 0) bossEffects.splice(i, 1);
    }
    if (bossScreenFlash > 0) bossScreenFlash *= 0.92;
    if (bossActiveTime < 90) cameraZoomTarget = 0.88;
    else if (bossActiveTime > 200) cameraZoomTarget = 1;
    cameraZoom += (cameraZoomTarget - cameraZoom) * 0.06;
}

function executeBossAttack(boss) {
    const cx = boss.x + boss.width/2;
    const cy = boss.y + boss.height/2;
    const color = currentWorld.theme.bossColor;
    switch (boss.pattern) {
        case 'vertical':
            for (let i = -1; i <= 1; i++) {
                bossProjectiles.push({ x: cx + i * 30, y: boss.y + boss.height,
                    vx: i * 1.5, vy: 5, life: 90, radius: 9, color, rot: 0 });
            }
            shakeAmount = 15;
            bossEffects.push({ type: 'ring', x: cx, y: GROUND_Y, life: 40, timer: 0, color, maxLife: 40 });
            playTone(150, 'square', 0.35, 0.28);
            break;
        case 'circular':
            for (let i = 0; i < 8; i++) {
                const angle = (i / 8) * Math.PI * 2;
                bossProjectiles.push({ x: cx, y: cy, vx: Math.cos(angle)*4, vy: Math.sin(angle)*4,
                    life: 120, radius: 8, color, rot: 0 });
            }
            spawnShockwave(cx, cy, color);
            playTone(550, 'triangle', 0.3, 0.22);
            break;
        case 'dash':
            for (let i = 0; i < 5; i++) {
                setTimeout(() => {
                    bossProjectiles.push({ x: cx, y: cy,
                        vx: -4 - Math.random()*2, vy: (Math.random()-0.5)*4,
                        life: 80, radius: 7, color, rot: 0 });
                }, i * 80);
            }
            playTone(400, 'sawtooth', 0.35, 0.25);
            break;
        case 'teleport':
            const baseAngle = Math.atan2(hero.y + 26 - cy, hero.x + 20 - cx);
            for (let i = -2; i <= 2; i++) {
                const angle = baseAngle + i * 0.18;
                bossProjectiles.push({ x: cx, y: cy, vx: Math.cos(angle)*5, vy: Math.sin(angle)*5,
                    life: 140, radius: 8, color, rot: 0 });
            }
            spawnShockwave(cx, cy, color);
            playTone(700, 'square', 0.25, 0.22);
            break;
        case 'chaos':
            for (let i = 0; i < 12; i++) {
                const angle = (i / 12) * Math.PI * 2 + Math.random() * 0.3;
                bossProjectiles.push({ x: cx, y: cy,
                    vx: Math.cos(angle) * (3 + Math.random() * 3),
                    vy: Math.sin(angle) * (3 + Math.random() * 3),
                    life: 150, radius: 9, color, rot: 0 });
            }
            spawnShockwave(cx, cy, color);
            spawnShockwave(cx, cy, '#FFE600');
            shakeAmount = 12;
            playTone(90, 'sawtooth', 0.4, 0.3);
            break;
    }
}

function applyPowerUp(type) {
    activePowerUps[type] = 300;
    const labels = { shield:'🛡️ ESCUDO!', magnet:'🧲 ÍMAN!', double:'🦘 DUPLO!', slow:'⏱️ SLOW-MO!', x2:'⭐ x2!' };
    const colors = { shield:'#00F2FE', magnet:'#FF007F', double:'#00FFAB', slow:'#7928CA', x2:'#FFE600' };
    addFloatingText(labels[type], hero.x-20, hero.y-40, colors[type]);
    spawnShockwave(hero.x+20, hero.y+20, colors[type]);
    spawnConfetti(hero.x+20, hero.y+20, 15);
    playSuccessSound();
}
function updatePowerUpUI() {
    const map = { shield:'pwr-shield', magnet:'pwr-magnet', double:'pwr-double', slow:'pwr-slow', x2:'pwr-x2' };
    Object.entries(map).forEach(([k,id]) => {
        const el = document.getElementById(id);
        if (activePowerUps[k] > 0) { el.classList.remove('hidden'); el.querySelector('.pwr-timer').innerText = `${Math.ceil(activePowerUps[k]/60)}s`; }
        else el.classList.add('hidden');
    });
}
function spawnPowerUp(x,y) {
    const types = Object.values(POWERUP_TYPES);
    levelPowerUps.push({ x, y, type: types[Math.floor(Math.random()*types.length)], vy:-5, bobPhase:0, collected:false });
}
function addFloatingText(text,x,y,color) { floatingTexts.push({ text, x, y, color, alpha:1 }); }
function updateGameEnergyUI() {
    document.getElementById('game-energy-fill').style.width = `${energyLevel}%`;
    document.getElementById('game-energy-num').innerText = `${Math.round(energyLevel)}%`;
}

/* ===== RENDER ===== */
function renderStageScene() {
    ctx.clearRect(0, 0, LOGICAL_W, LOGICAL_H);
    const zoomToUse = levelBoss && levelBoss.alive ? cameraZoom : 1;
    ctx.save();
    if (zoomToUse !== 1) {
        ctx.translate(LOGICAL_W/2, LOGICAL_H/2);
        ctx.scale(zoomToUse, zoomToUse);
        ctx.translate(-LOGICAL_W/2, -LOGICAL_H/2);
    }
    renderParallax();
    ctx.save();
    if (shakeAmount > 0.5) ctx.translate((Math.random()-0.5)*shakeAmount, (Math.random()-0.5)*shakeAmount);
    ctx.translate(-cameraX, 0);
    renderPlatforms();
    renderCheckpoints();
    renderCrowdLayer();
    renderBlocks();
    renderEnemies();
    renderBoss();
    renderBossProjectiles();
    renderBossEffects();
    renderStars();
    renderPowerUps();
    renderHero();
    renderParticles();
    renderFloatingTexts();
    ctx.restore();
    renderBloomOverlay();
    renderVignette();
    ctx.restore();
    if (bossScreenFlash > 0.01) {
        ctx.save();
        ctx.fillStyle = `rgba(255, 255, 255, ${bossScreenFlash * 0.4})`;
        ctx.fillRect(0, 0, LOGICAL_W, LOGICAL_H);
        ctx.restore();
    }
}

function renderParallax() {
    const t = currentWorld.theme;
    const bgGrad = ctx.createLinearGradient(0, 0, 0, LOGICAL_H);
    bgGrad.addColorStop(0, t.bg1); bgGrad.addColorStop(0.5, t.bg2); bgGrad.addColorStop(1, t.bg3);
    ctx.fillStyle = bgGrad;
    ctx.fillRect(0, 0, LOGICAL_W, LOGICAL_H);
    ctx.save();
    ctx.globalAlpha = 0.7;
    for (let i = 0; i < 50; i++) {
        const seed = i*137.5;
        const sx = ((seed*7 - cameraX*0.1) % (LOGICAL_W+100) + LOGICAL_W+100) % (LOGICAL_W+100) - 50;
        const sy = (seed*13) % 250;
        const twinkle = 0.5 + Math.sin(stageTick*0.05 + i)*0.5;
        ctx.fillStyle = `rgba(255,255,255,${0.3 + twinkle*0.5})`;
        ctx.beginPath(); ctx.arc(sx, sy, 1 + twinkle*0.8, 0, Math.PI*2); ctx.fill();
    }
    ctx.restore();
    ctx.save();
    const skyOffset = -(cameraX*0.25) % 200;
    for (let i = 0; i < 8; i++) {
        const bx = skyOffset + i*200;
        const bh = 80 + (i*37) % 70;
        ctx.fillStyle = t.skyline;
        ctx.fillRect(bx, GROUND_Y-bh, 70, bh);
        for (let wy = 0; wy < 3; wy++) for (let wx = 0; wx < 3; wx++) {
            if ((i + wx + wy) % 3 === 0) {
                ctx.fillStyle = i%2===0 ? t.primary+'40' : t.secondary+'40';
                ctx.fillRect(bx+12+wx*18, GROUND_Y-bh+15+wy*22, 8, 10);
            }
        }
    }
    ctx.restore();
    ctx.save();
    ctx.globalCompositeOperation = 'lighter';
    const beamOffset = -(cameraX*0.4) % 500;
    for (let i = 0; i < 5; i++) {
        const bx = beamOffset + i*500;
        const beamAngle = Math.sin(stageTick*0.02 + i)*0.3;
        ctx.save();
        ctx.translate(bx, 0); ctx.rotate(beamAngle);
        const grad = ctx.createLinearGradient(0, 0, 0, 350);
        grad.addColorStop(0, (i%2===0 ? t.primary : t.secondary) + '26');
        grad.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = grad;
        ctx.beginPath(); ctx.moveTo(-40,0); ctx.lineTo(40,0); ctx.lineTo(150,350); ctx.lineTo(-150,350); ctx.fill();
        ctx.restore();
    }
    ctx.restore();
}
function renderPlatforms() {
    const t = currentWorld.theme;
    levelPlatforms.forEach(plat => {
        if (plat.type === 'stage') {
            const grad = ctx.createLinearGradient(plat.x, plat.y, plat.x, plat.y+plat.height);
            grad.addColorStop(0, '#2d1b4d'); grad.addColorStop(0.3, '#1a1030'); grad.addColorStop(1, '#0d0718');
            ctx.fillStyle = grad;
            ctx.fillRect(plat.x, plat.y, plat.width, plat.height);
            const stripGrad = ctx.createLinearGradient(plat.x, plat.y, plat.x+plat.width, plat.y);
            stripGrad.addColorStop(0, t.primary); stripGrad.addColorStop(0.5, t.secondary); stripGrad.addColorStop(1, t.accent);
            ctx.fillStyle = stripGrad;
            ctx.fillRect(plat.x, plat.y, plat.width, 5);
        } else {
            ctx.fillStyle = '#17122e';
            ctx.beginPath(); ctx.roundRect(plat.x, plat.y, plat.width, plat.height, [8]); ctx.fill();
            ctx.strokeStyle = t.secondary; ctx.lineWidth = 2.5;
            ctx.shadowColor = t.secondary; ctx.shadowBlur = 8;
            ctx.strokeRect(plat.x, plat.y, plat.width, plat.height);
            ctx.shadowBlur = 0;
        }
    });
}
function renderCheckpoints() {
    checkpointMarkers.forEach(cp => {
        const glow = cp.triggered ? 0.3 : (0.6 + Math.sin(stageTick*0.08)*0.3);
        ctx.save();
        ctx.globalCompositeOperation = 'lighter';
        const grad = ctx.createLinearGradient(cp.x, 0, cp.x, GROUND_Y);
        const color = cp.triggered ? '#00FFAB33' : `rgba(0,255,171,${glow*0.35})`;
        grad.addColorStop(0, 'rgba(0,0,0,0)');
        grad.addColorStop(0.5, color);
        grad.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = grad;
        ctx.fillRect(cp.x-3, 0, 6, GROUND_Y);
        ctx.fillStyle = cp.triggered ? '#00FFAB66' : '#00FFAB';
        ctx.shadowColor = '#00FFAB'; ctx.shadowBlur = cp.triggered ? 4 : 12;
        ctx.beginPath(); ctx.arc(cp.x, GROUND_Y-8, 6, 0, Math.PI*2); ctx.fill();
        ctx.restore();
    });
}
function renderCrowdLayer() {
    const t = currentWorld.theme;
    ctx.save();
    ctx.fillStyle = t.crowd;
    ctx.beginPath(); ctx.ellipse(400 + cameraX*0.5, 430, 700, 80, 0, 0, Math.PI*2); ctx.fill();
    ctx.restore();
    ctx.save();
    const lsOffset = (cameraX*0.4) % 400;
    crowdLightsticks.forEach(ls => {
        const drawX = ls.xRel - lsOffset + 800*Math.floor((cameraX*0.4 - ls.xRel)/800 + 1);
        const waveY = Math.sin(stageTick*ls.speed + ls.phase)*8;
        ctx.fillStyle = t.crowd;
        ctx.beginPath(); ctx.arc(drawX, ls.y + waveY, 7, 0, Math.PI*2); ctx.fill();
        ctx.save();
        ctx.globalCompositeOperation = 'lighter';
        ctx.strokeStyle = ls.color; ctx.lineWidth = 3.5;
        ctx.shadowColor = ls.color; ctx.shadowBlur = 10;
        ctx.beginPath(); ctx.moveTo(drawX, ls.y + waveY);
        ctx.lineTo(drawX + Math.sin(stageTick*ls.speed)*6, ls.y + waveY - ls.height);
        ctx.stroke();
        ctx.restore();
    });
    ctx.restore();
}
function renderBlocks() {
    levelBlocks.forEach(block => {
        const rY = block.y + block.bumpY;
        const floatOffset = Math.sin(stageTick*0.08 + block.glowPhase)*3;
        const finalY = rY + (block.used ? 0 : floatOffset);
        if (!block.used) {
            const t = currentWorld.theme;
            const blockGrad = ctx.createLinearGradient(block.x, finalY, block.x+block.width, finalY+block.height);
            blockGrad.addColorStop(0, t.primary); blockGrad.addColorStop(1, t.secondary);
            ctx.fillStyle = blockGrad;
            ctx.beginPath(); ctx.roundRect(block.x, finalY, block.width, block.height, [10]); ctx.fill();
            ctx.strokeStyle = t.accent; ctx.lineWidth = 2.5;
            ctx.shadowColor = t.accent; ctx.shadowBlur = 12 + Math.sin(stageTick*0.1)*4;
            ctx.strokeRect(block.x+2, finalY+2, block.width-4, block.height-4);
            ctx.shadowBlur = 0;
            ctx.fillStyle = '#FFFFFF';
            ctx.font = '900 22px Fredoka, sans-serif';
            ctx.fillText('?', block.x+12, finalY+26);
        } else {
            ctx.fillStyle = '#261e40';
            ctx.beginPath(); ctx.roundRect(block.x, finalY, block.width, block.height, [8]); ctx.fill();
        }
    });
}
function renderEnemies() {
    levelEnemies.forEach(enemy => {
        if (!enemy.alive) return;
        if (enemy.squished) {
            ctx.fillStyle = currentWorld.theme.primary;
            ctx.beginPath(); ctx.ellipse(enemy.x+18, enemy.y+30, 20, 6, 0, 0, Math.PI*2); ctx.fill();
        } else {
            const floatY = Math.sin(enemy.wingPhase)*4;
            const eY = enemy.y + floatY;
            ctx.fillStyle = enemy.type === 'flyer' ? currentWorld.theme.secondary : currentWorld.theme.primary;
            const wf = Math.sin(enemy.wingPhase)*12;
            ctx.beginPath(); ctx.moveTo(enemy.x+6, eY+12); ctx.lineTo(enemy.x-14, eY+wf); ctx.lineTo(enemy.x+2, eY+24); ctx.fill();
            ctx.beginPath(); ctx.moveTo(enemy.x+30, eY+12); ctx.lineTo(enemy.x+50, eY+wf); ctx.lineTo(enemy.x+34, eY+24); ctx.fill();
            const eg = ctx.createRadialGradient(enemy.x+18, eY+18, 4, enemy.x+18, eY+18, 18);
            eg.addColorStop(0, enemy.type==='flyer'?'#7209b7':'#5a189a');
            eg.addColorStop(1, '#10002b');
            ctx.fillStyle = eg;
            ctx.beginPath(); ctx.arc(enemy.x+18, eY+18, 18, 0, Math.PI*2); ctx.fill();
            ctx.fillStyle = '#FF2A85'; ctx.shadowColor = '#FF007F'; ctx.shadowBlur = 8;
            ctx.beginPath(); ctx.arc(enemy.x+11, eY+14, 4, 0, Math.PI*2); ctx.fill();
            ctx.beginPath(); ctx.arc(enemy.x+25, eY+14, 4, 0, Math.PI*2); ctx.fill();
            ctx.shadowBlur = 0;
            ctx.fillStyle = '#FFFFFF';
            ctx.fillRect(enemy.x+12, eY+13, 2, 2); ctx.fillRect(enemy.x+26, eY+13, 2, 2);
        }
    });
}

/* ===== BOSS RENDER ===== */
const BOSS_SHAPES = {
    seoul: (c, x, y, w, h) => {
        c.beginPath();
        c.moveTo(x + w*0.5, y - 8);
        c.lineTo(x + w*0.72, y + h*0.18);
        c.quadraticCurveTo(x + w*1.05, y + h*0.35, x + w*1.0, y + h*0.65);
        c.quadraticCurveTo(x + w*1.0, y + h*1.05, x + w*0.5, y + h);
        c.quadraticCurveTo(x, y + h*1.05, x, y + h*0.65);
        c.quadraticCurveTo(x - w*0.05, y + h*0.35, x + w*0.28, y + h*0.18);
        c.closePath();
    },
    tokyo: (c, x, y, w, h) => {
        c.beginPath();
        c.moveTo(x + w*0.5, y - 5);
        c.lineTo(x + w*1.02, y + h*0.35);
        c.lineTo(x + w*0.78, y + h);
        c.lineTo(x + w*0.22, y + h);
        c.lineTo(x - w*0.02, y + h*0.35);
        c.closePath();
    },
    la: (c, x, y, w, h) => {
        c.beginPath();
        const cx = x + w/2, cy = y + h/2;
        for (let i = 0; i < 14; i++) {
            const angle = (i / 14) * Math.PI * 2 - Math.PI/2;
            const r = (i % 2 === 0) ? w*0.55 : w*0.35;
            const px = cx + Math.cos(angle) * r;
            const py = cy + Math.sin(angle) * r * (h/w);
            if (i === 0) c.moveTo(px, py);
            else c.lineTo(px, py);
        }
        c.closePath();
    },
    paris: (c, x, y, w, h) => {
        c.beginPath();
        c.moveTo(x + w*0.5, y - 5);
        c.lineTo(x + w*0.68, y + h*0.12);
        c.lineTo(x + w*0.88, y + h*0.7);
        c.lineTo(x + w, y + h);
        c.lineTo(x, y + h);
        c.lineTo(x + w*0.12, y + h*0.7);
        c.lineTo(x + w*0.32, y + h*0.12);
        c.closePath();
    },
    final: (c, x, y, w, h) => {
        const cx = x + w/2, cy = y + h/2;
        const morphPhase = performance.now() * 0.001;
        c.beginPath();
        for (let i = 0; i < 16; i++) {
            const angle = (i / 16) * Math.PI * 2 - Math.PI/2;
            const wobble = Math.sin(morphPhase * 2 + i) * 5;
            const r = (i % 2 === 0) ? w*0.55 + wobble : w*0.32 + wobble;
            const px = cx + Math.cos(angle) * r;
            const py = cy + Math.sin(angle) * r * (h/w);
            if (i === 0) c.moveTo(px, py);
            else c.lineTo(px, py);
        }
        c.closePath();
    }
};

function renderBoss() {
    if (!levelBoss || !levelBoss.alive) return;
    const boss = levelBoss;
    const t = currentWorld.theme;
    const cx = boss.x + boss.width/2;
    const cy = boss.y + boss.height/2;
    const flash = boss.hitTimer > 0 && Math.floor(boss.hitTimer / 5) % 2 === 0;
    const hurtTint = boss.state === 'hurt' ? '#FFFFFF' : null;

    // Aura exterior
    ctx.save();
    ctx.globalCompositeOperation = 'lighter';
    const auraColor = boss.state === 'enraged' ? '#FF2A85'
                    : boss.state === 'charging' ? '#FFE600'
                    : t.bossColor;
    const auraSize = 100 + Math.sin(stageTick * 0.08) * 10 + (boss.state === 'charging' ? 20 : 0);
    const auraGrad = ctx.createRadialGradient(cx, cy, 20, cx, cy, auraSize);
    auraGrad.addColorStop(0, auraColor + 'AA');
    auraGrad.addColorStop(0.6, auraColor + '44');
    auraGrad.addColorStop(1, auraColor + '00');
    ctx.fillStyle = auraGrad;
    ctx.beginPath(); ctx.arc(cx, cy, auraSize, 0, Math.PI * 2); ctx.fill();
    ctx.restore();

    if (boss.state === 'charging') drawChargeTelegraph(boss, cx, cy);

    // Assinatura por boss (trás)
    ctx.save();
    if (flash) ctx.globalAlpha = 0.5;
    switch (currentWorld.id) {
        case 'seoul': drawSeoulChains(boss, cx, cy, t); break;
        case 'tokyo': drawTokyoGlitchBack(boss, cx, cy, t); break;
        case 'la': drawLAFlames(boss, cx, cy, t); break;
        case 'paris': drawParisShadow(boss, cx, cy, t); break;
        case 'final': drawFinalChaosBack(boss, cx, cy, t); break;
    }
    ctx.restore();

    // Corpo
    ctx.save();
    if (flash) ctx.globalAlpha = 0.35;
    const shapeType = boss.shapeType || 'seoul';
    const shapeFn = BOSS_SHAPES[shapeType] || BOSS_SHAPES.seoul;
    const bodyGrad = ctx.createRadialGradient(cx - 10, cy - 15, 8, cx, cy, boss.width * 0.8);
    if (hurtTint) { bodyGrad.addColorStop(0, '#FFFFFF'); bodyGrad.addColorStop(1, t.bossColor); }
    else if (boss.state === 'enraged') { bodyGrad.addColorStop(0, '#3a0030'); bodyGrad.addColorStop(0.5, '#5a0a45'); bodyGrad.addColorStop(1, '#10000a'); }
    else { bodyGrad.addColorStop(0, '#2a0a3d'); bodyGrad.addColorStop(0.7, '#1a0530'); bodyGrad.addColorStop(1, '#05000a'); }
    ctx.fillStyle = bodyGrad;
    shapeFn(ctx, boss.x, boss.y, boss.width, boss.height);
    ctx.fill();

    ctx.strokeStyle = boss.state === 'enraged' ? '#FF2A85' : t.bossColor;
    ctx.lineWidth = boss.state === 'enraged' ? 4 : 3;
    ctx.shadowColor = t.bossColor;
    ctx.shadowBlur = boss.state === 'enraged' ? 25 : 15;
    shapeFn(ctx, boss.x, boss.y, boss.width, boss.height);
    ctx.stroke();
    ctx.shadowBlur = 0;
    ctx.restore();

    drawBossEyes(boss, cx, cy, t, hurtTint);
    drawBossMouth(boss, cx, cy, t);

    ctx.save();
    switch (currentWorld.id) {
        case 'tokyo': drawTokyoGlitchFront(boss, cx, cy, t); break;
        case 'final': drawFinalChaosFront(boss, cx, cy, t); break;
    }
    ctx.restore();

    if (boss.state === 'enraged') drawBossCrown(boss, cx, cy, t);

    if (boss.state === 'charging' && stageTick % 3 === 0) {
        const angle = Math.random() * Math.PI * 2;
        const dist = 80 + Math.random() * 40;
        createParticle(cx + Math.cos(angle) * dist, cy + Math.sin(angle) * dist, PTYPES.SPARK, {
            color: '#FFE600', vx: -Math.cos(angle)*3, vy: -Math.sin(angle)*3, life: 30, size: 4
        });
    }
}

function drawBossEyes(boss, cx, cy, t, hurtTint) {
    const state = boss.state;
    const color = hurtTint ? '#000' : (state === 'enraged' ? '#FF2A85' : t.bossColor);
    const eyeSpacing = boss.width * 0.22;
    const eyeY = boss.y + boss.height * 0.36;
    for (let side = -1; side <= 1; side += 2) {
        const ex = cx + side * eyeSpacing;
        let eyeW = 12, eyeH = 12;
        if (state === 'attacking') { eyeW = 16; eyeH = 9; }
        if (state === 'enraged') { eyeW = 14; eyeH = 16; }
        if (state === 'hurt') { eyeW = 8; eyeH = 8; }
        if (state === 'charging') { eyeW = 13; eyeH = 13; }
        ctx.save();
        ctx.shadowColor = color;
        ctx.shadowBlur = state === 'enraged' ? 25 : (state === 'charging' ? 20 : 14);
        ctx.fillStyle = color;
        ctx.beginPath();
        ctx.ellipse(ex, eyeY, eyeW, eyeH, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
        const pupOffX = Math.max(-3.5, Math.min(3.5, (hero.x + 20 - ex) * 0.015));
        const pupOffY = Math.max(-2.5, Math.min(2.5, (hero.y + 26 - eyeY) * 0.015));
        ctx.fillStyle = '#000';
        ctx.beginPath();
        ctx.arc(ex + pupOffX, eyeY + pupOffY, 4.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#FFF';
        ctx.beginPath();
        ctx.arc(ex + pupOffX - 1.5, eyeY + pupOffY - 1.5, 1.5, 0, Math.PI * 2);
        ctx.fill();
    }
    if (state === 'attacking' || state === 'enraged' || state === 'charging') {
        ctx.save();
        ctx.strokeStyle = state === 'charging' ? '#FFE600' : color;
        ctx.lineWidth = 3;
        ctx.shadowColor = ctx.strokeStyle;
        ctx.shadowBlur = 8;
        ctx.beginPath();
        ctx.moveTo(cx - eyeSpacing - 10, eyeY - 16);
        ctx.lineTo(cx - eyeSpacing + 8, eyeY - 10);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(cx + eyeSpacing + 10, eyeY - 16);
        ctx.lineTo(cx + eyeSpacing - 8, eyeY - 10);
        ctx.stroke();
        ctx.restore();
    }
}

function drawBossMouth(boss, cx, cy, t) {
    const state = boss.state;
    const color = state === 'enraged' ? '#FF2A85' : t.bossColor;
    const mouthY = boss.y + boss.height * 0.66;
    ctx.save();
    ctx.strokeStyle = color;
    ctx.lineWidth = 3;
    ctx.shadowColor = color;
    ctx.shadowBlur = 8;
    if (state === 'attacking') {
        ctx.fillStyle = '#0a0015';
        ctx.beginPath();
        ctx.ellipse(cx, mouthY, 16, 12, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
        ctx.fillStyle = color;
        for (let i = 0; i < 5; i++) {
            const dx = -14 + i * 7;
            ctx.beginPath();
            ctx.moveTo(cx + dx, mouthY - 10);
            ctx.lineTo(cx + dx + 3, mouthY - 4);
            ctx.lineTo(cx + dx + 6, mouthY - 10);
            ctx.fill();
        }
    } else if (state === 'enraged') {
        const teeth = 8;
        const w = 44;
        ctx.beginPath();
        ctx.moveTo(cx - w/2, mouthY);
        for (let i = 0; i < teeth; i++) {
            ctx.lineTo(cx - w/2 + (w / teeth) * (i + 0.5), mouthY + 7);
            ctx.lineTo(cx - w/2 + (w / teeth) * (i + 1), mouthY);
        }
        ctx.stroke();
    } else if (state === 'charging') {
        ctx.beginPath();
        ctx.moveTo(cx - 14, mouthY);
        ctx.lineTo(cx + 14, mouthY);
        ctx.stroke();
    } else {
        ctx.beginPath();
        ctx.arc(cx, mouthY - 12, 16, 0.2 * Math.PI, 0.8 * Math.PI);
        ctx.stroke();
    }
    ctx.restore();
}

function drawBossCrown(boss, cx, cy, t) {
    ctx.save();
    const crownY = boss.y - 18;
    const crownW = 60;
    const wobble = Math.sin(stageTick * 0.1) * 2;
    ctx.translate(cx, crownY + wobble);
    ctx.fillStyle = '#FFE600';
    ctx.strokeStyle = '#FF6B00';
    ctx.lineWidth = 2;
    ctx.shadowColor = '#FFE600';
    ctx.shadowBlur = 15;
    ctx.beginPath();
    ctx.moveTo(-crownW/2, 0);
    ctx.lineTo(-crownW/2 + 8, -18);
    ctx.lineTo(-crownW/4, -6);
    ctx.lineTo(0, -22);
    ctx.lineTo(crownW/4, -6);
    ctx.lineTo(crownW/2 - 8, -18);
    ctx.lineTo(crownW/2, 0);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
    ctx.fillStyle = '#FF007F';
    ctx.beginPath(); ctx.arc(0, -8, 3, 0, Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc(-crownW/4, -3, 2, 0, Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc(crownW/4, -3, 2, 0, Math.PI*2); ctx.fill();
    ctx.restore();
}

function drawChargeTelegraph(boss, cx, cy) {
    const charge = boss.chargeFx;
    const auraSize = 70 + charge * 70;
    const color = '#FFE600';
    ctx.save();
    ctx.globalCompositeOperation = 'lighter';
    ctx.strokeStyle = color;
    ctx.lineWidth = 4;
    ctx.shadowColor = color;
    ctx.shadowBlur = 20;
    ctx.beginPath(); ctx.arc(cx, cy, auraSize, 0, Math.PI*2); ctx.stroke();
    ctx.beginPath(); ctx.arc(cx, cy, auraSize * 0.6, 0, Math.PI*2); ctx.stroke();
    for (let i = 0; i < 8; i++) {
        const angle = (i / 8) * Math.PI * 2 + stageTick * 0.1;
        const r = 130 - charge * 40;
        const px = cx + Math.cos(angle) * r;
        const py = cy + Math.sin(angle) * r;
        ctx.strokeStyle = i % 2 ? '#FF2A85' : '#FFE600';
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(px, py);
        ctx.lineTo(cx + Math.cos(angle) * 40, cy + Math.sin(angle) * 40);
        ctx.stroke();
    }
    ctx.restore();
}

function drawSeoulChains(boss, cx, cy, t) {
    ctx.save();
    ctx.globalCompositeOperation = 'lighter';
    for (let c = 0; c < 3; c++) {
        const offsetAngle = boss.chainsPhase + c * (Math.PI * 2 / 3);
        ctx.strokeStyle = c === 0 ? '#FF007F' : (c === 1 ? '#FFE600' : '#FF2A85');
        ctx.lineWidth = 3;
        ctx.shadowColor = ctx.strokeStyle;
        ctx.shadowBlur = 15;
        ctx.beginPath();
        for (let i = 0; i <= 30; i++) {
            const p = i / 30;
            const angle = p * Math.PI * 2 + offsetAngle;
            const r = 75 + Math.sin(p * Math.PI * 6 + boss.chainsPhase * 3) * 12;
            const px = cx + Math.cos(angle) * r;
            const py = cy + Math.sin(angle) * r * 0.55;
            if (i === 0) ctx.moveTo(px, py);
            else ctx.lineTo(px, py);
        }
        ctx.stroke();
        for (let s = 0; s < 6; s++) {
            const sa = (s / 6) * Math.PI * 2 + offsetAngle;
            ctx.fillStyle = '#FFFFFF';
            ctx.beginPath();
            ctx.arc(cx + Math.cos(sa) * 75, cy + Math.sin(sa) * 75 * 0.55, 2.5, 0, Math.PI * 2);
            ctx.fill();
        }
    }
    ctx.restore();
}

function drawTokyoGlitchBack(boss, cx, cy, t) {
    ctx.save();
    ctx.globalCompositeOperation = 'screen';
    ctx.globalAlpha = 0.5;
    const offsets = [{ x: -4, y: 0, color: '#FF007F' }, { x: 4, y: 0, color: '#00F2FE' }];
    offsets.forEach(off => {
        const grad = ctx.createRadialGradient(cx + off.x, cy + off.y, 10, cx + off.x, cy + off.y, boss.width * 0.8);
        grad.addColorStop(0, off.color);
        grad.addColorStop(1, off.color + '00');
        ctx.fillStyle = grad;
        BOSS_SHAPES.tokyo(ctx, boss.x + off.x, boss.y + off.y, boss.width, boss.height);
        ctx.fill();
    });
    ctx.restore();
}
function drawTokyoGlitchFront(boss, cx, cy, t) {
    ctx.save();
    ctx.globalAlpha = 0.25;
    for (let y = boss.y; y < boss.y + boss.height; y += 3) {
        const glitch = Math.random() < 0.15;
        ctx.fillStyle = glitch ? '#00FFAB' : 'rgba(0, 242, 254, 0.3)';
        ctx.fillRect(boss.x, y + (Math.sin(boss.glitchPhase + y) * 2), boss.width, 1);
    }
    ctx.restore();
    if (stageTick % 8 < 2) {
        ctx.save();
        ctx.globalCompositeOperation = 'screen';
        const gx = boss.x + Math.random() * boss.width;
        const gy = boss.y + Math.random() * boss.height;
        ctx.fillStyle = Math.random() < 0.5 ? '#FF007F' : '#00FFAB';
        ctx.fillRect(gx, gy, 20 + Math.random() * 30, 3);
        ctx.restore();
    }
}

function drawLAFlames(boss, cx, cy, t) {
    ctx.save();
    ctx.globalCompositeOperation = 'lighter';
    const flameCount = 12;
    for (let i = 0; i < flameCount; i++) {
        const fx = boss.x + 5 + i * (boss.width - 10) / flameCount;
        const fy = boss.y + boss.height;
        const h = 25 + Math.sin(boss.flamePhase * 3 + i * 0.8) * 18;
        const w = 10 + Math.sin(boss.flamePhase * 4 + i * 1.2) * 4;
        const grad = ctx.createLinearGradient(fx, fy, fx, fy - h);
        grad.addColorStop(0, '#FFE600');
        grad.addColorStop(0.4, '#FF6B00');
        grad.addColorStop(1, 'rgba(255, 0, 127, 0)');
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.moveTo(fx - w/2, fy);
        ctx.quadraticCurveTo(fx - w/2, fy - h * 0.6, fx, fy - h);
        ctx.quadraticCurveTo(fx + w/2, fy - h * 0.6, fx + w/2, fy);
        ctx.closePath();
        ctx.fill();
    }
    ctx.restore();
}

function drawParisShadow(boss, cx, cy, t) {
    ctx.save();
    ctx.globalAlpha = 0.35;
    ctx.translate(cx * 2, 0);
    ctx.scale(-1, 1);
    const ghostGrad = ctx.createRadialGradient(cx, cy, 5, cx, cy, boss.width);
    ghostGrad.addColorStop(0, '#4169E1');
    ghostGrad.addColorStop(1, 'rgba(65, 105, 225, 0)');
    ctx.fillStyle = ghostGrad;
    BOSS_SHAPES.paris(ctx, boss.x, boss.y, boss.width, boss.height);
    ctx.fill();
    ctx.strokeStyle = '#4169E1';
    ctx.lineWidth = 2;
    BOSS_SHAPES.paris(ctx, boss.x, boss.y, boss.width, boss.height);
    ctx.stroke();
    ctx.restore();
    ctx.save();
    ctx.globalCompositeOperation = 'lighter';
    const goldSize = 70 + Math.sin(boss.ghostPhase * 2) * 15;
    const goldGrad = ctx.createRadialGradient(cx, cy, 5, cx, cy, goldSize);
    goldGrad.addColorStop(0, '#FFD700AA');
    goldGrad.addColorStop(0.5, '#FFD70044');
    goldGrad.addColorStop(1, 'rgba(255, 215, 0, 0)');
    ctx.fillStyle = goldGrad;
    ctx.beginPath(); ctx.arc(cx, cy, goldSize, 0, Math.PI * 2); ctx.fill();
    for (let i = 0; i < 6; i++) {
        const angle = (i / 6) * Math.PI * 2 + boss.ghostPhase * 0.5;
        const r1 = 40, r2 = 65 + Math.sin(boss.ghostPhase * 2 + i) * 10;
        ctx.strokeStyle = '#FFD700';
        ctx.lineWidth = 2;
        ctx.shadowColor = '#FFD700';
        ctx.shadowBlur = 10;
        ctx.beginPath();
        ctx.moveTo(cx + Math.cos(angle) * r1, cy + Math.sin(angle) * r1);
        ctx.lineTo(cx + Math.cos(angle) * r2, cy + Math.sin(angle) * r2);
        ctx.stroke();
    }
    ctx.restore();
}

function drawFinalChaosBack(boss, cx, cy, t) {
    const forms = ['seoul', 'tokyo', 'la', 'paris'];
    const morphCycle = Math.floor(boss.morphTime / 180);
    const morphProgress = (boss.morphTime % 180) / 180;
    const currentForm = forms[morphCycle % forms.length];
    const nextForm = forms[(morphCycle + 1) % forms.length];
    ctx.save();
    ctx.globalCompositeOperation = 'lighter';
    ctx.globalAlpha = 1 - morphProgress;
    const grad1 = ctx.createRadialGradient(cx, cy, 10, cx, cy, boss.width);
    grad1.addColorStop(0, '#FF007F');
    grad1.addColorStop(1, 'rgba(255, 0, 127, 0)');
    ctx.fillStyle = grad1;
    BOSS_SHAPES[currentForm](ctx, boss.x, boss.y, boss.width, boss.height);
    ctx.fill();
    ctx.globalAlpha = morphProgress;
    const grad2 = ctx.createRadialGradient(cx, cy, 10, cx, cy, boss.width);
    grad2.addColorStop(0, '#FF2A85');
    grad2.addColorStop(1, 'rgba(255, 42, 133, 0)');
    ctx.fillStyle = grad2;
    BOSS_SHAPES[nextForm](ctx, boss.x, boss.y, boss.width, boss.height);
    ctx.fill();
    const chaosSize = 120 + Math.sin(boss.morphTime * 0.1) * 20;
    const chaosGrad = ctx.createRadialGradient(cx, cy, 20, cx, cy, chaosSize);
    chaosGrad.addColorStop(0, 'rgba(255, 230, 0, 0.3)');
    chaosGrad.addColorStop(0.5, 'rgba(255, 0, 127, 0.2)');
    chaosGrad.addColorStop(1, 'rgba(0, 242, 254, 0)');
    ctx.fillStyle = chaosGrad;
    ctx.beginPath(); ctx.arc(cx, cy, chaosSize, 0, Math.PI * 2); ctx.fill();
    ctx.restore();
}
function drawFinalChaosFront(boss, cx, cy, t) {
    const morphProgress = (boss.morphTime % 180) / 180;
    if (morphProgress > 0.9 && stageTick % 3 === 0) {
        const angle = Math.random() * Math.PI * 2;
        const dist = 60 + Math.random() * 30;
        createParticle(cx + Math.cos(angle) * dist, cy + Math.sin(angle) * dist, PTYPES.SPARK, {
            color: ['#FF007F', '#FFE600', '#00F2FE', '#00FFAB'][Math.floor(Math.random() * 4)],
            vx: (Math.random() - 0.5) * 8, vy: (Math.random() - 0.5) * 8,
            life: 40, size: 5
        });
    }
    if (stageTick % 10 < 3) {
        ctx.save();
        ctx.globalCompositeOperation = 'screen';
        ctx.globalAlpha = 0.4;
        ctx.fillStyle = '#00F2FE';
        ctx.fillRect(boss.x - 3 + Math.random() * 6, boss.y, boss.width, 3);
        ctx.fillStyle = '#FF007F';
        ctx.fillRect(boss.x - 3 + Math.random() * 6, boss.y + boss.height - 3, boss.width, 3);
        ctx.restore();
    }
}

function renderBossProjectiles() {
    bossProjectiles.forEach(p => {
        ctx.save();
        ctx.globalCompositeOperation = 'lighter';
        for (let t = 0; t < 5; t++) {
            const tx = p.x - p.vx * t * 2.5;
            const ty = p.y - p.vy * t * 2.5;
            const alpha = 1 - t * 0.18;
            ctx.fillStyle = p.color + Math.floor(alpha * 180).toString(16).padStart(2, '0');
            ctx.beginPath();
            ctx.arc(tx, ty, p.radius - t * 1.2, 0, Math.PI * 2);
            ctx.fill();
        }
        ctx.fillStyle = p.color;
        ctx.shadowColor = p.color;
        ctx.shadowBlur = 20;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = '#FFF';
        ctx.shadowBlur = 8;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.radius * 0.45, 0, Math.PI * 2); ctx.fill();
        ctx.restore();
    });
}
function renderBossEffects() {
    bossEffects.forEach(e => {
        ctx.save();
        ctx.globalCompositeOperation = 'lighter';
        const alpha = e.life / e.maxLife;
        if (e.type === 'ring') {
            const progress = 1 - (e.life / e.maxLife);
            const r = progress * 150;
            ctx.strokeStyle = e.color;
            ctx.lineWidth = 5 * alpha;
            ctx.shadowColor = e.color;
            ctx.shadowBlur = 20;
            ctx.beginPath(); ctx.arc(e.x, e.y, r, 0, Math.PI * 2); ctx.stroke();
            ctx.strokeStyle = '#FFF';
            ctx.lineWidth = 2 * alpha;
            ctx.beginPath(); ctx.arc(e.x, e.y, r * 0.7, 0, Math.PI * 2); ctx.stroke();
        }
        ctx.restore();
    });
}

function renderStars() {
    levelStars.forEach(star => {
        if (star.collected) return;
        ctx.save();
        ctx.translate(star.x, star.y);
        ctx.rotate(Math.sin(stageTick*0.05 + star.rot)*0.2);
        ctx.globalCompositeOperation = 'lighter';
        ctx.fillStyle = currentWorld.theme.accent + '66';
        ctx.beginPath(); ctx.arc(0, 0, star.radius+6, 0, Math.PI*2); ctx.fill();
        ctx.fillStyle = currentWorld.theme.accent;
        ctx.font = 'bold 18px sans-serif';
        ctx.fillText('🎵', -10, 6);
        ctx.restore();
    });
}
function renderPowerUps() {
    const icons = { shield:'🛡️', magnet:'🧲', double:'🦘', slow:'⏱️', x2:'⭐' };
    const colors = { shield:'#00F2FE', magnet:'#FF007F', double:'#00FFAB', slow:'#7928CA', x2:'#FFE600' };
    levelPowerUps.forEach(pu => {
        if (pu.collected) return;
        const color = colors[pu.type] || '#FFE600';
        ctx.save();
        ctx.translate(pu.x+16, pu.y + Math.sin(pu.bobPhase)*4 + 16);
        ctx.globalCompositeOperation = 'lighter';
        ctx.fillStyle = color + '50';
        ctx.beginPath(); ctx.arc(0, 0, 24, 0, Math.PI*2); ctx.fill();
        ctx.fillStyle = '#120E24';
        ctx.strokeStyle = color; ctx.lineWidth = 2.5;
        ctx.shadowColor = color; ctx.shadowBlur = 12;
        ctx.beginPath(); ctx.roundRect(-16, -16, 32, 32, 8); ctx.fill(); ctx.stroke();
        ctx.shadowBlur = 0;
        ctx.font = '20px sans-serif';
        ctx.fillText(icons[pu.type], -10, 7);
        ctx.restore();
    });
}
function renderHero() {
    if (hero.invincibleTimer % 6 < 3) {
        ctx.save();
        const centerX = hero.x + hero.width/2;
        const bottomY = hero.y + hero.height;
        ctx.translate(centerX, bottomY);
        ctx.scale(hero.facing === 'left' ? -hero.scaleX : hero.scaleX, hero.scaleY);
        const rX = -hero.width/2, rY = -hero.height;
        ctx.fillStyle = 'rgba(0,0,0,0.35)';
        ctx.beginPath(); ctx.ellipse(0, 2, 16, 5, 0, 0, Math.PI*2); ctx.fill();
        if (activePowerUps.shield > 0) {
            ctx.save();
            ctx.globalCompositeOperation = 'lighter';
            ctx.strokeStyle = '#00F2FE'; ctx.lineWidth = 3;
            ctx.shadowColor = '#00F2FE'; ctx.shadowBlur = 15;
            ctx.beginPath(); ctx.arc(0, rY/2, 38, 0, Math.PI*2); ctx.stroke();
            ctx.restore();
        }
        const legOffset = Math.sin(hero.runFrame)*8;
        const outfit = OUTFIT_STYLES.find(o => o.id === avatarState.outfit) || OUTFIT_STYLES[0];
        const hair = HAIR_STYLES.find(h => h.id === avatarState.hair) || HAIR_STYLES[0];
        const ls = LIGHTSTICK_STYLES.find(l => l.id === avatarState.lightstick) || LIGHTSTICK_STYLES[0];
        ctx.fillStyle = '#120E24';
        ctx.fillRect(rX+8, rY+36 + (hero.isGrounded?legOffset:0), 8, 16);
        ctx.fillRect(rX+24, rY+36 - (hero.isGrounded?legOffset:0), 8, 16);
        ctx.fillStyle = currentWorld.theme.primary;
        ctx.fillRect(rX+6, rY+48 + (hero.isGrounded?legOffset:0), 12, 5);
        ctx.fillRect(rX+22, rY+48 - (hero.isGrounded?legOffset:0), 12, 5);
        const outfitGrad = ctx.createLinearGradient(rX+4, rY+20, rX+hero.width-4, rY+38);
        outfitGrad.addColorStop(0, outfit.color1);
        outfitGrad.addColorStop(1, outfit.color2);
        ctx.fillStyle = outfitGrad;
        ctx.beginPath(); ctx.roundRect(rX+4, rY+20, hero.width-8, 18, [6]); ctx.fill();
        ctx.fillStyle = outfit.belt;
        ctx.fillRect(rX+4, rY+34, hero.width-8, 3);
        ctx.fillStyle = '#FFE0BD';
        ctx.beginPath(); ctx.arc(0, rY+16, 15, 0, Math.PI*2); ctx.fill();
        ctx.fillStyle = 'rgba(255, 42, 133, 0.7)';
        ctx.beginPath(); ctx.arc(-4, rY+19, 3, 0, Math.PI*2); ctx.fill();
        ctx.beginPath(); ctx.arc(11, rY+19, 3, 0, Math.PI*2); ctx.fill();
        if (hero.isBlinking) {
            ctx.strokeStyle = '#0D0A1A'; ctx.lineWidth = 2;
            ctx.beginPath(); ctx.moveTo(-1, rY+15); ctx.lineTo(4, rY+15); ctx.stroke();
            ctx.beginPath(); ctx.moveTo(8, rY+15); ctx.lineTo(13, rY+15); ctx.stroke();
        } else {
            ctx.fillStyle = '#0D0A1A';
            ctx.beginPath(); ctx.arc(2, rY+15, 2.5, 0, Math.PI*2); ctx.fill();
            ctx.beginPath(); ctx.arc(10, rY+15, 2.5, 0, Math.PI*2); ctx.fill();
            ctx.fillStyle = '#FFF';
            ctx.beginPath(); ctx.arc(2.8, rY+14, 0.9, 0, Math.PI*2); ctx.fill();
            ctx.beginPath(); ctx.arc(10.8, rY+14, 0.9, 0, Math.PI*2); ctx.fill();
        }
        ctx.strokeStyle = '#0D0A1A'; ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.arc(5, rY+21, 3, 0.1*Math.PI, 0.9*Math.PI); ctx.stroke();
        const hairSway = Math.sin(stageTick*0.1)*3;
        const hairGrad = ctx.createLinearGradient(rX, rY, rX+hero.width, rY+18);
        hairGrad.addColorStop(0, hair.color1); hairGrad.addColorStop(1, hair.color2);
        ctx.fillStyle = hairGrad;
        ctx.beginPath();
        ctx.roundRect(rX-2+hairSway, rY-6, hero.width+4, 18, [12, 12, 4, 4]);
        ctx.fill();
        ctx.strokeStyle = currentWorld.theme.accent; ctx.lineWidth = 2;
        ctx.beginPath(); ctx.arc(-2, rY+14, 14, Math.PI*0.2, Math.PI*0.7); ctx.stroke();
        ctx.fillStyle = currentWorld.theme.accent;
        ctx.beginPath(); ctx.arc(8, rY+24, 3, 0, Math.PI*2); ctx.fill();
        ctx.save();
        ctx.globalCompositeOperation = 'lighter';
        if (ls.color === 'rainbow') {
            const hue = (stageTick * 3) % 360;
            ctx.fillStyle = `hsl(${hue},100%,60%)`;
            ctx.shadowColor = `hsl(${hue},100%,60%)`;
        } else {
            ctx.fillStyle = ls.color;
            ctx.shadowColor = ls.color;
        }
        ctx.shadowBlur = 12;
        ctx.beginPath(); ctx.arc(18, rY+22, 5, 0, Math.PI*2); ctx.fill();
        ctx.restore();
        ctx.restore();
    }
}
function renderParticles() {
    particles.forEach(p => {
        const alpha = p.life / p.maxLife;
        ctx.save();
        ctx.globalAlpha = alpha;
        if (p.type === PTYPES.NOTE) {
            ctx.translate(p.x, p.y); ctx.rotate(p.rotation);
            ctx.font = `${p.size*4}px serif`; ctx.fillStyle = p.color;
            ctx.shadowColor = p.color; ctx.shadowBlur = 12;
            ctx.fillText(p.text || '♪', -p.size*2, p.size);
        } else if (p.type === PTYPES.CONFETTI) {
            ctx.translate(p.x, p.y); ctx.rotate(p.rotation);
            ctx.fillStyle = p.color;
            ctx.fillRect(-p.size/2, -p.size/4, p.size, p.size/2);
        } else if (p.type === PTYPES.RIPPLE) {
            ctx.strokeStyle = p.color; ctx.lineWidth = 4*alpha;
            ctx.globalCompositeOperation = 'lighter';
            ctx.beginPath(); ctx.arc(p.x, p.y, (1-alpha)*120, 0, Math.PI*2); ctx.stroke();
        } else {
            ctx.fillStyle = p.color; ctx.shadowColor = p.color; ctx.shadowBlur = 8;
            ctx.beginPath(); ctx.arc(p.x, p.y, p.size*alpha, 0, Math.PI*2); ctx.fill();
        }
        ctx.restore();
    });
}
function renderFloatingTexts() {
    floatingTexts.forEach(ft => {
        ctx.save();
        ctx.globalAlpha = ft.alpha;
        ctx.font = '900 18px Righteous, cursive';
        ctx.fillStyle = ft.color;
        ctx.shadowColor = ft.color; ctx.shadowBlur = 10;
        ctx.fillText(ft.text, ft.x, ft.y);
        ctx.restore();
    });
}
function renderBloomOverlay() {
    ctx.save();
    ctx.globalCompositeOperation = 'screen';
    const grad = ctx.createRadialGradient(LOGICAL_W/2, LOGICAL_H/2, 50, LOGICAL_W/2, LOGICAL_H/2, 500);
    grad.addColorStop(0, currentWorld.theme.primary + '0F');
    grad.addColorStop(0.5, currentWorld.theme.secondary + '08');
    grad.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, LOGICAL_W, LOGICAL_H);
    ctx.restore();
}
function renderVignette() {
    ctx.save();
    const grad = ctx.createRadialGradient(LOGICAL_W/2, LOGICAL_H/2, 200, LOGICAL_W/2, LOGICAL_H/2, 500);
    grad.addColorStop(0, 'rgba(0,0,0,0)');
    grad.addColorStop(1, 'rgba(0,0,0,0.55)');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, LOGICAL_W, LOGICAL_H);
    ctx.restore();
}

function kpopGameLoop() {
    if (!isGameRunning) return;
    stageTick++;
    updateStagePhysics();
    if (!isGameRunning) return;
    renderStageScene();
    gameLoopId = requestAnimationFrame(kpopGameLoop);
}

/* VICTORY / GAMEOVER */
function triggerVictory() {
    pauseGameEngine(); stopBackgroundMusic();
    const stars = lives === MAX_LIVES ? 3 : lives === 2 ? 2 : 1;
    progress.stars[currentWorld.id] = Math.max(progress.stars[currentWorld.id] || 0, stars);
    progress.totalStars = Object.values(progress.stars).reduce((a,b) => a+b, 0);
    if (gameScore > progress.highScore) progress.highScore = Math.floor(gameScore);
    saveProgress();
    achievementsState.stats.bossesDefeated = (achievementsState.stats.bossesDefeated || 0) + 1;
    if (!achievementsState.stats.worldsPlayed) achievementsState.stats.worldsPlayed = [];
    if (!achievementsState.stats.worldsPlayed.includes(currentWorld.id)) achievementsState.stats.worldsPlayed.push(currentWorld.id);
    achievementsState.stats.totalStars = progress.totalStars;
    if (lives === MAX_LIVES) achievementsState.stats.noDamageBoss = true;
    saveAchievements(); checkAchievements();
    document.getElementById('victory-score').innerText = Math.floor(gameScore);
    document.getElementById('victory-stars').innerText = `⭐ ${stars} / 3`;
    const idx = WORLDS.findIndex(w => w.id === currentWorld.id);
    const isLast = idx === WORLDS.length - 1;
    document.getElementById('victory-message').innerText = isLast
        ? `Completaste a World Tour inteira! És uma lenda! 🌍✨`
        : `Derrotaste ${currentWorld.theme.bossName}! Novo palco desbloqueado!`;
    document.getElementById('victory-btn').innerText = isLast ? '🌍 Voltar ao Mapa' : '🎤 Próximo';
    document.getElementById('victory-btn').onclick = isLast ? backToConcerts : nextConcert;
    document.getElementById('victory-modal').classList.remove('hidden');
    for (let i = 0; i < 3; i++) setTimeout(() => playTone(660 + i*220, 'triangle', 0.3, 0.2), i*150);
}
function triggerGameOver() {
    pauseGameEngine(); stopBackgroundMusic();
    if (gameScore > progress.highScore) { progress.highScore = Math.floor(gameScore); saveProgress(); }
    document.getElementById('gameover-score').innerText = Math.floor(gameScore);
    document.getElementById('gameover-combo').innerText = `x${maxCombo}`;
    document.getElementById('gameover-highscore').innerText = progress.highScore;
    document.getElementById('gameover-checkpoint').innerText = `${Math.floor(cameraX/10)}m`;
    document.getElementById('game-over-modal').classList.remove('hidden');
    playErrorSound();
}

/* CONCERTS */
function renderConcerts() {
    const grid = document.getElementById('concerts-grid');
    grid.innerHTML = '';
    WORLDS.forEach((world, i) => {
        const unlocked = progress.unlockedWorlds.includes(world.id) || i === 0;
        const worldStars = progress.stars[world.id] || 0;
        const card = document.createElement('div');
        card.className = `concert-card kglass rounded-2xl p-4 border-2 ${unlocked ? '' : 'locked'}`;
        card.style.borderColor = world.theme.primary;
        card.style.color = world.theme.primary;
        card.onclick = () => unlocked && startConcert(world.id);
        card.innerHTML = `<div class="flex items-center justify-between mb-2"><span class="text-2xl">${world.emoji}</span>${!unlocked ? `<span class="text-lg animate-lock">🔒</span>` : ''}</div><div class="font-righteous text-base text-white">${world.name}</div><div class="text-[10px] font-bold uppercase tracking-wider opacity-70 mt-1">${world.subtitle}</div><div class="flex gap-1 mt-2">${[1,2,3].map(s => `<span class="text-xs" style="color:${s <= worldStars ? world.theme.accent : '#333'}">${s <= worldStars ? '⭐' : '☆'}</span>`).join('')}</div>`;
        grid.appendChild(card);
    });
    updateGlobalStatsUI();
    document.getElementById('hardcore-label').innerText = `Hardcore: ${hardcoreMode ? 'ON' : 'OFF'}`;
}
function toggleHardcore() {
    hardcoreMode = !hardcoreMode;
    progress.hardcore = hardcoreMode; saveProgress();
    document.getElementById('hardcore-label').innerText = `Hardcore: ${hardcoreMode ? 'ON' : 'OFF'}`;
}
function startConcert(worldId) {
    const world = WORLDS.find(w => w.id === worldId);
    if (!world) return;
    currentWorld = world;
    worldDifficulty = world.difficulty * (hardcoreMode ? 1.5 : 1.0);
    document.getElementById('concert-emoji').innerText = world.emoji;
    document.getElementById('concert-world-name').innerText = world.name;
    document.getElementById('concert-world-subtitle').innerText = world.subtitle + (hardcoreMode ? ' • HARDCORE' : '');
    document.getElementById('concert-header').style.borderColor = world.theme.primary;
    document.getElementById('boss-name').innerHTML = `<span class="animate-pulse">👹</span> ${world.theme.bossName.toUpperCase()}`;
    document.getElementById('concert-selector').classList.add('hidden');
    document.getElementById('game-dashboard').classList.remove('hidden');
    document.getElementById('victory-modal').classList.add('hidden');
    document.getElementById('game-over-modal').classList.add('hidden');
    document.getElementById('game-question-modal').classList.add('hidden');
    document.getElementById('boss-bar-container').classList.add('hidden');
    initCrowd();
    resetKpopGame();
    showWorldIntro(() => { startBackgroundMusic(worldId); startOrResumeGame(); });
}
function backToConcerts() {
    pauseGameEngine(); stopBackgroundMusic();
    document.getElementById('concert-selector').classList.remove('hidden');
    document.getElementById('game-dashboard').classList.add('hidden');
    renderConcerts();
}
function retryConcert() { document.getElementById('game-over-modal').classList.add('hidden'); startConcert(currentWorld.id); }
function nextConcert() {
    const idx = WORLDS.findIndex(w => w.id === currentWorld.id);
    if (idx < WORLDS.length - 1) {
        const next = WORLDS[idx+1];
        if (!progress.unlockedWorlds.includes(next.id)) { progress.unlockedWorlds.push(next.id); saveProgress(); }
        document.getElementById('victory-modal').classList.add('hidden');
        startConcert(next.id);
    } else {
        document.getElementById('victory-modal').classList.add('hidden');
        backToConcerts();
    }
}
function showWorldIntro(callback) {
    const overlay = document.getElementById('world-intro-overlay');
    document.getElementById('intro-emoji').innerText = currentWorld.emoji;
    const nameEl = document.getElementById('intro-world-name');
    nameEl.innerText = currentWorld.name.toUpperCase();
    nameEl.classList.remove('world-intro-anim'); void nameEl.offsetWidth; nameEl.classList.add('world-intro-anim');
    document.getElementById('intro-subtitle').innerText = currentWorld.subtitle;
    const taglines = {
        seoul: '"Onde tudo começa. A tua estreia!"',
        tokyo: '"Neon, arranha-céus e sílabas afiadas."',
        la: '"Pôr do sol, praia e batidas quentes."',
        paris: '"Luzes, arte e pronúncia perfeita."',
        final: '"A batalha final. Tudo ou nada!"'
    };
    document.getElementById('intro-tagline').innerText = taglines[currentWorld.id] || '';
    overlay.classList.remove('hidden');
    playTone(440, 'sine', 0.3, 0.2);
    setTimeout(() => playTone(554, 'sine', 0.3, 0.2), 200);
    setTimeout(() => playTone(659, 'sine', 0.4, 0.2), 400);
    setTimeout(() => { overlay.classList.add('hidden'); if (callback) callback(); }, 2600);
}
function showBossIntro(callback) {
    const overlay = document.getElementById('boss-intro-overlay');
    document.getElementById('boss-intro-name').innerText = currentWorld.theme.bossName.toUpperCase();
    overlay.classList.remove('hidden');
    playTone(110, 'sawtooth', 0.8, 0.3);
    setTimeout(() => playTone(90, 'sawtooth', 0.8, 0.3), 400);
    setTimeout(() => { overlay.classList.add('hidden'); if (callback) callback(); }, 1800);
}
function openKpopQuestionModal() {
    if (!document.getElementById('game-over-modal').classList.contains('hidden') ||
        !document.getElementById('victory-modal').classList.contains('hidden')) return;
    pauseGameEngine();
    const modal = document.getElementById('game-question-modal');
    const randomQ = quizDatabase[Math.floor(Math.random() * quizDatabase.length)];
    document.getElementById('game-modal-q-text').innerText = randomQ.q;
    const optionsBox = document.getElementById('game-modal-options');
    optionsBox.innerHTML = '';
    randomQ.options.forEach((optStr, idx) => {
        const btn = document.createElement('button');
        btn.className = "p-3.5 rounded-xl bg-white/5 border border-white/10 hover:border-kpop-pink hover:bg-kpop-pink/20 font-bold text-slate-200 text-left text-sm transition";
        btn.innerText = optStr;
        btn.onclick = () => answerGameQuestion(idx === randomQ.ans);
        optionsBox.appendChild(btn);
    });
    modal.classList.remove('hidden');
}
function answerGameQuestion(isCorrect) {
    document.getElementById('game-question-modal').classList.add('hidden');
    if (isCorrect) {
        energyLevel = Math.min(100, energyLevel + 60);
        gameScore += 40;
        addFloatingText("+60% ⚡", hero.x, hero.y-30, "#00FFAB");
        playSuccessSound();
        spawnConfetti(hero.x+20, hero.y+20, 20);
    } else {
        energyLevel = Math.min(100, energyLevel + 30);
        playErrorSound();
    }
    hero.invincibleTimer = 120;
    updateGameEnergyUI();
    startOrResumeGame();
}

window.addEventListener('keydown', (e) => {
    if (duelState.active) return;
    if (e.code === 'ArrowLeft' || e.code === 'KeyA') keys.left = true;
    if (e.code === 'ArrowRight' || e.code === 'KeyD') keys.right = true;
    if (e.code === 'Space' || e.code === 'ArrowUp' || e.code === 'KeyW') { e.preventDefault(); keys.jump = true; }
    if (e.code === 'KeyR') {
        if (!document.getElementById('game-dashboard').classList.contains('hidden') &&
            document.getElementById('game-over-modal').classList.contains('hidden') &&
            document.getElementById('victory-modal').classList.contains('hidden')) openKpopQuestionModal();
    }
});
window.addEventListener('keyup', (e) => {
    if (e.code === 'ArrowLeft' || e.code === 'KeyA') keys.left = false;
    if (e.code === 'ArrowRight' || e.code === 'KeyD') keys.right = false;
    if (e.code === 'Space' || e.code === 'ArrowUp' || e.code === 'KeyW') keys.jump = false;
});
function bindTouch(id, key) {
    const el = document.getElementById(id);
    el.addEventListener('touchstart', e => { e.preventDefault(); keys[key] = true; });
    el.addEventListener('touchend', e => { e.preventDefault(); keys[key] = false; });
    el.addEventListener('mousedown', () => keys[key] = true);
    el.addEventListener('mouseup', () => keys[key] = false);
    el.addEventListener('mouseleave', () => keys[key] = false);
}
bindTouch('touch-left-btn', 'left');
bindTouch('touch-right-btn', 'right');
bindTouch('touch-jump-btn', 'jump');

updateGlobalStatsUI();
renderConcerts();
updateGameEnergyUI();
updatePowerUpUI();
updateLivesUI();
renderAchievementsFull();
updateDailyUI();

let logoClicks = 0;
document.querySelector('h1').addEventListener('click', () => {
    logoClicks++;
    if (logoClicks >= 5) {
        logoClicks = 0;
        document.querySelector('button[title="Modo Professor"]').classList.remove('hidden');
        showMiniToast('👩‍🏫 Modo Professor', 'Botão azul agora visível');
    }
});
console.log('%c🎤 K-SÍLABA ULTIMATE pronto!', 'color:#FF007F;font-size:20px;font-weight:bold');
</script>
</body>
</html>
