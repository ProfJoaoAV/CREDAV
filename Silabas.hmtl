            <button onclick="closeDuel()" class="bg-gradient-to-r from-kpop-pink to-kpop-purple text-white font-righteous px-8 py-3 rounded-2xl">Fechar</button>
        </div>
    </div>
</div>

<!-- WORLD INTRO -->
<div id="world-intro-overlay" class="hidden fixed inset-0 z-[100] bg-black flex items-center justify-center">
    <div class="text-center px-4">
        <div id="intro-emoji" class="text-9xl mb-4">🎤</div>
        <h2 id="intro-world-name" class="font-righteous text-5xl md:text-7xl shimmer-text world-intro-anim">SEOUL DEBUT</h2>
        <p id="intro-subtitle" class="text-kpop-cyan font-bold tracking-widest text-sm uppercase mt-3">STAGE 1 / 5</p>
        <p id="intro-tagline" class="text-slate-300 text-lg italic mt-4">"Onde tudo começa."</p>
    </div>
</div>

<!-- BOSS INTRO -->
<div id="boss-intro-overlay" class="hidden fixed inset-0 z-[100] bg-black/95 flex items-center justify-center">
    <div class="text-center px-4 animate-pop">
        <div class="text-8xl animate-bounce mb-3">👹</div>
        <div class="font-righteous text-2xl text-red-400 tracking-[0.4em] mb-2">BOSS BATTLE</div>
        <h3 id="boss-intro-name" class="font-righteous text-4xl md:text-5xl text-white">ANTI-FAN MASTER</h3>
        <div class="text-kpop-pink text-sm font-bold tracking-widest mt-3 animate-pulse">⚡ PREPARA-TE ⚡</div>
    </div>
</div>
<script>
/* NAVEGAÇÃO */
const ALL_TABS = ['learn','quiz','karaoke','game','avatar','achievements','daily','teacher'];
function switchTab(tab) {
    ALL_TABS.forEach(t => {
        const sec = document.getElementById(`section-${t}`);
        const btn = document.getElementById(`tab-${t}`);
        if (sec) sec.classList.add('hidden');
        if (btn) btn.classList.remove('active');
    });
    const sec = document.getElementById(`section-${tab}`);
    const btn = document.getElementById(`tab-${tab}`);
    if (sec) { sec.classList.remove('hidden'); sec.classList.add('animate-fade-up'); setTimeout(()=>sec.classList.remove('animate-fade-up'), 500); }
    if (btn) btn.classList.add('active');
    if (tab === 'game') { renderConcerts(); stopBackgroundMusic(); }
    else { pauseGameEngine(); stopBackgroundMusic(); }
    if (tab === 'quiz' && currentQuizIndex === 0 && quizScore === 0) restartAuditionQuiz();
    if (tab === 'achievements') renderAchievementsFull();
    if (tab === 'avatar') renderAvatarShop();
    if (tab === 'daily') updateDailyUI();
    if (tab === 'teacher') renderTeacherStats();
}

/* ÁUDIO */
let soundEnabled = true;
let audioCtx = null;
function getAudioContext() {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    return audioCtx;
}
function toggleSound() {
    soundEnabled = !soundEnabled;
    const txt = document.getElementById('settings-sound-text');
    if (txt) txt.innerText = soundEnabled ? 'Ligado' : 'Desligado';
    const icon = document.getElementById('float-sound-icon');
    if (icon) icon.className = soundEnabled ? 'fa-solid fa-volume-high text-lg' : 'fa-solid fa-volume-xmark text-lg';
    if (!soundEnabled) stopBackgroundMusic();
}
function playTone(freq=440, type='sine', duration=0.15, vol=0.18) {
    if (!soundEnabled) return;
    try {
        const ctx = getAudioContext();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, ctx.currentTime);
        gain.gain.setValueAtTime(vol, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
        osc.connect(gain); gain.connect(ctx.destination);
        osc.start(); osc.stop(ctx.currentTime + duration);
    } catch(e) {}
}
function playSuccessSound() { [659, 784, 1047].forEach((f,i) => setTimeout(() => playTone(f, 'triangle', 0.12, 0.15), i*100)); }
function playErrorSound() { playTone(220, 'sawtooth', 0.15, 0.15); setTimeout(() => playTone(180, 'sawtooth', 0.2, 0.15), 100); }

let musicState = { isPlaying: false, schedulerId: null, nextNoteTime: 0, step: 0, bpm: 128, currentWorld: 'seoul', masterGain: null };
function startBackgroundMusic(worldId) {
    if (!soundEnabled) return;
    stopBackgroundMusic();
    const ctx = getAudioContext();
    musicState.currentWorld = worldId;
    const bpms = { seoul:128, tokyo:132, la:124, paris:120, final:140 };
    musicState.bpm = bpms[worldId] || 128;
    musicState.step = 0;
    musicState.nextNoteTime = ctx.currentTime + 0.1;
    if (!musicState.masterGain) {
        musicState.masterGain = ctx.createGain();
        musicState.masterGain.gain.value = 0.12;
        musicState.masterGain.connect(ctx.destination);
    }
    musicState.isPlaying = true;
    const spb = 60.0 / musicState.bpm;
    const sps = spb / 4;
    function scheduleMusic() {
        if (!musicState.isPlaying || !soundEnabled) return;
        while (musicState.nextNoteTime < ctx.currentTime + 0.15) {
            scheduleStep(musicState.step, musicState.nextNoteTime);
            musicState.nextNoteTime += sps;
            musicState.step = (musicState.step + 1) % 32;
        }
        musicState.schedulerId = setTimeout(scheduleMusic, 25);
    }
    scheduleMusic();
}
function scheduleStep(step, time) {
    const ctx = getAudioContext();
    const world = musicState.currentWorld;
    const master = musicState.masterGain;
    if (step % 4 === 0) {
        const kick = ctx.createOscillator(); const kg = ctx.createGain();
        kick.frequency.setValueAtTime(150, time);
        kick.frequency.exponentialRampToValueAtTime(50, time + 0.1);
        kg.gain.setValueAtTime(0.5, time);
        kg.gain.exponentialRampToValueAtTime(0.001, time + 0.15);
        kick.connect(kg); kg.connect(master);
        kick.start(time); kick.stop(time + 0.15);
    }
    if (step % 8 === 4) {
        const bs = ctx.sampleRate * 0.1;
        const buf = ctx.createBuffer(1, bs, ctx.sampleRate);
        const d = buf.getChannelData(0);
        for (let i = 0; i < bs; i++) d[i] = Math.random() * 2 - 1;
        const n = ctx.createBufferSource(); n.buffer = buf;
        const ng = ctx.createGain();
        ng.gain.setValueAtTime(0.25, time);
        ng.gain.exponentialRampToValueAtTime(0.001, time + 0.1);
        const hp = ctx.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 1000;
        n.connect(hp); hp.connect(ng); ng.connect(master);
        n.start(time);
    }
    if (step % 2 === 1) {
        const bs = ctx.sampleRate * 0.03;
        const buf = ctx.createBuffer(1, bs, ctx.sampleRate);
        const d = buf.getChannelData(0);
        for (let i = 0; i < bs; i++) d[i] = Math.random() * 2 - 1;
        const n = ctx.createBufferSource(); n.buffer = buf;
        const ng = ctx.createGain();
        ng.gain.setValueAtTime(0.08, time);
        ng.gain.exponentialRampToValueAtTime(0.001, time + 0.03);
        n.connect(ng); ng.connect(master);
        n.start(time);
    }
    const basslines = {
        seoul: [110, 110, 130.81, 110, 146.83, 110, 130.81, 110],
        tokyo: [98, 98, 123.47, 98, 146.83, 123.47, 98, 82.41],
        la:    [82.41, 82.41, 98, 82.41, 110, 98, 82.41, 73.42],
        paris: [130.81, 130.81, 155.56, 130.81, 174.61, 155.56, 130.81, 116.54],
        final: [146.83, 146.83, 174.61, 146.83, 196, 174.61, 146.83, 130.81]
    };
    const bn = basslines[world] || basslines.seoul;
    if (step % 4 === 0) {
        const note = bn[(step/4) % bn.length];
        const bass = ctx.createOscillator(); const bg = ctx.createGain();
        bass.type = 'sawtooth';
        bass.frequency.setValueAtTime(note, time);
        bg.gain.setValueAtTime(0.001, time);
        bg.gain.exponentialRampToValueAtTime(0.15, time + 0.01);
        bg.gain.exponentialRampToValueAtTime(0.001, time + 0.3);
        const lp = ctx.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 500;
        bass.connect(lp); lp.connect(bg); bg.connect(master);
        bass.start(time); bass.stop(time + 0.35);
    }
    const melodies = {
        seoul: [523.25, 659.25, 783.99, 659.25],
        tokyo: [587.33, 698.46, 880, 698.46],
        la:    [440, 523.25, 659.25, 523.25],
        paris: [659.25, 783.99, 987.77, 783.99],
        final: [698.46, 880, 1046.5, 880]
    };
    const nn = melodies[world] || melodies.seoul;
    if (step % 2 === 0) {
        const note = nn[(step/2) % nn.length];
        const lead = ctx.createOscillator(); const lg = ctx.createGain();
        lead.type = 'square';
        lead.frequency.setValueAtTime(note, time);
        lg.gain.setValueAtTime(0.04, time);
        lg.gain.exponentialRampToValueAtTime(0.001, time + 0.2);
        const lp = ctx.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 2500;
        lead.connect(lp); lp.connect(lg); lg.connect(master);
        lead.start(time); lead.stop(time + 0.25);
    }
}
function stopBackgroundMusic() {
    musicState.isPlaying = false;
    if (musicState.schedulerId) { clearTimeout(musicState.schedulerId); musicState.schedulerId = null; }
}

/* PROGRESS */
let progress = JSON.parse(localStorage.getItem('ksilaba_progress') || 'null') || { unlockedWorlds: ['seoul'], stars: {}, highScore: 0, hardcore: false, totalStars: 0 };
let achievementsState = JSON.parse(localStorage.getItem('ksilaba_achievements') || 'null') || {
    unlocked: [],
    stats: { quizCorrect: 0, maxCombo: 0, bossesDefeated: 0, quizPerfect: false, noDamageBoss: false, worldsPlayed: [], totalStars: 0, dailyStreak: 0 }
};
let avatarState = JSON.parse(localStorage.getItem('ksilaba_avatar') || 'null') || {
    hair: 'pink', outfit: 'purple', lightstick: 'neon',
    ownedHair: ['pink'], ownedOutfit: ['purple'], ownedLightstick: ['neon']
};
let customWords = JSON.parse(localStorage.getItem('ksilaba_customwords') || '[]');

function saveProgress() { localStorage.setItem('ksilaba_progress', JSON.stringify(progress)); updateGlobalStatsUI(); }
function saveAchievements() { localStorage.setItem('ksilaba_achievements', JSON.stringify(achievementsState)); }
function saveAvatar() { localStorage.setItem('ksilaba_avatar', JSON.stringify(avatarState)); }
function saveCustomWords() { localStorage.setItem('ksilaba_customwords', JSON.stringify(customWords)); }
function updateGlobalStatsUI() {
    const s = document.getElementById('global-stars');
    const h = document.getElementById('global-highscore');
    if (s) s.innerText = progress.totalStars || 0;
    if (h) h.innerText = progress.highScore || 0;
}

/* WORLDS */
const WORLDS = [
    { id:'seoul', name:'Seoul Debut', subtitle:'STAGE 1 / 5 • START', emoji:'🎤',
      theme:{ primary:'#FF007F', secondary:'#00F2FE', accent:'#FFE600', bg1:'#0a0614', bg2:'#180e2e', bg3:'#090513',
              skyline:'#0d0820', crowd:'#0a0817', bossName:'Anti-Fan Trainee', bossColor:'#FF007F' },
