            <div class="flex items-center justify-between bg-black/40 rounded-xl p-4">
                <span class="text-sm font-bold text-slate-300">♿ Alto Contraste</span>
                <button onclick="toggleHighContrast()" class="w-14 h-7 rounded-full bg-black/60 border-2 border-white/30 relative">
                    <span class="absolute top-0.5 left-0.5 w-5 h-5 rounded-full bg-white transition-all"></span>
                </button>
            </div>
            <div class="flex items-center justify-between bg-black/40 rounded-xl p-4">
                <span class="text-sm font-bold text-slate-300">🎬 Reduzir Movimento</span>
                <button onclick="toggleReduceMotion()" class="w-14 h-7 rounded-full bg-black/60 border-2 border-white/30 relative">
                    <span class="absolute top-0.5 left-0.5 w-5 h-5 rounded-full bg-white transition-all"></span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- DUEL MODAL -->
<div id="duel-modal" class="hidden modal-overlay">
    <div class="kglass rounded-3xl p-6 max-w-2xl w-full border-2 border-purple-400/50 space-y-4 max-h-[90vh] overflow-y-auto">
